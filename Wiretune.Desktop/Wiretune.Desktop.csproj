<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Wiretune.Desktop</RootNamespace>
    <ApplicationIcon>Assets\wiretune.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <AssemblyTitle>Wiretune - Audiophile Streamer &amp; Player</AssemblyTitle>
    <Description>Bit-perfect, exclusive-mode lossless music player and streaming client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <!-- Deliberately newer than the 0.20.0 that Avalonia.FreeDesktop 11.2.x depends on. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wiretune.UI\Wiretune.UI.csproj" />
  </ItemGroup>

</Project>



