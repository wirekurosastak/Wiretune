<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Wiretone.Desktop</RootNamespace>
    <ApplicationIcon>Assets\wiretone.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <Product>Wiretone</Product>
    <AssemblyTitle>Wiretone - Audiophile Streamer &amp; Player</AssemblyTitle>
    <Authors>Wiretone</Authors>
    <Description>Natív, bit-perfect és exkluzív módú veszteségmentes zenelejátszó és streamelő kliens.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wiretone.UI\Wiretone.UI.csproj" />
  </ItemGroup>

</Project>
