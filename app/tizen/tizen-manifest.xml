<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.wiretune.player" version="2.0.0" api-version="6.0" xmlns="http://tizen.org/ns/packages">
    <!-- Samsung TVs (Tizen 6.0, 2021 models, and later). For the emulator or another Tizen device use "common". -->
    <profile name="tv-samsung"/>
    <ui-application appid="com.wiretune.player" exec="Runner.dll" type="dotnet" multiple="false" nodisplay="false" taskmanage="true">
        <label>Wiretune</label>
        <icon>ic_launcher.png</icon>
        <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true"/>
        <metadata key="http://tizen.org/metadata/prefer_nuget_cache" value="true"/>
    </ui-application>
    <privileges>
        <!-- Streaming from the Wiretune server. -->
        <privilege>http://tizen.org/privilege/internet</privilege>
        <privilege>http://tizen.org/privilege/network.get</privilege>
    </privileges>
    <feature name="http://tizen.org/feature/screen.size.all"/>
</manifest>
