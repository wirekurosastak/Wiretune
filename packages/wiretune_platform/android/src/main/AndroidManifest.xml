<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Updating itself from a release (installUpdate): the system asks the user before it installs anything. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <application>
    <!-- The home-screen widget: what plays, with previous, play or pause, next. -->
    <receiver
        android:name="com.wiretune.platform.NowPlayingWidget"
        android:exported="false"
        android:label="@string/wiretune_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/wiretune_widget_info" />
    </receiver>
  </application>
</manifest>
