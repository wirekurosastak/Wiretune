<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: the cover, the title and artist, and previous, play or pause, next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wiretune_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wiretune_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/wiretune_widget_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wiretune_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF7F7FA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wiretune_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFAEB5C2"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/wiretune_widget_previous"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/wiretune_widget_previous"
        android:src="@drawable/wiretune_widget_previous" />

    <ImageButton
        android:id="@+id/wiretune_widget_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/wiretune_widget_play"
        android:src="@drawable/wiretune_widget_play" />

    <ImageButton
        android:id="@+id/wiretune_widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/wiretune_widget_next"
        android:src="@drawable/wiretune_widget_next" />
</LinearLayout>
