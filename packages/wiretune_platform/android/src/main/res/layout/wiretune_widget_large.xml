<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget made two cells tall: the cover, the title and artist, and the heart, over shuffle,
     previous, play or pause, and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wiretune_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wiretune_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wiretune_widget_cover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wiretune_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFF7F7FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wiretune_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFAEB5C2"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/wiretune_widget_favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/wiretune_widget_favorite"
            android:src="@drawable/wiretune_widget_favorite_border" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/wiretune_widget_shuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/wiretune_widget_shuffle"
            android:src="@drawable/wiretune_widget_shuffle" />

        <ImageButton
            android:id="@+id/wiretune_widget_previous"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/wiretune_widget_previous"
            android:src="@drawable/wiretune_widget_previous" />

        <ImageButton
            android:id="@+id/wiretune_widget_play"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/wiretune_widget_play"
            android:src="@drawable/wiretune_widget_play" />

        <ImageButton
            android:id="@+id/wiretune_widget_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/wiretune_widget_next"
            android:src="@drawable/wiretune_widget_next" />
    </LinearLayout>
</LinearLayout>
