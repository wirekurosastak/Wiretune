<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Controls.PhoneEmptyState"
             x:Name="Root">
  <!-- A centered illustration-free placeholder: an icon, a title, a hint and an optional button. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="32,24" MaxWidth="340">
    <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
            Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
      <material:MaterialIcon Kind="{Binding Icon, ElementName=Root}" Width="40" Height="40"
                             Foreground="{DynamicResource PrimaryAction}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="18" FontWeight="Bold"
               Foreground="{DynamicResource TextMain}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
    <TextBlock Text="{Binding Hint, ElementName=Root}" FontSize="13"
               Foreground="{DynamicResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap"
               IsVisible="{Binding Hint, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Button Classes="primary" Height="44" CornerRadius="22" Padding="24,0" HorizontalAlignment="Center" Margin="0,10,0,0"
            Command="{Binding ActionCommand, ElementName=Root}"
            CommandParameter="{Binding ActionParameter, ElementName=Root}"
            IsVisible="{Binding ActionText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ActionText, ElementName=Root}" FontWeight="Bold" />
    </Button>
  </StackPanel>
</UserControl>
