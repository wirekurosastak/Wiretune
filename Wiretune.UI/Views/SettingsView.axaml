<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <!-- The Settings tab: library source, server, accounts, audio and language. Binds to MainViewModel (inherited). -->
  <ScrollViewer Classes="page" IsVisible="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Settings}, Converter={StaticResource IntEqualConverter}}"
                ClipToBounds="False">
    <StackPanel Spacing="24" Margin="4,0,12,24">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:T NavSettings}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
        <TextBlock Text="{loc:T SettingsSubtitle}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
      </StackPanel>

      <!-- 2-COLUMN SETTINGS LAYOUT -->
      <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">

        <!-- COLUMN 1: SERVER & LIBRARY SETTINGS AND DATA CARDS -->
        <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,12,0">
          <TextBlock Text="{loc:T SettingsServerSection}" Classes="group-title" />

          <!-- Account -->
          <Border Classes="glass purple">
            <Grid ColumnDefinitions="Auto, *, Auto">
              <material:MaterialIcon Grid.Column="0" Kind="AccountCircle" Width="36" Height="36"
                                     Foreground="{DynamicResource PurpleAccent}" VerticalAlignment="Center" Margin="0,0,16,0" />

              <StackPanel Classes="page" Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding ServerSettings.IsLoggedIn}">
                <TextBlock Text="{Binding ServerSettings.CurrentUserName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                <TextBlock Text="{Binding ServerSettings.CurrentUserRole}"
                           FontSize="12" Foreground="{DynamicResource LimeAccent}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="secondary" Command="{Binding LogoutCommand}" Height="36" Padding="14,0"
                      IsVisible="{Binding ServerSettings.IsLoggedIn}" ToolTip.Tip="{loc:T TipSignOut}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <material:MaterialIcon Kind="Logout" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
                  <TextBlock Text="{loc:T SignOut}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
              </Button>

              <StackPanel Classes="page" Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding !ServerSettings.IsLoggedIn}">
                <TextBlock Text="{loc:T NotSignedIn}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                <TextBlock Text="{loc:T NotSignedInHint}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="primary" Command="{Binding ShowLoginScreenCommand}" Height="36" Padding="16,0"
                      IsVisible="{Binding !ServerSettings.IsLoggedIn}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <material:MaterialIcon Kind="Login" Width="16" Height="16" />
                  <TextBlock Text="{loc:T SignIn}" FontSize="12" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Kapcsolat (Szerver és Helyi zenemappa) -->
          <Border Classes="glass cyan">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{loc:T Connection}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                  <TextBlock Text="{Binding ServerSettings.LibrarySourceText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ServerSettings.ServerStatusBadge}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource CyanAccent}" />
                </Border>
              </Grid>

              <!-- Szerverkapcsolat -->
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:T LabelServer}" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                <!-- The address has a row of its own: the buttons' labels are long in some languages -->
                <TextBox Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}" Watermark="{loc:T ServerUrlPlaceholder}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.ConnectServerCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Command="{Binding ServerSettings.ConnectServerCommand}" IsEnabled="{Binding !ServerSettings.IsConnecting}"
                          Height="38" Padding="14,0" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <material:MaterialIcon Kind="Server" Width="16" Height="16" />
                      <TextBlock Text="{loc:T ConnectShort}" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary" Command="{Binding ServerSettings.RescanServerCommand}" IsEnabled="{Binding ServerSettings.CanRescanServer}"
                          Height="38" Padding="12,0" HorizontalContentAlignment="Center"
                          ToolTip.Tip="{loc:T TipReindex}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                      <TextBlock Text="{loc:T Reindex}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding ServerSettings.IsBusy}" />
                <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="12" Foreground="{DynamicResource CyanAccent}" TextWrapping="Wrap" IsVisible="{Binding ServerSettings.IsBusy}" />
              </StackPanel>

              <!-- Szerveroldali zenemappa (Adminisztrátori felület) -->
              <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                      IsVisible="{Binding ServerSettings.IsAdmin}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:T ServerFolderLabel}" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                  <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Text="{Binding ServerSettings.ServerLibraryPath, Mode=TwoWay}" Watermark="{loc:T ServerFolderPlaceholder}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Classes="primary" Command="{Binding ServerSettings.UpdateServerLibraryPathCommand}" IsEnabled="{Binding !ServerSettings.IsUpdatingServerConfig}" Height="38" Padding="16,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="FolderEditOutline" Width="18" Height="18" />
                        <TextBlock Text="{loc:T SaveFolder}" FontWeight="Bold" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Helyi zenemappa -->
              <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:T LocalFolderLabel}" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                  <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Text="{Binding ServerSettings.LocalLibraryPath, Mode=TwoWay}" Watermark="{loc:T LocalFolderPlaceholder}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ServerSettings.StartScanFolderCommand}" IsEnabled="{Binding !ServerSettings.IsScanning}" Height="38" Padding="16,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" />
                        <TextBlock Text="{loc:T Scan}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding ServerSettings.ScanProgress}" Height="4" CornerRadius="2"
                               Foreground="{DynamicResource LimeAccent}" IsVisible="{Binding ServerSettings.IsScanning}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Felhasználókezelés (Adminisztrátori kártya) -->
          <Border Classes="glass lime" IsVisible="{Binding ServerSettings.IsAdmin}">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{loc:T Users}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                  <TextBlock Text="{loc:T UsersSubtitle}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" Command="{Binding ServerSettings.LoadUsersCommand}" ToolTip.Tip="{loc:T TipRefreshList}">
                  <material:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
              </Grid>

              <!-- Új felhasználó hozzáadása form -->
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:T NewUser}" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                <Grid ColumnDefinitions="*, *, *, Auto">
                  <TextBox Grid.Column="0" Text="{Binding ServerSettings.NewUsername, Mode=TwoWay}" Watermark="{loc:T UsernamePlaceholder}" Margin="0,0,6,0" />
                  <TextBox Grid.Column="1" Text="{Binding ServerSettings.NewPassword, Mode=TwoWay}" Watermark="{loc:T PasswordMinPlaceholder}" PasswordChar="•" Margin="0,0,6,0" />
                  <TextBox Grid.Column="2" Text="{Binding ServerSettings.ConfirmPassword, Mode=TwoWay}" Watermark="{loc:T PasswordConfirmPlaceholder}" PasswordChar="•" Margin="0,0,6,0" />
                  <Button Grid.Column="3" Classes="primary" Command="{Binding ServerSettings.AddUserCommand}" IsEnabled="{Binding !ServerSettings.IsAddingUser}" Height="38" Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <material:MaterialIcon Kind="AccountPlus" Width="16" Height="16" />
                      <TextBlock Text="{loc:T Add}" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>

              <!-- Error alert -->
              <Border Background="#28FF003C" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="6" Padding="10,6"
                      IsVisible="{Binding ServerSettings.HasUserManagementError}">
                <TextBlock Text="{Binding ServerSettings.UserManagementErrorMessage}" Foreground="{DynamicResource DangerColor}" FontSize="12" FontWeight="SemiBold" />
              </Border>

              <!-- Felhasználói lista -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:T RegisteredUsers}" Classes="group-title" FontSize="10" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding ServerSettings.ServerUsers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:UserInfo">
                      <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                          <material:MaterialIcon Grid.Column="0" Kind="{Binding IsAdmin, Converter={StaticResource BoolToAdminIconConverter}}"
                                                 Width="20" Height="20" Foreground="{DynamicResource LimeAccent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}" />
                            <TextBlock Text="{loc:TFormat CreatedAt, Path=CreatedAt}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                          </StackPanel>

                          <Border Grid.Column="2" Background="{DynamicResource Surface1}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding IsAdmin, Converter={StaticResource BoolToRoleTextConverter}}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource LimeAccent}" />
                          </Border>

                          <Button Grid.Column="3" Classes="icon"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ServerSettings.DeleteUserCommand}"
                                  CommandParameter="{Binding Id}"
                                  ToolTip.Tip="{loc:T TipDeleteUser}"
                                  IsVisible="{Binding !IsAdmin}">
                            <material:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- COLUMN 2: AUDIO SETTINGS -->
        <StackPanel Grid.Column="1" Spacing="16" Margin="12,0,0,0">
          <TextBlock Text="{loc:T SettingsAppearanceSection}" Classes="group-title" />

          <!-- Language & theme -->
          <Border Classes="glass cyan">
            <StackPanel Spacing="14">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:T Language}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                <TextBlock Text="{loc:T SettingsLanguageHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding LanguageOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LanguageOptionViewModel">
                    <Button Classes="secondary" Classes.selected="{Binding IsSelected}"
                            Height="34" Padding="16,0"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChangeLanguageCommand}"
                            CommandParameter="{Binding Code}"
                            Content="{Binding NativeName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{loc:T Theme}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                  <TextBlock Text="{loc:T SettingsThemeHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Height="34" Padding="14,0" Command="{Binding ToggleThemeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ThemeLightDark" Width="16" Height="16" />
                    <TextBlock Text="{loc:T Theme}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="{loc:T Lyrics}" Classes="group-title" />

          <!-- Lyrics from the internet for tracks that have none of their own -->
          <Border Classes="glass cyan">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{loc:T SettingsOnlineLyrics}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                <TextBlock Text="{loc:T SettingsOnlineLyricsHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="" OffContent=""
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            IsChecked="{Binding UseOnlineLyrics, Mode=TwoWay}"
                            AutomationProperties.Name="{loc:T SettingsOnlineLyrics}" />
            </Grid>
          </Border>

          <TextBlock Text="{loc:T SettingsAudioSection}" Classes="group-title" />

          <!-- Exclusive & Bit-Perfect Modes -->
          <Grid ColumnDefinitions="*, *">
            <Border Grid.Column="0" Classes="metric-card lime" Margin="0,0,6,0">
              <StackPanel VerticalAlignment="Center" Spacing="8">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T ExclusiveLabel}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LimeAccent}" />
                    <TextBlock Text="{loc:T ExclusiveDescription}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                OnContent="" OffContent=""
                                VerticalAlignment="Center"
                                IsChecked="{Binding AudiophileSettings.IsExclusiveMode, Mode=TwoWay}"
                                IsEnabled="{Binding AudiophileSettings.IsExclusiveAvailable}" />
                </Grid>
                <TextBlock Text="{loc:T ExclusiveUnavailable}"
                           IsVisible="{Binding !AudiophileSettings.IsExclusiveAvailable}"
                           FontSize="10" Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="metric-card purple" Margin="6,0,0,0">
              <StackPanel VerticalAlignment="Center" Spacing="8">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T ModeBitPerfect}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
                    <TextBlock Text="{loc:T BitPerfectDescription}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                OnContent="" OffContent=""
                                VerticalAlignment="Center"
                                IsChecked="{Binding AudiophileSettings.IsBitperfect, Mode=TwoWay}"
                                IsEnabled="{Binding AudiophileSettings.IsBitperfectAvailable}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Kimeneti eszköz -->
          <Border Classes="glass cyan">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{loc:T OutputDevice}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding AudiophileSettings.RefreshDevicesCommand}" Height="34" Padding="14,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                    <TextBlock Text="{loc:T Refresh}" />
                  </StackPanel>
                </Button>
              </Grid>

              <ComboBox ItemsSource="{Binding AudiophileSettings.AvailableDevices}"
                        SelectedItem="{Binding AudiophileSettings.SelectedDevice}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="models:AudioOutputDevice">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="Speakers" Width="16" Height="16" Foreground="{DynamicResource CyanAccent}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DriverType, StringFormat='[{0}]'}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="{Binding AudiophileSettings.HardwareStatusText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Jelút -->
          <Border Classes="glass lime">
            <StackPanel Spacing="12">
              <TextBlock Text="{loc:T SignalPath}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
              <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="16">
                <TextBlock Text="{Binding AudiophileSettings.SignalPath}"
                           FontFamily="Consolas, JetBrains Mono, Courier New, monospace"
                           FontSize="12" Foreground="{DynamicResource LimeAccent}" LineHeight="20" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>

</UserControl>
