<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.ArtistsView"
             x:DataType="vm:MainViewModel">

  <!-- The Artists tab: the artist grid and the artist detail page. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Artists}, Converter={StaticResource IntEqualConverter}}">

    <!-- Subview 1: All Artists Grid -->
    <Grid Classes="page" RowDefinitions="Auto, *" IsVisible="{Binding !Artists.IsArtistDetailOpen}">
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
        <TextBlock Grid.Column="0" Text="{loc:T NavArtists}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{loc:T SortBy}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="secondary selected" Height="32" Padding="14,0" MinWidth="72"
                  Command="{Binding Artists.ToggleSortCommand}">
            <TextBlock Text="{Binding Artists.SortNameLabel}" FontWeight="SemiBold" FontSize="12" />
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Classes="page" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                  IsVisible="{Binding IsLibraryEmpty}">
        <material:MaterialIcon Kind="AccountMusic" Width="64" Height="64" Foreground="{DynamicResource CoralAccent}" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T EmptyArtistsTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T EmptyConnectHint}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="-10,0,0,0" Padding="10,8,0,0" ClipToBounds="False">
        <ItemsControl ItemsSource="{Binding Artists.DisplayedArtists}" ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:Artist">
              <controls:ArtistTileView
                OpenCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.OpenArtistCommand}"
                PlayCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Subview 2: Artist Detail View (Albums & Tracks) -->
    <Grid Classes="page" RowDefinitions="Auto, Auto, *" IsVisible="{Binding Artists.IsArtistDetailOpen}">
      <!-- Back Button -->
      <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
              HorizontalAlignment="Left"
              Command="{Binding Artists.CloseArtistDetailCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource CoralAccent}" />
          <TextBlock Text="{Binding Artists.BackButtonText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Artist Hero Card -->
      <Border Grid.Row="1" Classes="glass coral" Margin="0,0,0,20">
        <Grid ColumnDefinitions="140, *">
          <Border Grid.Column="0" Width="120" Height="120" CornerRadius="60" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
            <Panel>
              <material:MaterialIcon Kind="AccountMusic" Foreground="{DynamicResource CoralAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <controls:CoverImage SourcePath="{Binding Artists.SelectedArtist.PicturePath}" DecodeWidth="210" Stretch="UniformToFill" />
            </Panel>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="8,0,0,0">
            <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
              <TextBlock Text="{loc:T ColArtist}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CoralAccent}" />
            </Border>
            <TextBlock Text="{Binding Artists.SelectedArtist.Name}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
            <TextBlock Text="{loc:TFormat TrackCountInDatabase, Path=Artists.SelectedArtist.TrackCount}" FontSize="13" Foreground="{DynamicResource TextMuted}" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
              <Button Classes="coral" CornerRadius="6" Height="38"
                      Command="{Binding Artists.PlayArtistCommand}" CommandParameter="{Binding Artists.SelectedArtist}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                  <TextBlock Text="{loc:T Play}" FontWeight="Bold" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" CornerRadius="6" Height="38"
                      Command="{Binding Artists.ShuffleArtistCommand}" CommandParameter="{Binding Artists.SelectedArtist}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{DynamicResource CoralAccent}" />
                  <TextBlock Text="{loc:T Shuffle}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Artist Albums & Tracks Scrollable Content -->
      <ScrollViewer Grid.Row="2" Margin="-10,0,0,0" Padding="10,8,0,0" ClipToBounds="False">
        <StackPanel Spacing="24">

          <!-- Section: Albums by this Artist -->
          <StackPanel Spacing="12" IsVisible="{Binding Artists.HasSelectedArtistAlbums}">
            <TextBlock Text="{loc:T LabelAlbums}" Classes="group-title" Margin="4,0,0,0" />
            <ItemsControl ItemsSource="{Binding Artists.SelectedArtistAlbumCards}" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AlbumCardViewModel">
                  <controls:AlbumTileView
                    OpenCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                    PlayCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Section: All Tracks by this Artist -->
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:T LabelAllTracks}" Classes="group-title" Margin="4,0,0,0" />
            <Border Classes="glass coral" Padding="0" ClipToBounds="True">
              <DataGrid ItemsSource="{Binding Artists.SelectedArtistTracks}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal"
                        HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <!-- Cover (Clickable to play track) -->
                  <DataGridTemplateColumn Width="50" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="models:Track">
                        <Button Classes="unstyled-cover"
                                Classes.playing="{Binding IsPlaying}"
                                controls:RowPressSync.SyncWithTitle="True"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistTrackCommand}"
                                CommandParameter="{Binding}">
                          <Border Width="32" Height="32"
                                  CornerRadius="4"
                                  Background="{DynamicResource Surface2}"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <Panel>
                              <material:MaterialIcon Kind="MusicNote"
                                                     Foreground="{DynamicResource TextMuted}"
                                                     Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                              <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                   DecodeWidth="64"
                                                   Stretch="UniformToFill" />

                              <!-- Currently Playing Volume Overlay -->
                              <Border Background="#A0000000" IsVisible="{Binding IsPlaying}">
                                <controls:EqualizerBars IsVisible="{Binding IsPlaying}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Panel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <!-- Title (Clickable to play track) -->
                  <DataGridTemplateColumn Header="{loc:T ColTitle}" Width="2.5*" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="models:Track">
                        <Button Classes="table-link title"
                                Classes.playing="{Binding IsPlaying}"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistTrackCommand}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <!-- Album (Clickable) -->
                  <DataGridTemplateColumn Header="{loc:T ColAlbum}" Width="1.5*" SortMemberPath="Album" CellTemplate="{StaticResource TrackAlbumLinkCell}" />

                  <DataGridTemplateColumn Header="{loc:T ColQuality}" Width="185" SortMemberPath="Format.DisplayBadge" CellTemplate="{StaticResource TrackQualityCell}" />
                  <DataGridTextColumn Header="{loc:T ColLength}" Binding="{Binding FormattedDuration}" Width="105" SortMemberPath="Duration" />

                  <!-- Favorite -->
                  <DataGridTemplateColumn Width="50" Header="" SortMemberPath="IsFavorite" CellTemplate="{StaticResource TrackFavoriteCell}" />

                  <DataGridTemplateColumn Width="44" Header="" CellTemplate="{StaticResource TrackAddToPlaylistCell}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>

</UserControl>
