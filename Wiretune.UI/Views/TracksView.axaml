<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.TracksView"
             x:DataType="vm:MainViewModel">

  <!-- The Tracks tab: every track of the library in one table. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Tracks}, Converter={StaticResource IntEqualConverter}}"
        RowDefinitions="Auto, *">

    <!-- Tab Header / Actions -->
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{loc:T NavTracks}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{loc:TFormat TrackCount, Path=Tracks.TotalTracksCount}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
          <TextBlock Text="•" FontSize="13" Foreground="{DynamicResource TextMuted}" />
          <TextBlock Text="{Binding Tracks.TotalTracksDuration}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Classes="primary" Command="{Binding Tracks.PlayAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="Play" Width="18" Height="18" />
            <TextBlock Text="{loc:T Play}" FontWeight="Bold" />
          </StackPanel>
        </Button>
        <Button Classes="secondary" Command="{Binding Tracks.ShuffleAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{DynamicResource CyanAccent}" />
            <TextBlock Text="{loc:T Shuffle}" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Tracks Content -->
    <Border Grid.Row="1" Classes="glass cyan" Padding="0" ClipToBounds="True">
      <Panel>
        <!-- Empty Library Placeholder -->
        <StackPanel Classes="page" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32"
                    IsVisible="{Binding IsLibraryEmpty}">
          <material:MaterialIcon Kind="FolderMusic" Width="64" Height="64" Foreground="{DynamicResource CyanAccent}" HorizontalAlignment="Center" />
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="{loc:T EmptyLibraryTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T EmptyLibraryHint}"
                       FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Classes="primary" Margin="6" Command="{Binding ShowLoginScreenCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="ServerNetwork" Width="18" Height="18" />
                <TextBlock Text="{loc:T ConnectToServer}" FontWeight="Bold" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Margin="6" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Settings}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" />
                <TextBlock Text="{loc:T LocalFolder}" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding IsStarting}" />

        <!-- DataGrid when songs are available -->
        <DataGrid ItemsSource="{Binding Tracks.DisplayedTracks}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  IsVisible="{Binding Tracks.HasTracks}"
                  GridLinesVisibility="Horizontal"
                  HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <!-- Album/Track Cover Column (Clickable to play track) -->
            <DataGridTemplateColumn Width="50" Header="">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="models:Track">
                  <Button Classes="unstyled-cover"
                          Classes.playing="{Binding IsPlaying}"
                          controls:RowPressSync.SyncWithTitle="True"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.PlayTrackCommand}"
                          CommandParameter="{Binding}">
                    <Border Width="32" Height="32"
                            CornerRadius="4"
                            Background="{DynamicResource Surface2}"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                      <Panel>
                        <material:MaterialIcon Kind="MusicNote"
                                               Foreground="{DynamicResource TextMuted}"
                                               Width="16" Height="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                             DecodeWidth="64"
                                             Stretch="UniformToFill" />

                        <!-- Currently Playing Volume Overlay -->
                        <Border Background="#A0000000" IsVisible="{Binding IsPlaying}">
                          <controls:EqualizerBars IsVisible="{Binding IsPlaying}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                    </Border>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Title (Clickable to play track) -->
            <DataGridTemplateColumn Header="{loc:T ColTitle}" Width="2*" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="models:Track">
                  <Button Classes="table-link title"
                          Classes.playing="{Binding IsPlaying}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.PlayTrackCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Artist (Clickable to open Artist page) -->
            <DataGridTemplateColumn Header="{loc:T ColArtist}" Width="1.5*" SortMemberPath="Artist" CellTemplate="{StaticResource TrackArtistLinkCell}" />

            <!-- Album (Clickable to open Album page) -->
            <DataGridTemplateColumn Header="{loc:T ColAlbum}" Width="1.5*" SortMemberPath="Album" CellTemplate="{StaticResource TrackAlbumLinkCell}" />

            <!-- Audio Format / Quality Badge -->
            <DataGridTemplateColumn Header="{loc:T ColQuality}" Width="185" SortMemberPath="Format.DisplayBadge" CellTemplate="{StaticResource TrackQualityCell}" />

            <!-- Duration -->
            <DataGridTextColumn Header="{loc:T ColLength}" Binding="{Binding FormattedDuration}" Width="105" SortMemberPath="Duration" />

            <!-- Favorite -->
            <DataGridTemplateColumn Width="50" Header="" SortMemberPath="IsFavorite" CellTemplate="{StaticResource TrackFavoriteCell}" />
            <DataGridTemplateColumn Width="44" Header="" CellTemplate="{StaticResource TrackAddToPlaylistCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </Panel>
    </Border>
  </Grid>

</UserControl>
