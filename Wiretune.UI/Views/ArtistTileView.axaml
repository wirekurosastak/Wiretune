<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:models="using:Wiretune.Core.Models"
             x:Class="Wiretune.UI.Controls.ArtistTileView"
             x:DataType="models:Artist"
             x:Name="Root"
             ClipToBounds="False">
  <Button Classes="unstyled-card"
          Command="{Binding OpenCommand, ElementName=Root}"
          CommandParameter="{Binding}"
          Margin="0,6,18,12">
    <Border Classes="metric-card coral" Width="210" Height="270">
      <Grid RowDefinitions="150, *, Auto">
        <!-- Artist Artwork / Portrait (Round portrait matching 150px album size) -->
        <Border Grid.Row="0" Width="150" Height="150" CornerRadius="75" Background="{DynamicResource Surface2}" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
          <Panel>
            <material:MaterialIcon Kind="AccountMusic" Foreground="{DynamicResource CoralAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <controls:CoverImage SourcePath="{Binding PicturePath}" DecodeWidth="210" Stretch="UniformToFill" />
          </Panel>
        </Border>

        <!-- Artist Name & Track Count -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{loc:TFormat TrackCount, Path=TrackCount}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Tag & Play Button -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
          <Border Grid.Column="0" Background="{DynamicResource TagBackground}"
                  CornerRadius="4"
                  Padding="6,2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <TextBlock Text="{loc:T ColArtist}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CoralAccent}" VerticalAlignment="Center" />
          </Border>
          <Button Grid.Column="1" Classes="coral"
                  Width="32" Height="32"
                  CornerRadius="4"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Command="{Binding PlayCommand, ElementName=Root}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{loc:T Play}">
            <material:MaterialIcon Kind="Play" Foreground="{DynamicResource PrimaryActionForeground}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Button>
</UserControl>
