<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:services="using:Wiretune.UI.Services"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Panel Background="{DynamicResource WindowGradient}">
    <Grid RowDefinitions="70, Auto, *, 96, 30"
          IsVisible="{Binding !IsLoginViewActive}">

      <!-- ========================================== -->
      <!-- TOP HEADER BAR                             -->
      <!-- ========================================== -->
      <Border Grid.Row="0"
              x:Name="HeaderBar"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,0,0,1"
              Padding="24,0"
              PointerPressed="HeaderBar_PointerPressed">
        <Grid ColumnDefinitions="*, Auto, *">

          <!-- Brand Logo and App Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16" Margin="0,0,16,0">
            <controls:NavVisualizerControl Width="38" Height="28"
                                           VerticalAlignment="Center"
                                           WaveTrigger="{Binding WaveTrigger}"
                                           WaveDirection="{Binding LastWaveDirection}"
                                           AccentBrush="{DynamicResource PrimaryAction}"
                                           IsPlaying="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                                           ToolTip.Tip="Wiretune Streamer Visualizer" />
            <StackPanel VerticalAlignment="Center" Spacing="0" IsVisible="{Binding !IsCompactLayout}">
              <TextBlock Text="WIRETUNE" FontSize="18" FontWeight="Black" LetterSpacing="2.0" Foreground="{DynamicResource TextMain}" />
              <TextBlock Text="STREAMER &amp; PLAYER" FontSize="9" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource PrimaryAction}">
                <TextBlock.Transitions>
                  <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.35" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
            </StackPanel>
          </StackPanel>

          <!-- Search Bar -->
          <TextBox Grid.Column="1"
                   Classes="search-pill"
                   HorizontalAlignment="Center"
                   Width="380"
                   MaxWidth="440"
                   Height="38"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   Watermark="Keresés számok, előadók, albumok között...">
            <TextBox.InnerLeftContent>
              <material:MaterialIcon Kind="Magnify"
                                     Width="18" Height="18"
                                     Foreground="{DynamicResource TextMuted}"
                                     Margin="14,0,8,0"
                                     VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="icon"
                      Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding IsSearchActive}"
                      Width="28" Height="28"
                      Margin="0,0,8,0"
                      ToolTip.Tip="Keresés törlése">
                <material:MaterialIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <!-- Top Right Audiophile Badges & Controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10" Margin="16,0,0,0">
            <!-- Bitperfect Active Pill -->
            <Button Command="{Binding Player.ToggleBitperfectCommand}"
                    IsVisible="{Binding !IsCompactLayout}"
                    Classes="secondary audiophile-pill"
                    Classes.active-bp="{Binding Player.IsBitperfect}"
                    ToolTip.Tip="Bit-Perfect mód (1:1 veszteségmentes kimenet, 0 dB Unity Gain hangerőrögzítés)">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Panel Width="7" Height="7" VerticalAlignment="Center">
                  <Ellipse Classes="status-pulse" Width="7" Height="7"
                           Fill="{DynamicResource PurpleAccent}"
                           IsVisible="{Binding Player.IsBitperfect}" />
                </Panel>
                <TextBlock Text="BIT-PERFECT" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource PurpleAccent}"
                           IsVisible="{Binding Player.IsBitperfect}"
                           VerticalAlignment="Center" />
                <TextBlock Text="BIT-PERFECT" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           IsVisible="{Binding !Player.IsBitperfect}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Exclusive Mode Active Pill -->
            <Button Command="{Binding Player.ToggleExclusiveModeCommand}"
                    IsVisible="{Binding !IsCompactLayout}"
                    Classes="secondary audiophile-pill"
                    Classes.active-exc="{Binding Player.IsExclusiveMode}"
                    ToolTip.Tip="Kizárólagos (Exclusive) mód (közvetlen ALSA / WASAPI DAC hozzáférés)">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Panel Width="7" Height="7" VerticalAlignment="Center">
                  <Ellipse Classes="status-pulse" Width="7" Height="7"
                           Fill="{DynamicResource LimeAccent}"
                           IsVisible="{Binding Player.IsExclusiveMode}" />
                </Panel>
                <TextBlock Text="EXCLUSIVE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource LimeAccent}"
                           IsVisible="{Binding Player.IsExclusiveMode}"
                           VerticalAlignment="Center" />
                <TextBlock Text="EXCLUSIVE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           IsVisible="{Binding !Player.IsExclusiveMode}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- User / Login Pill -->
            <Button Command="{Binding ShowLoginScreenCommand}"
                    Classes="secondary audiophile-pill"
                    ToolTip.Tip="Wiretune Szerver Fiók és Bejelentkezés">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <material:MaterialIcon Kind="AccountCircleOutline" Width="16" Height="16"
                                       Foreground="{DynamicResource CyanAccent}"
                                       IsVisible="{Binding IsUserLoggedIn}" />
                <material:MaterialIcon Kind="KeyOutline" Width="16" Height="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !IsUserLoggedIn}" />
                <TextBlock Text="{Binding CurrentUserBadge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Theme Toggle -->
            <Button Classes="icon" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Téma váltása (Sötét / Világos)">
              <material:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
            </Button>

            <!-- Window Control Buttons (Minimize, Maximize, Close) -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
              <Button Classes="icon" Click="MinimizeWindow_Click" ToolTip.Tip="Kis méret">
                <material:MaterialIcon Kind="WindowMinimize" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" Click="MaximizeWindow_Click" ToolTip.Tip="Teljes méret / Visszaállítás">
                <material:MaterialIcon Kind="WindowMaximize" Width="16" Height="16" />
              </Button>
              <Button Classes="icon close-btn" Click="CloseWindow_Click" ToolTip.Tip="Bezárás">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- SERVER OFFLINE WARNING BANNER              -->
      <!-- ========================================== -->
      <Border Grid.Row="1"
              Background="#28FF003C"
              BorderBrush="{DynamicResource DangerColor}"
              BorderThickness="0,0,0,1"
              Padding="24,10"
              IsVisible="{Binding IsServerOfflineBannerVisible}">
        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="{DynamicResource DangerColor}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="10,0,16,0" Text="{Binding ServerBannerMessage}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" TextWrapping="Wrap" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
            <Button Classes="primary" Height="30" Padding="12,0" Command="{Binding RetryConnectServerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                <TextBlock Text="Újracsatlakozás" FontSize="12" FontWeight="Bold" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Height="30" Padding="12,0" Command="{Binding NavigateToCommand}" CommandParameter="5">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                <TextBlock Text="Beállítások" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Column="3" Classes="icon" Command="{Binding DismissServerBannerCommand}" ToolTip.Tip="Értesítés bezárása">
            <material:MaterialIcon Kind="Close" Width="16" Height="16" />
          </Button>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- MAIN WORKSPACE: SIDEBAR + CONTENT          -->
      <!-- ========================================== -->
      <Grid Grid.Row="2">
        <Grid ColumnDefinitions="Auto, *">

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Classes="sidebar"
                Classes.compact="{Binding IsCompactLayout}"
                Background="{DynamicResource Surface1}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="0,0,1,0">
          <ScrollViewer>
            <StackPanel Spacing="24">

              <!-- KÖNYVTÁR -->
              <StackPanel Spacing="4">
                <TextBlock Text="KÖNYVTÁR" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Előadók (Artists) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=2, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Előadók"
                        Command="{Binding NavigateToCommand}" CommandParameter="2">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="AccountMusicOutline" Foreground="{DynamicResource CoralAccent}" Width="20" Height="20" />
                      <TextBlock Text="Előadók" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalArtistsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CoralAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Albumok (Albums) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=1, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Albumok"
                        Command="{Binding NavigateToCommand}" CommandParameter="1">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="20" Height="20" />
                      <TextBlock Text="Albumok" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalAlbumsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Számok (Tracks) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=0, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Számok"
                        Command="{Binding NavigateToCommand}" CommandParameter="0">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="MusicNoteOutline" Foreground="{DynamicResource CyanAccent}" Width="20" Height="20" />
                      <TextBlock Text="Számok" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalTracksCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccent}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- GYŰJTEMÉNY -->
              <StackPanel Spacing="4">
                <TextBlock Text="GYŰJTEMÉNY" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Kedvencek (Favorites) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=4, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Kedvencek"
                        Command="{Binding NavigateToCommand}" CommandParameter="4">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Heart" Foreground="{DynamicResource CoralAccent}" Width="20" Height="20" />
                      <TextBlock Text="Kedvencek" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalFavoritesCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CoralAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Lejátszási listák (Playlists) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=3, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Lejátszási listák"
                        Command="{Binding NavigateToCommand}" CommandParameter="3">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="PlaylistMusicOutline" Foreground="{DynamicResource LimeAccent}" Width="20" Height="20" />
                      <TextBlock Text="Lejátszási listák" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalPlaylistsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource LimeAccent}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- BEÁLLÍTÁSOK -->
              <StackPanel Spacing="4">
                <TextBlock Text="BEÁLLÍTÁSOK" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Beállítások (Audiophile & Szerver) -->
                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedNavigationIndex, ConverterParameter=5, Converter={StaticResource NavActiveBackgroundConverter}}"
                        ToolTip.Tip="Beállítások"
                        Command="{Binding NavigateToCommand}" CommandParameter="5">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <material:MaterialIcon Kind="CogOutline" Foreground="{DynamicResource CyanAccent}" Width="20" Height="20" />
                    <TextBlock Text="Beállítások" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                  </StackPanel>
                </Button>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Center Dynamic Tab Content -->
        <Border Grid.Column="1" Padding="28,24">
          <Panel>

            <!-- Standard Library Tabs (Visible when not actively searching) -->
            <Panel IsVisible="{Binding !IsSearchActive}">

              <!-- ============================================== -->
              <!-- TAB 0: TRACKS BROWSER (SZÁMOK)                 -->
              <!-- ============================================== -->
            <Grid IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=0, Converter={StaticResource IntEqualConverter}}"
                  RowDefinitions="Auto, *">
              
              <!-- Tab Header / Actions -->
              <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Számok" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Tracks.TotalTracksCount, StringFormat='{}{0} szám'}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="•" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding Tracks.TotalTracksDuration}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Button Classes="primary" Command="{Binding Tracks.PlayAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                      <TextBlock Text="Mind lejátszása" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary" Command="{Binding Tracks.ShuffleAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" />
                      <TextBlock Text="Véletlenszerű" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Tracks Content -->
              <Border Grid.Row="1" Classes="glass cyan" Padding="0" ClipToBounds="True">
                <Panel>
                  <!-- Empty Library Placeholder -->
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32"
                              IsVisible="{Binding IsLibraryEmpty}">
                    <material:MaterialIcon Kind="FolderMusic" Width="64" Height="64" Foreground="{DynamicResource CyanAccent}" HorizontalAlignment="Center" />
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                      <TextBlock Text="A zenei könyvtárad még üres" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                      <TextBlock Text="Csatlakozz a Wiretune szerveredhez, vagy olvass be egy helyi zenemappát a Beállításokban."
                                 FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                      <Button Classes="primary" Margin="6" Command="{Binding ShowLoginScreenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <material:MaterialIcon Kind="ServerNetwork" Width="18" Height="18" />
                          <TextBlock Text="Csatlakozás szerverhez" FontWeight="Bold" />
                        </StackPanel>
                      </Button>
                      <Button Classes="secondary" Margin="6" Command="{Binding NavigateToCommand}" CommandParameter="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <material:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" />
                          <TextBlock Text="Helyi mappa" FontWeight="Bold" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>

                  <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding IsStarting}" />

                  <!-- DataGrid when songs are available -->
                  <DataGrid ItemsSource="{Binding Tracks.DisplayedTracks}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            IsVisible="{Binding Tracks.HasTracks}"
                            GridLinesVisibility="Horizontal"
                            HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                      <!-- Album/Track Cover Column (Clickable to play track) -->
                      <DataGridTemplateColumn Width="50" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="unstyled-cover"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.PlayTrackCommand}"
                                    CommandParameter="{Binding}">
                              <Border Width="32" Height="32"
                                      CornerRadius="4"
                                      Background="{DynamicResource Surface2}"
                                      ClipToBounds="True"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                <Panel>
                                  <material:MaterialIcon Kind="MusicNote"
                                                         Foreground="{DynamicResource TextMuted}"
                                                         Width="16" Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                  <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                       DecodeWidth="64"
                                                       Stretch="UniformToFill" />
                                </Panel>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Title (Clickable to play track) -->
                      <DataGridTemplateColumn Header="CÍM" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="table-link title"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.PlayTrackCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Artist (Clickable to open Artist page) -->
                      <DataGridTemplateColumn Header="ELŐADÓ" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="table-link artist"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                                    CommandParameter="{Binding Artist}">
                              <TextBlock Text="{Binding Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Album (Clickable to open Album page) -->
                      <DataGridTemplateColumn Header="ALBUM" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="table-link album"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Audio Format / Quality Badge -->
                      <DataGridTemplateColumn Header="MINŐSÉG" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Border Background="{DynamicResource Surface2}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding Format.DisplayBadge}"
                                         FontSize="10"
                                         FontWeight="Bold"
                                         Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Duration -->
                      <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="95" />

                      <!-- Favorite -->
                      <DataGridTemplateColumn Width="50" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                              <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                     Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                                     Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Width="44" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon" ToolTip.Tip="Hozzáadás lejátszási listához"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                              <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Panel>
              </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 1: ALBUMS (ALBUMOK)                        -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=1, Converter={StaticResource IntEqualConverter}}">

              <!-- Subview 1: Albums Grid (when no album detail open) -->
              <Grid RowDefinitions="Auto, *" IsVisible="{Binding !Albums.IsAlbumDetailOpen}">
                <TextBlock Grid.Row="0" Text="Albumok" FontSize="26" FontWeight="Black" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}" />
                
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                            IsVisible="{Binding IsLibraryEmpty}">
                  <material:MaterialIcon Kind="Album" Width="64" Height="64" Foreground="{DynamicResource PurpleAccent}" HorizontalAlignment="Center" />
                  <TextBlock Text="Még nincsenek albumok" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                  <TextBlock Text="Csatlakozz a szerveredhez vagy olvass be egy helyi mappát a Beállításokban." FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="0,6,0,0" ClipToBounds="False">
                  <ItemsControl ItemsSource="{Binding Albums.DisplayedAlbums}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:AlbumCardViewModel">
                        <Button Classes="unstyled-card"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.OpenAlbumCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,6,18,12">
                          <Border Classes="metric-card purple" Width="210" Height="270" services:ViewportLoad.Target="{Binding}">
                            <Grid RowDefinitions="150, *, Auto">
                              <!-- Cover placeholder / art -->
                              <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                                <Panel>
                                  <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                              </Border>

                              <!-- Album Title & Artist -->
                              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <!-- Badge & Play Button (Sleek non-circular rounded button) -->
                              <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                <Border Grid.Column="0" Background="{DynamicResource Surface2}"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1" Classes="purple"
                                        Width="32" Height="32"
                                        CornerRadius="4"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumCommand}"
                                        CommandParameter="{Binding Album}"
                                        ToolTip.Tip="Album lejátszása">
                                  <material:MaterialIcon Kind="Play" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                              </Grid>
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <!-- Subview 2: Album Detail View (Tracklist & Controls) -->
              <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding Albums.IsAlbumDetailOpen}">
                <!-- Back Button -->
                <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Command="{Binding Albums.CloseAlbumDetailCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource PurpleAccent}" />
                    <TextBlock Text="{Binding Albums.BackButtonText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Album Hero Banner -->
                <Border Grid.Row="1" Classes="glass purple" Margin="0,0,0,20">
                  <Grid ColumnDefinitions="140, *">
                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
                      <Panel>
                        <Image Source="{Binding Albums.SelectedAlbumCover}" Stretch="UniformToFill" IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNull}}" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2">
                          <TextBlock Text="ALBUM" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PurpleAccent}" />
                        </Border>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2">
                          <TextBlock Text="{Binding Albums.SelectedAlbum.FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding Albums.SelectedAlbum.FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Text="{Binding Albums.SelectedAlbum.Title}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="table-link"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                                CommandParameter="{Binding Albums.SelectedAlbum.Artist}">
                          <TextBlock Text="{Binding Albums.SelectedAlbum.Artist}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
                        </Button>
                        <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Albums.SelectedAlbum.Year}" FontSize="13" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Albums.SelectedAlbum.Year, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                        <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Albums.SelectedAlbum.TrackCount, StringFormat='{}{0} zeneszám'}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Albums.SelectedAlbum.FormattedTotalDuration}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- Action Buttons -->
                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                        <Button Classes="purple" Height="38" CornerRadius="6" Command="{Binding Albums.PlayAlbumCommand}" CommandParameter="{Binding Albums.SelectedAlbum}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                            <TextBlock Text="Album lejátszása" FontWeight="Bold" />
                          </StackPanel>
                        </Button>
                        <Button Classes="secondary" Height="38" CornerRadius="6" Command="{Binding Albums.ShuffleAlbumCommand}" CommandParameter="{Binding Albums.SelectedAlbum}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" />
                            <TextBlock Text="Véletlenszerű" FontWeight="Bold" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Tracklist DataGrid -->
                <Border Grid.Row="2" Classes="glass purple" Padding="0" ClipToBounds="True">
                  <DataGrid ItemsSource="{Binding Albums.SelectedAlbum.Tracks}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            GridLinesVisibility="Horizontal"
                            HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                      <!-- Track # -->
                      <DataGridTextColumn Header="#" Binding="{Binding DisplayTrackNumber}" Width="45" />

                      <!-- Title (Clickable to play track) -->
                      <DataGridTemplateColumn Header="CÍM" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="table-link album"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumTrackCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Format / Quality -->
                      <DataGridTemplateColumn Header="MINŐSÉG" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Format.DisplayBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <!-- Duration -->
                      <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="95" />

                      <!-- Favorite -->
                      <DataGridTemplateColumn Width="50" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}">
                              <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                     Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                                     Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Width="44" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon" ToolTip.Tip="Hozzáadás lejátszási listához"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                              <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>

              </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 2: ARTISTS (ELŐADÓK)                       -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=2, Converter={StaticResource IntEqualConverter}}">

              <!-- Subview 1: All Artists Grid -->
              <Grid RowDefinitions="Auto, *" IsVisible="{Binding !Artists.IsArtistDetailOpen}">
                <TextBlock Grid.Row="0" Text="Előadók" FontSize="26" FontWeight="Black" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}" />
                
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                            IsVisible="{Binding IsLibraryEmpty}">
                  <material:MaterialIcon Kind="AccountMusic" Width="64" Height="64" Foreground="{DynamicResource CoralAccent}" HorizontalAlignment="Center" />
                  <TextBlock Text="Még nincsenek előadók" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                  <TextBlock Text="Csatlakozz a szerveredhez vagy olvass be egy helyi mappát a Beállításokban." FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="0,6,0,0" ClipToBounds="False">
                  <ItemsControl ItemsSource="{Binding Artists.DisplayedArtists}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:Artist">
                        <Button Classes="unstyled-card"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.OpenArtistCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,6,18,12">
                          <Border Classes="metric-card coral" Width="210" Height="270">
                            <Grid RowDefinitions="150, *, Auto">
                              <!-- Artist Artwork / Portrait -->
                              <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                                <Panel>
                                  <material:MaterialIcon Kind="AccountMusic" Foreground="{DynamicResource CoralAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <controls:CoverImage SourcePath="{Binding PicturePath}" DecodeWidth="210" Stretch="UniformToFill" />
                                </Panel>
                              </Border>

                              <!-- Artist Name & Track Count -->
                              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} zeneszám'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <!-- Tag & Play Button -->
                              <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                <Border Grid.Column="0" Background="{DynamicResource Surface2}"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="ELŐADÓ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource CoralAccent}" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="1" Classes="coral"
                                        Width="32" Height="32"
                                        CornerRadius="4"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Összes lejátszása">
                                  <material:MaterialIcon Kind="Play" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                              </Grid>
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <!-- Subview 2: Artist Detail View (Albums & Tracks) -->
              <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding Artists.IsArtistDetailOpen}">
                <!-- Back Button -->
                <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Command="{Binding Artists.CloseArtistDetailCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource CoralAccent}" />
                    <TextBlock Text="{Binding Artists.BackButtonText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Artist Hero Card -->
                <Border Grid.Row="1" Classes="glass coral" Margin="0,0,0,20">
                  <Grid ColumnDefinitions="95, *">
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
                      <Panel>
                        <material:MaterialIcon Kind="AccountMusic" Foreground="{DynamicResource CoralAccent}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <controls:CoverImage SourcePath="{Binding Artists.SelectedArtist.PicturePath}" DecodeWidth="160" Stretch="UniformToFill" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="8,0,0,0">
                      <Border Background="{DynamicResource CoralAccent}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="ELŐADÓ" FontSize="10" FontWeight="Black" Foreground="White" />
                      </Border>
                      <TextBlock Text="{Binding Artists.SelectedArtist.Name}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                      <TextBlock Text="{Binding Artists.SelectedArtist.TrackCount, StringFormat='{}{0} zeneszám az adatbázisban'}" FontSize="13" Foreground="{DynamicResource TextMuted}" />

                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Classes="coral" CornerRadius="6" Height="38"
                                Command="{Binding Artists.PlayArtistCommand}" CommandParameter="{Binding Artists.SelectedArtist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                            <TextBlock Text="Összes lejátszása" FontWeight="Bold" />
                          </StackPanel>
                        </Button>
                        <Button Classes="secondary" CornerRadius="6" Height="38"
                                Command="{Binding Artists.ShuffleArtistCommand}" CommandParameter="{Binding Artists.SelectedArtist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{DynamicResource CoralAccent}" />
                            <TextBlock Text="Véletlenszerű" FontWeight="Bold" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Artist Albums & Tracks Scrollable Content -->
                <ScrollViewer Grid.Row="2" Padding="0,6,0,0" ClipToBounds="False">
                  <StackPanel Spacing="24">
                    
                    <!-- Section: Albums by this Artist -->
                    <StackPanel Spacing="12" IsVisible="{Binding Artists.HasSelectedArtistAlbums}">
                      <TextBlock Text="ALBUMOK" Classes="group-title" Margin="4,0,0,0" />
                      <ItemsControl ItemsSource="{Binding Artists.SelectedArtistAlbumCards}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:AlbumCardViewModel">
                            <Button Classes="unstyled-card"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="0,6,18,12">
                              <Border Classes="metric-card purple" Width="210" Height="270" services:ViewportLoad.Target="{Binding}">
                                <Grid RowDefinitions="150, *, Auto">
                                  <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                                    <Panel>
                                      <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                      <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                    </Panel>
                                  </Border>
                                  <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                    <TextBlock Text="{Binding Year, StringFormat='{}{0}'}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                  </StackPanel>
                                  <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                    <Border Grid.Column="0" Background="{DynamicResource Surface2}"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                      <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding TrackCount, StringFormat='{}{0} szám'}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                  </Grid>
                                </Grid>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Section: All Tracks by this Artist -->
                    <StackPanel Spacing="12">
                      <TextBlock Text="ÖSSZES ZENESZÁM" Classes="group-title" Margin="4,0,0,0" />
                      <Border Classes="glass coral" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Artists.SelectedArtistTracks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Disabled">
                          <DataGrid.Columns>
                            <!-- Cover (Clickable to play track) -->
                            <DataGridTemplateColumn Width="50" Header="">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="unstyled-cover"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistTrackCommand}"
                                          CommandParameter="{Binding}">
                                    <Border Width="32" Height="32"
                                            CornerRadius="4"
                                            Background="{DynamicResource Surface2}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                      <Panel>
                                        <material:MaterialIcon Kind="MusicNote"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                        <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                             DecodeWidth="64"
                                                             Stretch="UniformToFill" />
                                      </Panel>
                                    </Border>
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title (Clickable to play track) -->
                            <DataGridTemplateColumn Header="CÍM" Width="2.5*">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="table-link artist"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistTrackCommand}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Album (Clickable) -->
                            <DataGridTemplateColumn Header="ALBUM" Width="1.5*">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="table-link album"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="MINŐSÉG" Width="185">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Format.DisplayBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="95" />
                      <DataGridTemplateColumn Width="44" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon" ToolTip.Tip="Hozzáadás lejátszási listához"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                              <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </StackPanel>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 3: PLAYLISTS (LEJÁTSZÁSI LISTÁK)           -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=3, Converter={StaticResource IntEqualConverter}}">

              <!-- Subview 1: Playlists Cards Grid (when no playlist detail open) -->
              <Grid RowDefinitions="Auto, *" IsVisible="{Binding !Playlists.IsPlaylistDetailOpen}">
                <!-- Tab Header / Actions -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Lejátszási listák" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="lime" Height="38" CornerRadius="6" Command="{Binding Playlists.OpenCreateDialogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="Black" />
                      <TextBlock Text="Új lejátszási lista" FontWeight="Bold" Foreground="Black" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Empty state: no playlists yet -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32"
                            IsVisible="{Binding !Playlists.HasPlaylists}">
                  <material:MaterialIcon Kind="PlaylistMusicOutline" Width="64" Height="64" Foreground="{DynamicResource LimeAccent}" HorizontalAlignment="Center" />
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Még nincs lejátszási listád" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                    <TextBlock Text="Hozz létre egy listát, majd a számok melletti „+” gombbal adj hozzá zenéket a gyűjteményedből."
                                FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                  </StackPanel>
                  <Button Classes="lime" Height="38" CornerRadius="6" Margin="0,8,0,0" Command="{Binding Playlists.OpenCreateDialogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="Black" />
                      <TextBlock Text="Új lista létrehozása" FontWeight="Bold" Foreground="Black" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- Playlists Cards Grid (210x270 tiles matching Albums and Artists) -->
                <ScrollViewer Grid.Row="1" Padding="0,6,0,0" ClipToBounds="False" IsVisible="{Binding Playlists.HasPlaylists}">
                  <ItemsControl ItemsSource="{Binding Playlists.DisplayedPlaylists}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PlaylistCardViewModel">
                        <Button Classes="unstyled-card"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.OpenPlaylistCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,6,18,12">
                          <Border Classes="metric-card lime" Width="210" Height="270">
                            <Grid RowDefinitions="150, *, Auto">
                              <!-- Playlist 2x2 Covers Collage (4 smaller covers taking up 1 whole cover size) -->
                              <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                                <Panel>
                                  <!-- Fallback placeholder icon if no covers are available -->
                                  <material:MaterialIcon Kind="PlaylistMusic" Foreground="{DynamicResource LimeAccent}" Width="64" Height="64"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding !HasCovers}" />

                                  <!-- Single cover taking up the whole 150px cover if only 1 album available -->
                                  <controls:CoverImage SourcePath="{Binding SingleCoverPath}"
                                                       DecodeWidth="210"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasSingleCover}" />

                                  <!-- 2x2 Collage: 4 smaller covers taking up 1 whole cover size -->
                                  <UniformGrid Rows="2" Columns="2" IsVisible="{Binding HasMultipleCovers}">
                                    <controls:CoverImage SourcePath="{Binding Cover0}" DecodeWidth="105" Stretch="UniformToFill" />
                                    <controls:CoverImage SourcePath="{Binding Cover1}" DecodeWidth="105" Stretch="UniformToFill" />
                                    <controls:CoverImage SourcePath="{Binding Cover2}" DecodeWidth="105" Stretch="UniformToFill" />
                                    <controls:CoverImage SourcePath="{Binding Cover3}" DecodeWidth="105" Stretch="UniformToFill" />
                                  </UniformGrid>
                                </Panel>
                              </Border>

                              <!-- Title & Track Count -->
                              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} zeneszám'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <!-- Badges & Action Buttons -->
                              <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,8,0,0">
                                <Border Grid.Column="0" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        IsVisible="{Binding FormatBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                  <TextBlock Text="{Binding FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
                                </Border>
                                <Button Grid.Column="2" Classes="icon" Width="30" Height="30" Margin="0,0,4,0" ToolTip.Tip="Lista törlése"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.RequestDeletePlaylistCommand}"
                                        CommandParameter="{Binding}">
                                  <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
                                </Button>
                                <Button Grid.Column="3" Classes="lime"
                                        Width="32" Height="32"
                                        CornerRadius="4"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsEnabled="{Binding TrackCount}"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayPlaylistCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Lista lejátszása">
                                  <material:MaterialIcon Kind="Play" Foreground="Black" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                              </Grid>
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <!-- Subview 2: Playlist Detail View (Tracklist & Controls) -->
              <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding Playlists.IsPlaylistDetailOpen}">
                <!-- Back Button -->
                <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Command="{Binding Playlists.ClosePlaylistDetailCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" />
                    <TextBlock Text="Vissza a lejátszási listákhoz" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Playlist Hero Banner -->
                <Border Grid.Row="1" Classes="glass lime" Margin="0,0,0,20">
                  <Grid ColumnDefinitions="140, *">
                    <!-- Artwork -->
                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
                      <Panel>
                        <material:MaterialIcon Kind="PlaylistMusic" Foreground="{DynamicResource LimeAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>

                    <!-- Meta & Actions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                      <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                              IsVisible="{Binding Playlists.SelectedPlaylist.FormatBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Playlists.SelectedPlaylist.FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding Playlists.SelectedPlaylist.FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
                      </Border>

                      <TextBlock Text="{Binding Playlists.SelectedPlaylist.Name}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Playlists.SelectedPlaylist.TrackCount, StringFormat='{}{0} zeneszám'}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button Classes="lime" Height="38" CornerRadius="6" Padding="18,0"
                                IsEnabled="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                                Command="{Binding Playlists.PlayPlaylistCommand}"
                                CommandParameter="{Binding Playlists.SelectedPlaylist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="Black" />
                            <TextBlock Text="Lejátszás" FontWeight="Bold" Foreground="Black" />
                          </StackPanel>
                        </Button>

                        <Button Classes="secondary" Height="38" CornerRadius="6" Padding="18,0"
                                IsEnabled="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                                Command="{Binding Playlists.ShufflePlaylistCommand}"
                                CommandParameter="{Binding Playlists.SelectedPlaylist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" />
                            <TextBlock Text="Véletlenszerű" FontWeight="Bold" />
                          </StackPanel>
                        </Button>

                        <Button Classes="secondary" Height="38" CornerRadius="6" Padding="14,0"
                                Command="{Binding Playlists.RequestDeletePlaylistCommand}"
                                CommandParameter="{Binding Playlists.SelectedPlaylist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
                            <TextBlock Text="Lista törlése" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Tracklist or Empty State -->
                <Border Grid.Row="2" Classes="glass lime" Padding="0" ClipToBounds="True">
                  <Panel>
                    <!-- Empty Playlist Placeholder -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                                IsVisible="{Binding Playlists.IsSelectedPlaylistEmpty}">
                      <material:MaterialIcon Kind="MusicNotePlus" Width="54" Height="54" Foreground="{DynamicResource LimeAccent}" HorizontalAlignment="Center" />
                      <TextBlock Text="Ez a lejátszási lista még üres" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                      <TextBlock Text="Böngészd a számaidat vagy albumaidat, és a „+” gombbal adj dalokat ehhez a listához."
                                 FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Playlist Tracks DataGrid -->
                    <DataGrid ItemsSource="{Binding Playlists.SelectedPlaylistTracks}"
                              IsVisible="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                      <DataGrid.Columns>
                        <!-- Cover (Clickable to play track) -->
                        <DataGridTemplateColumn Width="50" Header="">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="unstyled-cover"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayTrackCommand}"
                                      CommandParameter="{Binding}">
                                <Border Width="32" Height="32"
                                        CornerRadius="4"
                                        Background="{DynamicResource Surface2}"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                  <Panel>
                                    <material:MaterialIcon Kind="MusicNote"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Width="16" Height="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                    <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                         DecodeWidth="64"
                                                         Stretch="UniformToFill" />
                                  </Panel>
                                </Border>
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Title (Clickable to play track) -->
                        <DataGridTemplateColumn Header="CÍM" Width="2*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="table-link title"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayTrackCommand}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Artist (Clickable to open Artist page) -->
                        <DataGridTemplateColumn Header="ELŐADÓ" Width="1.5*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="table-link artist"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                                      CommandParameter="{Binding Artist}">
                                <TextBlock Text="{Binding Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Album (Clickable to open Album page) -->
                        <DataGridTemplateColumn Header="ALBUM" Width="1.5*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="table-link album"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Audio Format / Quality Badge -->
                        <DataGridTemplateColumn Header="MINŐSÉG" Width="185">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Border Background="{DynamicResource Surface2}"
                                      CornerRadius="4"
                                      Padding="8,3"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding Format.DisplayBadge}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Duration -->
                        <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="90" />

                        <!-- Favorite Heart Button -->
                        <DataGridTemplateColumn Width="44" Header="">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="icon"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip.Tip="Kedvenc">
                                <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                       Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                                       Width="18" Height="18" />
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove from playlist -->
                        <DataGridTemplateColumn Width="44" Header="">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:Track">
                              <Button Classes="icon" ToolTip.Tip="Eltávolítás a listából"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.RemoveTrackFromSelectedCommand}"
                                      CommandParameter="{Binding}">
                                <material:MaterialIcon Kind="PlaylistRemove" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
                              </Button>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </Panel>
                </Border>
              </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 4: FAVORITES (KEDVENCEK)                   -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=4, Converter={StaticResource IntEqualConverter}}"
                  RowDefinitions="Auto, *">
              <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Kedvencek" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                  <TextBlock Text="{Binding Favorites.FavoriteTracks.Count, StringFormat='{}{0} megjelölt kedvenc szám'}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="coral" Height="38" CornerRadius="6" Command="{Binding Favorites.PlayAllCommand}" IsEnabled="{Binding !Favorites.IsEmpty}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                    <TextBlock Text="Kedvencek lejátszása" FontWeight="Bold" />
                  </StackPanel>
                </Button>
              </Grid>

              <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                          IsVisible="{Binding Favorites.IsEmpty}">
                <material:MaterialIcon Kind="HeartOutline" Width="64" Height="64" Foreground="{DynamicResource CoralAccent}" HorizontalAlignment="Center" />
                <TextBlock Text="Még nincsenek kedvenceid" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                <TextBlock Text="A számok melletti szív ikonnal jelölhetsz meg kedvenceket."
                           FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>

              <Border Grid.Row="1" Classes="glass coral" Padding="0" ClipToBounds="True" IsVisible="{Binding !Favorites.IsEmpty}">
                <DataGrid ItemsSource="{Binding Favorites.FavoriteTracks}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                  <DataGrid.Columns>
                    <!-- Cover (Clickable to play track) -->
                    <DataGridTemplateColumn Width="50" Header="">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="unstyled-cover"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Favorites.PlayTrackCommand}"
                                  CommandParameter="{Binding}">
                            <Border Width="32" Height="32"
                                    CornerRadius="4"
                                    Background="{DynamicResource Surface2}"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                              <Panel>
                                <material:MaterialIcon Kind="MusicNote"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Width="16" Height="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                     DecodeWidth="64"
                                                     Stretch="UniformToFill" />
                              </Panel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Title (Clickable to play track) -->
                    <DataGridTemplateColumn Header="CÍM" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="table-link title"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Favorites.PlayTrackCommand}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Artist (Clickable to open Artist page) -->
                    <DataGridTemplateColumn Header="ELŐADÓ" Width="1.5*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="table-link artist"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                                  CommandParameter="{Binding Artist}">
                            <TextBlock Text="{Binding Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Album (Clickable to open Album page) -->
                    <DataGridTemplateColumn Header="ALBUM" Width="1.5*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="table-link album"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Audio Format / Quality Badge -->
                    <DataGridTemplateColumn Header="MINŐSÉG" Width="185">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Border Background="{DynamicResource Surface2}"
                                  CornerRadius="4"
                                  Padding="8,3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Format.DisplayBadge}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="90" />
                    <DataGridTemplateColumn Width="44" Header="">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="icon" ToolTip.Tip="Hozzáadás lejátszási listához"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                                  CommandParameter="{Binding}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                            <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="44">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Track">
                          <Button Classes="icon" ToolTip.Tip="Eltávolítás a kedvencek közül"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Favorites.RemoveFavoriteCommand}"
                                  CommandParameter="{Binding}">
                            <material:MaterialIcon Kind="Heart" Foreground="{DynamicResource CoralAccent}" Width="18" Height="18" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 5: UNIFIED SETTINGS (SERVER & AUDIO)       -->
            <!-- ============================================== -->
            <ScrollViewer IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=5, Converter={StaticResource IntEqualConverter}}"
                          ClipToBounds="False">
              <StackPanel Spacing="24" Margin="4,0,12,24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Beállítások" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                  <TextBlock Text="Szerverkapcsolat, zenei könyvtár és hangkimenet." FontSize="13" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <!-- 2-COLUMN SETTINGS LAYOUT -->
                <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">

                  <!-- COLUMN 1: SERVER & LIBRARY SETTINGS AND DATA CARDS -->
                  <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,12,0">
                    <TextBlock Text="SZERVER ÉS KÖNYVTÁR" Classes="group-title" />

                    <!-- Account -->
                    <Border Classes="glass purple">
                      <Grid ColumnDefinitions="Auto, *, Auto">
                        <material:MaterialIcon Grid.Column="0" Kind="AccountCircle" Width="36" Height="36"
                                               Foreground="{DynamicResource PurpleAccent}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding ServerSettings.IsLoggedIn}">
                          <TextBlock Text="{Binding ServerSettings.CurrentUserName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                          <TextBlock Text="{Binding ServerSettings.CurrentUserRole}"
                                     FontSize="12" Foreground="{DynamicResource LimeAccent}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="secondary" Command="{Binding LogoutCommand}" Height="36" Padding="14,0"
                                IsVisible="{Binding ServerSettings.IsLoggedIn}" ToolTip.Tip="Kijelentkezés a szerverfiókból">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Logout" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
                            <TextBlock Text="Kijelentkezés" FontSize="12" FontWeight="SemiBold" />
                          </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding !ServerSettings.IsLoggedIn}">
                          <TextBlock Text="Nincs bejelentkezve" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                          <TextBlock Text="Jelentkezz be a szerverre a veszteségmentes streameléshez, vagy használj helyi mappát."
                                     FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary" Command="{Binding ShowLoginScreenCommand}" Height="36" Padding="16,0"
                                IsVisible="{Binding !ServerSettings.IsLoggedIn}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Login" Width="16" Height="16" />
                            <TextBlock Text="Bejelentkezés" FontSize="12" FontWeight="Bold" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>

                    <!-- Kapcsolat (Szerver és Helyi zenemappa) -->
                    <Border Classes="glass cyan">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Kapcsolat" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                            <TextBlock Text="{Binding ServerSettings.LibrarySourceText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ServerSettings.ServerStatusBadge}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource CyanAccent}" />
                          </Border>
                        </Grid>

                        <!-- Szerverkapcsolat -->
                        <StackPanel Spacing="8">
                          <TextBlock Text="SZERVER" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                          <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox Grid.Column="0" Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}" Watermark="http://szerver-ip:5200" Margin="0,0,8,0">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.ConnectServerCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding ServerSettings.ConnectServerCommand}" IsEnabled="{Binding !ServerSettings.IsConnecting}"
                                    Height="38" Padding="14,0" HorizontalContentAlignment="Center" Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Server" Width="16" Height="16" />
                                <TextBlock Text="Kapcsolódás" FontWeight="Bold" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="secondary" Command="{Binding ServerSettings.RescanServerCommand}" IsEnabled="{Binding ServerSettings.CanRescanServer}"
                                    Height="38" Padding="12,0" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="A szerver újraolvassa a zenemappát (adminisztrátori jog szükséges).">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                <TextBlock Text="Újraindexelés" FontWeight="SemiBold" />
                              </StackPanel>
                            </Button>
                          </Grid>
                          <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding ServerSettings.IsBusy}" />
                          <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="12" Foreground="{DynamicResource CyanAccent}" TextWrapping="Wrap" IsVisible="{Binding ServerSettings.IsBusy}" />
                        </StackPanel>

                        <!-- Helyi zenemappa -->
                        <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                          <StackPanel Spacing="8">
                            <TextBlock Text="HELYI ZENEMAPPA" Classes="group-title" FontSize="10" Margin="0,0,0,2" />
                            <Grid ColumnDefinitions="*, Auto">
                              <TextBox Grid.Column="0" Text="{Binding ServerSettings.LocalLibraryPath, Mode=TwoWay}" Watermark="/eleresi/ut/zenek" Margin="0,0,8,0" />
                              <Button Grid.Column="1" Classes="secondary" Command="{Binding ServerSettings.StartScanFolderCommand}" IsEnabled="{Binding !ServerSettings.IsScanning}" Height="38" Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <material:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" />
                                  <TextBlock Text="Beolvasás" />
                                </StackPanel>
                              </Button>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ServerSettings.ScanProgress}" Height="4" CornerRadius="2"
                                         Foreground="{DynamicResource LimeAccent}" IsVisible="{Binding ServerSettings.IsScanning}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- COLUMN 2: AUDIO SETTINGS -->
                  <StackPanel Grid.Column="1" Spacing="16" Margin="12,0,0,0">
                    <TextBlock Text="HANGKIMENET ÉS AUDIOFIL BEÁLLÍTÁSOK" Classes="group-title" />

                    <!-- Exclusive & Bit-Perfect Modes -->
                    <Grid ColumnDefinitions="*, *">
                      <Border Grid.Column="0" Classes="metric-card cyan" Margin="0,0,6,0">
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                          <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="Kizárólagos" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LimeAccent}" />
                              <TextBlock Text="Közvetlen ALSA / PipeWire hozzáférés" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AudiophileSettings.IsExclusiveMode, Mode=TwoWay}"
                                          IsEnabled="{Binding AudiophileSettings.IsExclusiveAvailable}" />
                          </Grid>
                          <TextBlock Text="Ezen a rendszeren nem érhető el: a lejátszás megosztott keverőn történik."
                                     IsVisible="{Binding !AudiophileSettings.IsExclusiveAvailable}"
                                     FontSize="10" Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Classes="metric-card purple" Margin="6,0,0,0">
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                          <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="Bit-Perfect" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
                              <TextBlock Text="1:1 bitpontos átvitel (0 dB)" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AudiophileSettings.IsBitperfect, Mode=TwoWay}"
                                          IsEnabled="{Binding AudiophileSettings.IsBitperfectAvailable}" />
                          </Grid>
                          <TextBlock Text="Bekapcsolásakor a kizárólagos mód is aktív."
                                     FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Kimeneti eszköz -->
                    <Border Classes="glass cyan">
                      <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*, Auto">
                          <TextBlock Grid.Column="0" Text="Kimeneti eszköz" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="secondary" Command="{Binding AudiophileSettings.RefreshDevicesCommand}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                              <TextBlock Text="Frissítés" />
                            </StackPanel>
                          </Button>
                        </Grid>

                        <ComboBox ItemsSource="{Binding AudiophileSettings.AvailableDevices}"
                                  SelectedItem="{Binding AudiophileSettings.SelectedDevice}"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:AudioOutputDevice">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <material:MaterialIcon Kind="Speakers" Width="16" Height="16" Foreground="{DynamicResource CyanAccent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DriverType, StringFormat='[{0}]'}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding AudiophileSettings.HardwareStatusText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <!-- Jelút -->
                    <Border Classes="glass lime">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Jelút" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                        <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="16">
                          <TextBlock Text="{Binding AudiophileSettings.SignalPath}"
                                     FontFamily="Consolas, JetBrains Mono, Courier New, monospace"
                                     FontSize="12" Foreground="{DynamicResource LimeAccent}" LineHeight="20" TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>

            </Panel>

            <!-- ============================================== -->
            <!-- TIDAL-STYLE UNIFIED SEARCH RESULTS VIEW        -->
            <!-- ============================================== -->
            <Grid IsVisible="{Binding IsSearchActive}" RowDefinitions="Auto, *">
              
              <!-- Search Results Header -->
              <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Keresési találatok:" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
                    <TextBlock Text="{Binding Search.Query, StringFormat='„{0}”'}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource CyanAccent}" />
                  </StackPanel>
                  <TextBlock Text="Számok, albumok és előadók egy helyen" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <Button Grid.Column="1" Classes="secondary" Height="36" Padding="14,0" Command="{Binding ClearSearchCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="Close" Width="16" Height="16" />
                    <TextBlock Text="Bezárás" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Search Results Content (Scrollable) -->
              <ScrollViewer Grid.Row="1" Padding="0,6,0,0" ClipToBounds="False">
                <StackPanel Spacing="28">

                  <!-- Empty State when no results found -->
                  <Border Classes="glass" Padding="40" HorizontalAlignment="Center" Margin="0,40,0,0" IsVisible="{Binding !Search.HasResults}">
                    <StackPanel HorizontalAlignment="Center" Spacing="14">
                      <material:MaterialIcon Kind="MagnifyClose" Width="56" Height="56" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                      <TextBlock Text="Nincs találat a keresésre" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                      <TextBlock Text="Próbálj meg más előadóra, számcímre vagy albumra keresni." FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- SECTION: BEST MATCH (LEGJOBB TALÁLAT) + TOP TRACKS (TIDAL LAYOUT) -->
                  <Grid ColumnDefinitions="340, *" Margin="0,0,0,8" IsVisible="{Binding Search.BestMatch, Converter={x:Static ObjectConverters.IsNotNull}}">
                    
                    <!-- Left: Hero Best Match Card -->
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,24,0">
                      <TextBlock Text="LEGJOBB TALÁLAT" Classes="group-title" Margin="0,0,0,4" />
                      <Border Classes="glass" Padding="20" CornerRadius="8">
                        <StackPanel Spacing="14">
                          <Border Width="110" Height="110" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
                            <Panel>
                              <Image Source="{Binding Search.BestMatch.CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding Search.BestMatch.HasCover}" />
                              <material:MaterialIcon Kind="{Binding Search.BestMatch.IconKind}" Foreground="{DynamicResource CyanAccent}" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Search.BestMatch.HasCover}" />
                            </Panel>
                          </Border>

                          <StackPanel Spacing="4">
                            <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Search.BestMatch.TypeLabel}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CyanAccent}" />
                            </Border>
                            <TextBlock Text="{Binding Search.BestMatch.Title}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Search.BestMatch.Subtitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Search.BestMatch.Meta}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <!-- Square Play Button: 36x36 -->
                            <Button Classes="primary" Width="36" Height="36" CornerRadius="4" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding Search.BestMatch.PlayCommand}" ToolTip.Tip="Lejátszás">
                              <material:MaterialIcon Kind="Play" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="secondary" Height="36" Padding="14,0"
                                    Command="{Binding Search.BestMatch.OpenCommand}" ToolTip.Tip="Megnyitás">
                              <TextBlock Text="Megnyitás" FontWeight="SemiBold" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Right: Matching Tracks (Top Tracks) -->
                    <StackPanel Grid.Column="1" Spacing="10" IsVisible="{Binding Search.HasTracks}">
                      <TextBlock Text="SZÁMOK" Classes="group-title" Margin="0,0,0,4" />
                      <Border Classes="glass cyan" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Search.MatchingTracks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="360"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Disabled">
                          <DataGrid.Columns>
                            <!-- Cover (Clickable to play track) -->
                            <DataGridTemplateColumn Width="50" Header="">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="unstyled-cover"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.PlayTrackCommand}"
                                          CommandParameter="{Binding}">
                                    <Border Width="32" Height="32"
                                            CornerRadius="4"
                                            Background="{DynamicResource Surface2}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                      <Panel>
                                        <material:MaterialIcon Kind="MusicNote"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                        <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                             DecodeWidth="64"
                                                             Stretch="UniformToFill" />
                                      </Panel>
                                    </Border>
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title (Clickable to play track) -->
                            <DataGridTemplateColumn Header="CÍM" Width="2.5*">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="table-link title"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.PlayTrackCommand}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ELŐADÓ" Width="2*">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="table-link artist"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                                          CommandParameter="{Binding Artist}">
                                    <TextBlock Text="{Binding Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ALBUM" Width="2*">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Track">
                                  <Button Classes="table-link album"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="HOSSZ" Binding="{Binding FormattedDuration}" Width="85" />
                      <DataGridTemplateColumn Width="44" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate DataType="models:Track">
                            <Button Classes="icon" ToolTip.Tip="Hozzáadás lejátszási listához"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                              <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- SECTION: MATCHING ARTISTS -->
                  <StackPanel Spacing="12" IsVisible="{Binding Search.HasArtists}">
                    <TextBlock Text="ELŐADÓK" Classes="group-title" Margin="4,0,0,0" />
                    <ItemsControl ItemsSource="{Binding Search.MatchingArtists}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:Artist">
                          <Button Classes="unstyled-card"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenArtistCommand}"
                                  CommandParameter="{Binding}"
                                  Margin="0,6,18,12">
                            <Border Classes="metric-card coral" Width="180" Height="200">
                              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Surface2}" HorizontalAlignment="Center" ClipToBounds="True">
                                  <Panel>
                                    <material:MaterialIcon Kind="AccountMusic" Foreground="{DynamicResource CoralAccent}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <controls:CoverImage SourcePath="{Binding PicturePath}" DecodeWidth="130" Stretch="UniformToFill" />
                                  </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} zeneszám'}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                                <!-- Square Play Button: 32x32 -->
                                <Button Classes="coral"
                                        HorizontalAlignment="Center"
                                        Width="32" Height="32"
                                        CornerRadius="4"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Összes lejátszása">
                                  <material:MaterialIcon Kind="Play" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- SECTION: MATCHING ALBUMS -->
                  <StackPanel Spacing="12" IsVisible="{Binding Search.HasAlbums}">
                    <TextBlock Text="ALBUMOK" Classes="group-title" Margin="4,0,0,0" />
                    <ItemsControl ItemsSource="{Binding Search.MatchingAlbums}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AlbumCardViewModel">
                          <Button Classes="unstyled-card"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenAlbumCommand}"
                                  CommandParameter="{Binding}"
                                  Margin="0,6,18,12">
                            <Border Classes="metric-card purple" Width="180" Height="240" services:ViewportLoad.Target="{Binding}">
                              <Grid RowDefinitions="130, *, Auto">
                                <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                                  <Panel>
                                    <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                  </Panel>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                                  <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                  <TextBlock Grid.Column="0" Text="{Binding Year, StringFormat='{}{0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                  <!-- Square Play Button: 32x32 -->
                                  <Button Grid.Column="1" Classes="purple"
                                          Width="32" Height="32"
                                          CornerRadius="4"
                                          Padding="0"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumCommand}"
                                          CommandParameter="{Binding Album}"
                                          ToolTip.Tip="Album lejátszása">
                                    <material:MaterialIcon Kind="Play" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Button>
                                </Grid>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </Grid>

          </Panel>
        </Border>
      </Grid>

      <!-- ============================================== -->
      <!-- PLAYBACK QUEUE DRAWER (Docked Left, Flush)     -->
      <!-- ============================================== -->
      <Panel IsVisible="{Binding Player.IsQueueOpen}">
        <!-- Subtle Dimming Backdrop to dismiss on outside click -->
        <Button Classes="unstyled-card"
                Command="{Binding Player.CloseQueueCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ToolTip.Tip="Kattints a bezáráshoz" />

        <!-- Drawer Panel: Docked to Left Edge, Flush Top (Header) & Bottom (Player) -->
        <Border Width="420"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Classes="queue-docked-panel"
                Padding="16,14">
          <Grid RowDefinitions="Auto, Auto, *">
            <!-- Drawer Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,2,0,12">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <material:MaterialIcon Kind="PlaylistPlay" Width="20" Height="20" Foreground="{DynamicResource PrimaryAction}" VerticalAlignment="Center" />
                <TextBlock Text="LEJÁTSZÁSI SOR" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" LetterSpacing="1.2" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <TextBlock Text="{Binding Player.QueueTracks.Count, StringFormat='{}{0} szám'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAction}" />
              </Border>
              <Button Grid.Column="2" Classes="icon" Command="{Binding Player.ClearQueueCommand}" ToolTip.Tip="Sor kiürítése" Width="28" Height="28" Margin="0,0,4,0" IsVisible="{Binding Player.QueueTracks.Count}">
                <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
              </Button>
              <Button Grid.Column="3" Classes="icon" Command="{Binding Player.CloseQueueCommand}" ToolTip.Tip="Lejátszási sor elrejtése" Width="28" Height="28">
                <material:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource TextMuted}" />
              </Button>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,0,0,10" />

            <!-- Empty Queue Placeholder -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="0,30"
                        IsVisible="{Binding !Player.QueueTracks.Count}">
              <material:MaterialIcon Kind="MusicNoteOffOutline" Width="48" Height="48" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" />
              <TextBlock Text="A lejátszási sor jelenleg üres" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
              <TextBlock Text="Indíts el egy albumot vagy számot a lejátszáshoz." FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
            </StackPanel>

            <!-- Queue Track Items with Drag-and-Drop Reorder -->
            <ScrollViewer Grid.Row="2" IsVisible="{Binding Player.QueueTracks.Count}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Player.QueueItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:QueueItemViewModel">
                    <Border Classes="queue-item"
                            Classes.current-track="{Binding IsCurrent}"
                            Classes.drop-target="{Binding IsDropTarget}"
                            Tag="{Binding}"
                            PointerPressed="QueueItem_PointerPressed"
                            PointerMoved="QueueItem_PointerMoved"
                            PointerReleased="QueueItem_PointerReleased"
                            PointerCaptureLost="QueueItem_PointerCaptureLost"
                            Padding="8,6"
                            Margin="0,0,0,4">
                      <Grid ColumnDefinitions="14, 38, *, Auto, Auto, Auto, Auto">
                        <!-- Drag Handle Icon -->
                        <material:MaterialIcon Grid.Column="0" Kind="DragVertical" Width="14" Height="14"
                                               Foreground="{DynamicResource TextDisabled}"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="Húzd a sorrend módosításához" />

                        <!-- Cover Artwork Thumbnail (like album cards & playlist view) -->
                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="4" Background="{DynamicResource Surface2}" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                          <Panel>
                            <material:MaterialIcon Kind="MusicNote" Foreground="{DynamicResource TextMuted}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <controls:CoverImage SourcePath="{Binding Track.CoverArtPath}" DecodeWidth="68" Stretch="UniformToFill" />

                            <!-- Currently Playing Volume Overlay -->
                            <Border Background="#A0000000" IsVisible="{Binding IsCurrent}">
                              <material:MaterialIcon Kind="VolumeHigh" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryAction}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                            </Border>

                            <!-- Track Number Badge (when not playing) -->
                            <Border Background="#80000000" CornerRadius="0,0,3,0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="2,0" IsVisible="{Binding !IsCurrent}">
                              <TextBlock Text="{Binding DisplayIndex}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                            </Border>
                          </Panel>
                        </Border>

                        <!-- Track Title & Artist -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Track.Title}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Track.Artist}" FontSize="10"
                                     Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Audio Format Badge -->
                        <Border Grid.Column="3" Background="{DynamicResource Surface2}" CornerRadius="3" Padding="4,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                IsVisible="{Binding Track.Format.DisplayBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding Track.Format.DisplayBadge}" FontSize="8" FontWeight="Bold"
                                     Foreground="{Binding Track.Format.DisplayBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
                        </Border>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{Binding Track.FormattedDuration}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />

                        <!-- Up / Down Quick Reorder Buttons -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                          <Button Classes="icon action-btn" Width="20" Height="20"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.MoveQueueTrackUpCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Mozgatás feljebb">
                            <material:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                          </Button>
                          <Button Classes="icon action-btn" Width="20" Height="20"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.MoveQueueTrackDownCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Mozgatás lejjebb">
                            <material:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                          </Button>
                        </StackPanel>

                        <!-- Remove Track from Queue Button -->
                        <Button Grid.Column="6" Classes="icon remove-btn"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.RemoveQueueTrackCommand}"
                                CommandParameter="{Binding Track}"
                                Width="22" Height="22"
                                ToolTip.Tip="Eltávolítás a sorból"
                                VerticalAlignment="Center">
                          <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Panel>
    </Grid>

      <!-- ========================================== -->
      <!-- BOTTOM STICKY NOW-PLAYING BAR              -->
      <!-- ========================================== -->
      <Border Grid.Row="3"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0"
              Padding="16,0">
        <Grid ColumnDefinitions="*, Auto, *">

          <!-- Left: Track Details & Album Art -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="14">
            <Button Classes="unstyled-card cover-queue-btn"
                    Command="{Binding Player.ToggleQueueCommand}"
                    ToolTip.Tip="Lejátszási sor (kattints a megnyitáshoz / elrejtéshez)"
                    Cursor="Hand">
              <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" ClipToBounds="True">
                <Panel>
                  <Image Source="{Binding Player.CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <material:MaterialIcon Kind="MusicNote" Foreground="{DynamicResource CyanAccent}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                  <!-- Hover / Open Indicator Overlay with 180° Rotating Chevron -->
                  <Border Classes="cover-queue-overlay"
                          Classes.open="{Binding Player.IsQueueOpen}"
                          Background="#80000000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <material:MaterialIcon Kind="ChevronUp"
                                           Classes="queue-chevron"
                                           Classes.open="{Binding Player.IsQueueOpen}"
                                           Width="22" Height="22"
                                           Foreground="{DynamicResource PrimaryAction}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                  </Border>
                </Panel>
              </Border>
            </Button>

            <StackPanel VerticalAlignment="Center" Spacing="2" Width="170">
              <TextBlock Text="{Binding Player.CurrentTrack.Title, FallbackValue='Nincs lejátszás'}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}"
                         ToolTip.Tip="{Binding Player.CurrentTrack.Title, FallbackValue=''}" />
              <TextBlock Text="{Binding Player.CurrentTrack.Artist, FallbackValue='Válassz zeneszámot'}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !Player.HasError}" />
              <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="11" Foreground="{DynamicResource DangerColor}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Player.HasError}" ToolTip.Tip="{Binding Player.ErrorMessage}" />
            </StackPanel>

            <Button Classes="icon" Command="{Binding Player.ToggleFavoriteCurrentCommand}" VerticalAlignment="Center" ToolTip.Tip="Kedvenc"
                    IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
              <material:MaterialIcon Kind="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False, Converter={StaticResource FavoriteIconConverter}}"
                                     Foreground="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False, Converter={StaticResource FavoriteColorConverter}}"
                                     Width="18" Height="18" />
            </Button>
          </StackPanel>

          <!-- Center: Controls & Seek Slider -->
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="520" VerticalAlignment="Center" Spacing="10" Margin="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
              <Button Classes="icon" Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="Véletlenszerű lejátszás">
                <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{Binding Player.IsShuffle, Converter={StaticResource ActiveControlBrushConverter}}" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.PreviousTrackCommand}" ToolTip.Tip="Előző szám">
                <material:MaterialIcon Kind="SkipPrevious" Width="22" Height="22" />
              </Button>
              <Button Command="{Binding Player.TogglePlayPauseCommand}"
                      Classes="primary"
                      Width="38" Height="38" MinWidth="38" MinHeight="38"
                      CornerRadius="6" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="Lejátszás / Szünet">
                <material:MaterialIcon Kind="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToIconConverter}}" Width="20" Height="20" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.NextTrackCommand}" ToolTip.Tip="Következő szám">
                <material:MaterialIcon Kind="SkipNext" Width="22" Height="22" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.ToggleRepeatCommand}" ToolTip.Tip="Ismétlés: Ki / Összes / Egy szám">
                <material:MaterialIcon Kind="{Binding Player.RepeatMode, Converter={StaticResource RepeatModeToIconConverter}}" Width="18" Height="18"
                                       Foreground="{Binding Player.RepeatMode, Converter={StaticResource ActiveControlBrushConverter}}" />
              </Button>
            </StackPanel>

            <Grid ColumnDefinitions="45, *, 45" Height="28" VerticalAlignment="Center" Margin="0" ClipToBounds="False">
              <TextBlock Grid.Column="0" Text="{Binding Player.FormattedPosition}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
              <Slider Grid.Column="1"
                      Classes="seek-slider"
                      Minimum="0"
                      Maximum="{Binding Player.DurationSeconds}"
                      Value="{Binding Player.PositionSeconds, Mode=TwoWay}"
                      IsEnabled="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Margin="4,0"
                      VerticalAlignment="Center"
                      ClipToBounds="False" />
              <TextBlock Grid.Column="2" Text="{Binding Player.FormattedDuration}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>

          <!-- Right: Visualizer, Quality, Volume -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
            <controls:FxVisualizerControl Width="130" Height="36"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          IsVisible="{Binding !IsCompactLayout}"
                                          Bands="{Binding Player.SpectrumBands}"
                                          AccentBrush="{DynamicResource PrimaryAction}"
                                          IsPlaying="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                                          BarsPerBand="1"
                                          ToolTip.Tip="32 sávos valós idejű spektrumanalizátor" />

            <Panel IsVisible="{Binding !IsCompactLayout}" VerticalAlignment="Center">
              <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center"
                      IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{Binding Player.QualityBadge}">
                <TextBlock Text="{Binding Player.QualityShortBadge}" FontSize="10" FontWeight="Bold"
                           Foreground="{Binding Player.QualityShortBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
              </Border>
            </Panel>

            <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}" Width="28" Height="28" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Player.VolumeToolTip}">
              <Panel>
                <!-- Active normal playback: primary action color -->
                <material:MaterialIcon Kind="VolumeHigh" Width="18" Height="18"
                                       Foreground="{DynamicResource PrimaryAction}"
                                       IsVisible="{Binding Player.IsVolumeActive}" />
                <!-- Bit-perfect / volume locked: speaker icon in grey (not muted) -->
                <material:MaterialIcon Kind="VolumeHigh" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding Player.IsVolumeLockedAndNotMuted}" />
                <!-- Actually muted: muted speaker icon -->
                <material:MaterialIcon Kind="VolumeOff" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding Player.IsMuted}" />
              </Panel>
            </Button>

            <Slider Classes="seek-slider"
                    Classes.volume-muted="{Binding Player.IsMuted}"
                    Width="75"
                    Minimum="0" Maximum="100"
                    Value="{Binding Player.Volume, Mode=TwoWay}"
                    IsEnabled="{Binding !Player.IsVolumeLocked}"
                    VerticalAlignment="Center"
                    ClipToBounds="False" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- BOTTOM FOOTER STATUS BAR                   -->
      <!-- ========================================== -->
      <Border Grid.Row="4"
              Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0"
              Padding="24,0">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Classes="status-pulse" Width="6" Height="6" Fill="{DynamicResource SuccessColor}" VerticalAlignment="Center" IsVisible="{Binding !Player.HasError}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !Player.HasError}" />
            <material:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" IsVisible="{Binding Player.HasError}" />
            <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Player.HasError}" />
            <Button Classes="icon" Width="22" Height="22" Padding="0" Command="{Binding Player.DismissErrorCommand}" IsVisible="{Binding Player.HasError}" ToolTip.Tip="Hibaüzenet elrejtése">
              <material:MaterialIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="1" Text="{Binding RightFooterStatusText}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
        </Grid>
      </Border>

    </Grid>

    <!-- ============================================== -->
    <!-- STARTUP / LOGIN & SERVER CONNECTION VIEW       -->
    <!-- ============================================== -->
    <Grid IsVisible="{Binding IsLoginViewActive}"
          Background="{DynamicResource WindowGradient}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Classes="glass purple"
                Width="500"
                MaxWidth="{Binding $parent[ScrollViewer].Bounds.Width}"
                CornerRadius="16"
                Padding="32,28"
                Margin="16,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8" Margin="24,0,0,0">
                <material:MaterialIcon Kind="Waveform" Foreground="{DynamicResource LimeAccent}" Width="52" Height="52" HorizontalAlignment="Center" />
                <TextBlock Text="WIRETUNE" FontSize="26" FontWeight="Black" LetterSpacing="3.0" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="10,4" HorizontalAlignment="Center">
                  <TextBlock Text="LOSSLESS STREAMER &amp; PLAYER" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource CyanAccent}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="icon" Command="{Binding ContinueOfflineCommand}" VerticalAlignment="Top" ToolTip.Tip="Bezárás / vissza a lejátszóhoz">
                <material:MaterialIcon Kind="Close" Width="20" Height="20" />
              </Button>
            </Grid>

            <!-- Logged in -->
            <StackPanel Spacing="16" IsVisible="{Binding ServerSettings.IsLoggedIn}">
              <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <material:MaterialIcon Kind="AccountCheck" Width="40" Height="40" Foreground="{DynamicResource LimeAccent}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding ServerSettings.CurrentUserName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                      <TextBlock Text="{Binding ServerSettings.CurrentUserRole}" FontSize="12" Foreground="{DynamicResource LimeAccent}" FontWeight="SemiBold" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0" Classes="secondary" Command="{Binding LogoutCommand}" Height="42" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="Logout" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
                    <TextBlock Text="Kijelentkezés" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="primary" Command="{Binding ContinueOfflineCommand}" Height="42" Margin="6,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="MusicBox" Width="18" Height="18" />
                    <TextBlock Text="Vissza a zenékhez" FontWeight="Bold" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <!-- Not logged in -->
            <StackPanel Spacing="16" IsVisible="{Binding !ServerSettings.IsLoggedIn}">
              <StackPanel Spacing="6">
                <TextBlock Text="SZERVER CÍME" Classes="group-title" Margin="2,0,0,0" />
                <Grid ColumnDefinitions="*, Auto">
                  <TextBox Grid.Column="0" Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}" Watermark="http://192.168.1.10:5200" Height="40" Margin="0,0,8,0">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.ConnectServerCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Classes="secondary" Command="{Binding ServerSettings.ConnectServerCommand}" IsEnabled="{Binding !ServerSettings.IsConnecting}"
                          Height="40" Padding="14,0" ToolTip.Tip="Kapcsolat ellenőrzése">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <material:MaterialIcon Kind="ServerNetwork" Width="16" Height="16" Foreground="{DynamicResource CyanAccent}" />
                      <TextBlock Text="Csatlakozás" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                  </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding ServerSettings.IsBusy}" />
                <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>

              <Border Background="#20FFB703" BorderBrush="#FFB703" BorderThickness="1" CornerRadius="8" Padding="12,10"
                      IsVisible="{Binding ServerSettings.IsServerOffline}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="ServerOff" Width="18" Height="18" Foreground="#FFB703" VerticalAlignment="Top" />
                  <TextBlock Text="A szerver nem érhető el. Ellenőrizd a címet és hogy a Wiretune.Server fut-e. Helyi zenék szerver nélkül is lejátszhatók."
                             FontSize="12" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" MaxWidth="380" />
                </StackPanel>
              </Border>

              <!-- First-run administrator setup -->
              <StackPanel Spacing="12" IsVisible="{Binding ServerSettings.IsSetupRequired}">
                <Border Background="#28FFB703" BorderBrush="#FFB703" BorderThickness="1" CornerRadius="8" Padding="14,10">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="ShieldAlertOutline" Width="18" Height="18" Foreground="#FFB703" VerticalAlignment="Center" />
                      <TextBlock Text="Első indítás" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Hozd létre a szerver adminisztrátori fiókját. Később ezzel adhatsz hozzá további felhasználókat." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}" Watermark="Admin felhasználónév" Height="40" />
                <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}" Watermark="{Binding ServerSettings.PasswordHint}" PasswordChar="•" Height="40">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.SetupAdminCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <TextBox Text="{Binding ServerSettings.DisplayName, Mode=TwoWay}" Watermark="Megjelenített név (opcionális)" Height="40" />

                <Button Classes="primary" Command="{Binding ServerSettings.SetupAdminCommand}" IsEnabled="{Binding !ServerSettings.IsAuthenticating}"
                        Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ShieldAccount" Width="18" Height="18" />
                    <TextBlock Text="Admin fiók létrehozása és belépés" FontWeight="Bold" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Sign in -->
              <StackPanel Spacing="12" IsVisible="{Binding !ServerSettings.IsSetupRequired}">
                <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}" Watermark="Felhasználónév" Height="40" />
                <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}" Watermark="Jelszó" PasswordChar="•" Height="40">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.LoginCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <CheckBox IsChecked="{Binding ServerSettings.StayLoggedIn, Mode=TwoWay}"
                          Content="Maradjak bejelentkezve ezen az eszközön"
                          FontSize="12"
                          Foreground="{DynamicResource TextMain}" />

                <Button Classes="primary" Command="{Binding ServerSettings.LoginCommand}" IsEnabled="{Binding !ServerSettings.IsAuthenticating}"
                        Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="Login" Width="18" Height="18" />
                    <TextBlock Text="Bejelentkezés" FontWeight="Bold" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Border Background="#28FF003C" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                      IsVisible="{Binding ServerSettings.HasAuthError}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerColor}" Width="16" Height="16" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding ServerSettings.AuthErrorMessage}" Foreground="{DynamicResource DangerColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="380" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*, Auto, *" Margin="0,4">
                <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource GlassBorder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="VAGY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="12,0" VerticalAlignment="Center" />
                <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource GlassBorder}" VerticalAlignment="Center" />
              </Grid>

              <Button Classes="secondary" Command="{Binding ContinueOfflineCommand}" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="FolderMusicOutline" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" />
                  <TextBlock Text="Folytatás szerver nélkül (helyi zenék)" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <!-- ============================================== -->
    <!-- PLAYLIST DIALOGS                               -->
    <!-- ============================================== -->
    <Panel IsVisible="{Binding Playlists.IsAnyDialogOpen}" Background="#A6000000">

      <!-- New playlist -->
      <Border Classes="dialog-card" Width="420" IsVisible="{Binding Playlists.IsCreateDialogOpen}">
        <StackPanel Spacing="16">
          <TextBlock Text="Új lejátszási lista" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{Binding Playlists.TrackToAdd.Title, StringFormat='A(z) „{0}” szám is bekerül az új listába.'}"
                     IsVisible="{Binding Playlists.TrackToAdd, Converter={x:Static ObjectConverters.IsNotNull}}"
                     FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Playlists.NewPlaylistName, Mode=TwoWay}" Watermark="Lista neve">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding Playlists.CreatePlaylistCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding Playlists.CloseCreateDialogCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CloseCreateDialogCommand}">
              <TextBlock Text="Mégse" FontWeight="SemiBold" />
            </Button>
            <Button Classes="lime" Height="36" Padding="16,0" Command="{Binding Playlists.CreatePlaylistCommand}">
              <TextBlock Text="Létrehozás" FontWeight="Bold" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Add track to playlist -->
      <Border Classes="dialog-card" Width="420" IsVisible="{Binding Playlists.IsAddToPlaylistDialogOpen}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Hozzáadás lejátszási listához" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
            <TextBlock Text="{Binding Playlists.TrackToAdd.Title, FallbackValue=''}" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Text="Még nincs lejátszási listád – hozz létre egyet." IsVisible="{Binding !Playlists.HasPlaylists}"
                     FontSize="12" Foreground="{DynamicResource TextMuted}" />
          <ScrollViewer MaxHeight="300">
            <ItemsControl ItemsSource="{Binding Playlists.Playlists}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:Playlist">
                  <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" Margin="0,0,0,6"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.AddPendingTrackToCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TrackCount, StringFormat='({0})'}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CancelAddTrackCommand}">
              <TextBlock Text="Mégse" FontWeight="SemiBold" />
            </Button>
            <Button Classes="lime" Height="36" Padding="16,0" Command="{Binding Playlists.CreatePlaylistForPendingTrackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="Új lista" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Delete confirmation -->
      <Border Classes="dialog-card" Width="400" IsVisible="{Binding Playlists.IsDeleteConfirmOpen}">
        <StackPanel Spacing="16">
          <TextBlock Text="Lista törlése" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{Binding Playlists.PlaylistPendingDelete.Name, StringFormat='Biztosan törlöd a(z) „{0}” listát? A számok a könyvtárban maradnak.', FallbackValue=''}"
                     FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CancelDeletePlaylistCommand}">
              <TextBlock Text="Mégse" FontWeight="SemiBold" />
            </Button>
            <Button Classes="coral" Height="36" Padding="16,0" Command="{Binding Playlists.ConfirmDeletePlaylistCommand}">
              <TextBlock Text="Törlés" FontWeight="Bold" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

  </Panel>
</UserControl>

