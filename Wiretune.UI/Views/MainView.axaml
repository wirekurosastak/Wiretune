<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:views="using:Wiretune.UI.Views"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:services="using:Wiretune.UI.Services"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="RootControl">

  <Panel Background="{DynamicResource WindowGradient}">
    <Grid RowDefinitions="70, Auto, *, 96, 30"
          IsVisible="{Binding !IsLoginViewActive}">

      <!-- ========================================== -->
      <!-- TOP HEADER BAR                             -->
      <!-- ========================================== -->
      <Border Grid.Row="0"
              x:Name="HeaderBar"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,0,0,1"
              Padding="24,0"
              PointerPressed="HeaderBar_PointerPressed">
        <Grid ColumnDefinitions="*, Auto, *">

          <!-- Brand Logo and App Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16" Margin="0,0,16,0">
            <controls:NavVisualizerControl Width="38" Height="28"
                                           VerticalAlignment="Center"
                                           WaveTrigger="{Binding WaveTrigger}"
                                           WaveDirection="{Binding LastWaveDirection}"
                                           AccentBrush="{DynamicResource PrimaryAction}"
                                           IsPlaying="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                                           ToolTip.Tip="Wiretune Streamer Visualizer" />
            <StackPanel VerticalAlignment="Center" Spacing="0" IsVisible="{Binding !IsCompactLayout}">
              <TextBlock Text="WIRETUNE" FontSize="18" FontWeight="Black" LetterSpacing="2.0" Foreground="{DynamicResource TextMain}" />
              <TextBlock Text="STREAMER &amp; PLAYER" FontSize="9" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource PrimaryAction}">
                <TextBlock.Transitions>
                  <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.35" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
            </StackPanel>
          </StackPanel>

          <!-- Search Bar -->
          <TextBox Grid.Column="1"
                   Classes="search-pill"
                   HorizontalAlignment="Center"
                   Width="380"
                   MaxWidth="440"
                   Height="38"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   Watermark="{loc:T SearchPlaceholder}">
            <TextBox.InnerLeftContent>
              <material:MaterialIcon Kind="Magnify"
                                     Width="18" Height="18"
                                     Foreground="{DynamicResource TextMuted}"
                                     Margin="14,0,8,0"
                                     VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="icon"
                      Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding IsSearchActive}"
                      Width="28" Height="28"
                      Margin="0,0,8,0"
                      ToolTip.Tip="{loc:T TipClearSearch}">
                <material:MaterialIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <!-- Top Right Audiophile Badges & Controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10" Margin="16,0,0,0">
            <!-- Bitperfect Active Pill -->
            <Button Command="{Binding Player.ToggleBitperfectCommand}"
                    IsVisible="{Binding !IsCompactLayout}"
                    Classes="secondary audiophile-pill"
                    Classes.active-bp="{Binding Player.IsBitperfect}"
                    ToolTip.Tip="{loc:T TipBitPerfect}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Panel Width="7" Height="7" VerticalAlignment="Center">
                  <Ellipse Classes="status-pulse" Width="7" Height="7"
                           Fill="{DynamicResource PurpleAccent}"
                           IsVisible="{Binding Player.IsBitperfect}" />
                </Panel>
                <TextBlock Text="BIT-PERFECT" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource PurpleAccent}"
                           IsVisible="{Binding Player.IsBitperfect}"
                           VerticalAlignment="Center" />
                <TextBlock Text="BIT-PERFECT" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           IsVisible="{Binding !Player.IsBitperfect}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Exclusive Mode Active Pill -->
            <Button Command="{Binding Player.ToggleExclusiveModeCommand}"
                    IsVisible="{Binding !IsCompactLayout}"
                    Classes="secondary audiophile-pill"
                    Classes.active-exc="{Binding Player.IsExclusiveMode}"
                    ToolTip.Tip="{loc:T TipExclusive}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Panel Width="7" Height="7" VerticalAlignment="Center">
                  <Ellipse Classes="status-pulse" Width="7" Height="7"
                           Fill="{DynamicResource LimeAccent}"
                           IsVisible="{Binding Player.IsExclusiveMode}" />
                </Panel>
                <TextBlock Text="EXCLUSIVE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource LimeAccent}"
                           IsVisible="{Binding Player.IsExclusiveMode}"
                           VerticalAlignment="Center" />
                <TextBlock Text="EXCLUSIVE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           IsVisible="{Binding !Player.IsExclusiveMode}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- User / Login Pill -->
            <Button Command="{Binding ShowLoginScreenCommand}"
                    Classes="secondary audiophile-pill"
                    ToolTip.Tip="{loc:T TipAccount}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <material:MaterialIcon Kind="AccountCircleOutline" Width="16" Height="16"
                                       Foreground="{DynamicResource CyanAccent}"
                                       IsVisible="{Binding IsUserLoggedIn}" />
                <material:MaterialIcon Kind="KeyOutline" Width="16" Height="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !IsUserLoggedIn}" />
                <TextBlock Text="{Binding CurrentUserBadge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Language picker -->
            <Button Classes="secondary audiophile-pill" ToolTip.Tip="{loc:T TipLanguage}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <material:MaterialIcon Kind="Translate" Width="16" Height="16" Foreground="{DynamicResource CyanAccent}" />
                <TextBlock Text="{Binding LanguageBadge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Magyar" Command="{Binding ChangeLanguageCommand}" CommandParameter="hu">
                    <MenuItem.Icon><material:MaterialIcon Kind="Check" IsVisible="{Binding LanguageOptions[0].IsSelected}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en">
                    <MenuItem.Icon><material:MaterialIcon Kind="Check" IsVisible="{Binding LanguageOptions[1].IsSelected}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Deutsch" Command="{Binding ChangeLanguageCommand}" CommandParameter="de">
                    <MenuItem.Icon><material:MaterialIcon Kind="Check" IsVisible="{Binding LanguageOptions[2].IsSelected}" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <!-- Theme Toggle -->
            <Button Classes="icon" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{loc:T TipToggleTheme}">
              <material:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
            </Button>

            <!-- Window Control Buttons (Minimize, Maximize, Close) -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
              <Button Classes="icon" Click="MinimizeWindow_Click" ToolTip.Tip="{loc:T TipMinimize}">
                <material:MaterialIcon Kind="WindowMinimize" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" Click="MaximizeWindow_Click" ToolTip.Tip="{loc:T TipMaximize}">
                <material:MaterialIcon Kind="WindowMaximize" Width="16" Height="16" />
              </Button>
              <Button Classes="icon close-btn" Click="CloseWindow_Click" ToolTip.Tip="{loc:T Close}">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- SERVER OFFLINE WARNING BANNER              -->
      <!-- ========================================== -->
      <Border Grid.Row="1"
              Background="#28FF003C"
              BorderBrush="{DynamicResource DangerColor}"
              BorderThickness="0,0,0,1"
              Padding="24,10"
              IsVisible="{Binding IsServerOfflineBannerVisible}">
        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="{DynamicResource DangerColor}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="10,0,16,0" Text="{Binding ServerBannerMessage}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" TextWrapping="Wrap" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
            <Button Classes="primary" Height="30" Padding="12,0" Command="{Binding RetryConnectServerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                <TextBlock Text="{loc:T Reconnect}" FontSize="12" FontWeight="Bold" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Height="30" Padding="12,0" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Settings}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                <TextBlock Text="{loc:T NavSettings}" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Column="3" Classes="icon" Command="{Binding DismissServerBannerCommand}" ToolTip.Tip="{loc:T TipDismissNotice}">
            <material:MaterialIcon Kind="Close" Width="16" Height="16" />
          </Button>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- MAIN WORKSPACE: SIDEBAR + CONTENT          -->
      <!-- ========================================== -->
      <Grid Grid.Row="2">
        <Grid ColumnDefinitions="Auto, *">

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Classes="sidebar"
                Classes.compact="{Binding IsCompactLayout}"
                Background="{DynamicResource Surface1}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="0,0,1,0">
          <ScrollViewer>
            <StackPanel Spacing="24">

              <!-- KÖNYVTÁR -->
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:T SectionLibrary}" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Előadók (Artists) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Artists}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Artists}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Artists}">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Border Classes="nav-bar" Grid.ColumnSpan="3" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="AccountMusicOutline" Foreground="{DynamicResource CoralAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavArtists}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalArtistsCount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CoralAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Albumok (Albums) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Albums}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Albums}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Albums}">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Border Classes="nav-bar" Grid.ColumnSpan="3" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavAlbums}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalAlbumsCount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PurpleAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Számok (Tracks) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Tracks}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Tracks}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Tracks}">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Border Classes="nav-bar" Grid.ColumnSpan="3" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="MusicNoteOutline" Foreground="{DynamicResource CyanAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavTracks}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalTracksCount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CyanAccent}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- GYŰJTEMÉNY -->
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:T SectionCollection}" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Kedvencek (Favorites) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Favorites}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Favorites}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Favorites}">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Border Classes="nav-bar" Grid.ColumnSpan="3" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Heart" Foreground="{DynamicResource CoralAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavFavorites}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalFavoritesCount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource CoralAccent}" />
                    </Border>
                  </Grid>
                </Button>

                <!-- Lejátszási listák (Playlists) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Playlists}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Playlists}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Playlists}">
                  <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Border Classes="nav-bar" Grid.ColumnSpan="3" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="PlaylistMusicOutline" Foreground="{DynamicResource LimeAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavPlaylists}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}">
                      <TextBlock Text="{Binding ServerSettings.TotalPlaylistsCount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource LimeAccent}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- BEÁLLÍTÁSOK -->
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:T SectionSettings}" Classes="group-title" Margin="8,0,0,8" IsVisible="{Binding !IsCompactLayout}" />

                <!-- Beállítások (Audiophile & Szerver) -->
                <Button Classes="secondary nav-item"
                        Classes.nav-on="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Settings}, Converter={StaticResource IntEqualConverter}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Height="40" Padding="12,0"
                        Background="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Settings}, Converter={StaticResource NavActiveBackgroundConverter}}"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppSection.Settings}">
                  <Grid VerticalAlignment="Center">
                    <Border Classes="nav-bar" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="CogOutline" Foreground="{DynamicResource CyanAccent}" Width="20" Height="20" />
                      <TextBlock Text="{loc:T NavSettings}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Center Dynamic Tab Content -->
        <Border Grid.Column="1" Padding="28,24">
          <Panel>

            <!-- Library tabs and search results; hidden while the queue is open -->
            <Panel Classes="page" IsVisible="{Binding !Player.IsQueueOpen}">

              <!-- The six tabs; hidden while a search is active. Each shows itself when its section is selected. -->
              <Panel Classes="page" IsVisible="{Binding !IsSearchActive}">
                <views:TracksView />
                <views:AlbumsView />
                <views:ArtistsView />
                <views:PlaylistsView />
                <views:FavoritesView />
                <views:SettingsView />
              </Panel>

              <views:SearchResultsView />
            </Panel>

            <views:QueueView />

          </Panel>
        </Border>
      </Grid>
    </Grid>

      <!-- ========================================== -->
      <!-- BOTTOM STICKY NOW-PLAYING BAR              -->
      <!-- ========================================== -->
      <Border Grid.Row="3"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0"
              Padding="16,0">
        <Grid ColumnDefinitions="*, Auto, *">

          <!-- Left: Track Details & Album Art -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="14">
            <Button Classes="unstyled-card cover-queue-btn"
                    Command="{Binding Player.ToggleQueueCommand}"
                    ToolTip.Tip="{loc:T TipQueueToggle}"
                    Cursor="Hand">
              <Border Classes="np-cover" Classes.playing="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                      Width="52" Height="52" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" ClipToBounds="True">
                <!-- The cover's own transform: the "breathing" animation (Motion.axaml) scales it while a track plays -->
                <Border.RenderTransform>
                  <ScaleTransform />
                </Border.RenderTransform>
                <Panel>
                  <Image Source="{Binding Player.CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <material:MaterialIcon Kind="MusicNote" Foreground="{DynamicResource CyanAccent}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                  <!-- Hover / Open Indicator Overlay with 180° Rotating Chevron -->
                  <Border Classes="cover-queue-overlay"
                          Classes.open="{Binding Player.IsQueueOpen}"
                          Background="#80000000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <material:MaterialIcon Kind="ChevronUp"
                                           Classes="queue-chevron"
                                           Classes.open="{Binding Player.IsQueueOpen}"
                                           Width="22" Height="22"
                                           Foreground="{DynamicResource PrimaryAction}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                  </Border>
                </Panel>
              </Border>
            </Button>

            <StackPanel VerticalAlignment="Center" Spacing="2" Width="170">
              <TextBlock Text="{Binding Player.NowPlayingTitle}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}"
                         ToolTip.Tip="{Binding Player.CurrentTrack.Title, FallbackValue=''}" />
              <TextBlock Text="{Binding Player.NowPlayingArtist}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !Player.HasError}" />
              <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="11" Foreground="{DynamicResource DangerColor}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Player.HasError}" ToolTip.Tip="{Binding Player.ErrorMessage}" />
            </StackPanel>

            <Button Classes="icon" Command="{Binding Player.ToggleFavoriteCurrentCommand}" VerticalAlignment="Center" ToolTip.Tip="{loc:T TipFavorite}"
                    IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
              <material:MaterialIcon Classes="heart-pop"
                                     Classes.fav="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False}"
                                     Kind="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False, Converter={StaticResource FavoriteIconConverter}}"
                                     Foreground="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False, Converter={StaticResource FavoriteColorConverter}}"
                                     Width="18" Height="18" />
            </Button>
          </StackPanel>

          <!-- Center: Controls & Seek Slider -->
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="520" VerticalAlignment="Center" Spacing="10" Margin="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
              <Button Classes="icon" Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="{loc:T TipShuffle}">
                <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{Binding Player.IsShuffle, Converter={StaticResource ActiveControlBrushConverter}}" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.PreviousTrackCommand}" ToolTip.Tip="{loc:T TipPrevious}">
                <material:MaterialIcon Kind="SkipPrevious" Width="22" Height="22" />
              </Button>
              <Button Command="{Binding Player.TogglePlayPauseCommand}"
                      Classes="primary"
                      Width="38" Height="38" MinWidth="38" MinHeight="38"
                      CornerRadius="6" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="{loc:T TipPlayPause}">
                <material:MaterialIcon Kind="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToIconConverter}}" Width="20" Height="20" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.NextTrackCommand}" ToolTip.Tip="{loc:T TipNext}">
                <material:MaterialIcon Kind="SkipNext" Width="22" Height="22" />
              </Button>
              <Button Classes="icon" Command="{Binding Player.ToggleRepeatCommand}" ToolTip.Tip="{loc:T TipRepeat}">
                <material:MaterialIcon Kind="{Binding Player.RepeatMode, Converter={StaticResource RepeatModeToIconConverter}}" Width="18" Height="18"
                                       Foreground="{Binding Player.RepeatMode, Converter={StaticResource ActiveControlBrushConverter}}" />
              </Button>
            </StackPanel>

            <Grid ColumnDefinitions="45, *, 45" Height="32" VerticalAlignment="Center" Margin="0" ClipToBounds="False">
              <TextBlock Grid.Column="0" Text="{Binding Player.FormattedPosition}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
              <Slider Grid.Column="1"
                      Classes="seek-slider"
                      Minimum="0"
                      Maximum="{Binding Player.DurationSeconds}"
                      Value="{Binding Player.PositionSeconds, Mode=TwoWay}"
                      IsEnabled="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Margin="4,0"
                      VerticalAlignment="Center"
                      ClipToBounds="False" />
              <TextBlock Grid.Column="2" Text="{Binding Player.FormattedDuration}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>

          <!-- Right: Visualizer, Quality, Volume -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
            <controls:SpectrumVisualizerControl Width="130" Height="36"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                IsVisible="{Binding !IsCompactLayout}"
                                                Bands="{Binding Player.SpectrumBands}"
                                                AccentBrush="{DynamicResource PrimaryAction}"
                                                IsPlaying="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                                                BarsPerBand="1"
                                                ToolTip.Tip="{loc:T TipSpectrum}" />

            <Panel IsVisible="{Binding !IsCompactLayout}" VerticalAlignment="Center">
              <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                      IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{Binding Player.QualityBadge}">
                <TextBlock Text="{Binding Player.QualityShortBadge}" FontSize="10" FontWeight="Black"
                           Foreground="{Binding Player.QualityShortBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
              </Border>
            </Panel>

            <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}" Width="28" Height="28" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Player.VolumeToolTip}">
              <Panel>
                <!-- Active normal playback: primary action color -->
                <material:MaterialIcon Kind="VolumeHigh" Width="18" Height="18"
                                       Foreground="{DynamicResource PrimaryAction}"
                                       IsVisible="{Binding Player.IsVolumeActive}" />
                <!-- Bit-perfect / volume locked: speaker icon in grey (not muted) -->
                <material:MaterialIcon Kind="VolumeHigh" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding Player.IsVolumeLockedAndNotMuted}" />
                <!-- Actually muted: muted speaker icon -->
                <material:MaterialIcon Kind="VolumeOff" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding Player.IsMuted}" />
              </Panel>
            </Button>

            <Slider Classes="seek-slider"
                    Classes.volume-muted="{Binding Player.IsMuted}"
                    Width="95"
                    Minimum="0" Maximum="100"
                    Value="{Binding Player.Volume, Mode=TwoWay}"
                    IsEnabled="{Binding !Player.IsVolumeLocked}"
                    VerticalAlignment="Center"
                    ClipToBounds="False" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- BOTTOM FOOTER STATUS BAR                   -->
      <!-- ========================================== -->
      <Border Grid.Row="4"
              Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0"
              Padding="24,0">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Classes="status-pulse" Width="6" Height="6" Fill="{DynamicResource SuccessColor}" VerticalAlignment="Center" IsVisible="{Binding !Player.HasError}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !Player.HasError}" />
            <material:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" IsVisible="{Binding Player.HasError}" />
            <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Player.HasError}" />
            <Button Classes="icon" Width="22" Height="22" Padding="0" Command="{Binding Player.DismissErrorCommand}" IsVisible="{Binding Player.HasError}" ToolTip.Tip="{loc:T TipDismissError}">
              <material:MaterialIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="1" Text="{Binding RightFooterStatusText}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsVisible="{Binding !IsCompactLayout}" />
        </Grid>
      </Border>

    </Grid>

    <!-- The full-screen sign-in and first-run setup page. -->
    <views:LoginView />

    <!-- ============================================== -->
    <!-- PLAYLIST DIALOGS                               -->
    <!-- ============================================== -->
    <Panel Classes="dialog-scrim" IsVisible="{Binding Playlists.IsAnyDialogOpen}" Background="#A6000000">

      <!-- New playlist -->
      <Border Classes="dialog-card" Width="420" IsVisible="{Binding Playlists.IsCreateDialogOpen}">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <TranslateTransform />
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:T PlaylistNew}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{loc:TFormat PlaylistAlsoAddsTrack, Path=Playlists.TrackToAdd.Title}"
                     IsVisible="{Binding Playlists.TrackToAdd, Converter={x:Static ObjectConverters.IsNotNull}}"
                     FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Playlists.NewPlaylistName, Mode=TwoWay}" Watermark="{loc:T PlaylistNamePlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding Playlists.CreatePlaylistCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding Playlists.CloseCreateDialogCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CloseCreateDialogCommand}">
              <TextBlock Text="{loc:T Cancel}" FontWeight="SemiBold" />
            </Button>
            <Button Classes="lime" Height="36" Padding="16,0" Command="{Binding Playlists.CreatePlaylistCommand}">
              <TextBlock Text="{loc:T Create}" FontWeight="Bold" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Add track to playlist -->
      <Border Classes="dialog-card" Width="420" IsVisible="{Binding Playlists.IsAddToPlaylistDialogOpen}">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <TranslateTransform />
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:T TipAddToPlaylist}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
            <TextBlock Text="{Binding Playlists.TrackToAdd.Title, FallbackValue=''}" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Text="{loc:T NoPlaylistsCreateOne}" IsVisible="{Binding !Playlists.HasPlaylists}"
                     FontSize="12" Foreground="{DynamicResource TextMuted}" />
          <ScrollViewer MaxHeight="300">
            <ItemsControl ItemsSource="{Binding Playlists.Playlists}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:Playlist">
                  <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" Margin="0,0,0,6"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.AddPendingTrackToCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TrackCount, StringFormat='({0})'}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CancelAddTrackCommand}">
              <TextBlock Text="{loc:T Cancel}" FontWeight="SemiBold" />
            </Button>
            <Button Classes="lime" Height="36" Padding="16,0" Command="{Binding Playlists.CreatePlaylistForPendingTrackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="{loc:T PlaylistNew}" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Delete confirmation -->
      <Border Classes="dialog-card" Width="400" IsVisible="{Binding Playlists.IsDeleteConfirmOpen}">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <TranslateTransform />
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:T PlaylistDeleteAction}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{loc:TFormat PlaylistDeleteConfirm, Path=Playlists.PlaylistPendingDelete.Name}"
                     FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Height="36" Padding="16,0" Command="{Binding Playlists.CancelDeletePlaylistCommand}">
              <TextBlock Text="{loc:T Cancel}" FontWeight="SemiBold" />
            </Button>
            <Button Classes="coral" Height="36" Padding="16,0" Command="{Binding Playlists.ConfirmDeletePlaylistCommand}">
              <TextBlock Text="{loc:T Delete}" FontWeight="Bold" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

  </Panel>
</UserControl>

