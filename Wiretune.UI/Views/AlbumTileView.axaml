<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:services="using:Wiretune.UI.Services"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:controls="using:Wiretune.UI.Controls"
             x:Class="Wiretune.UI.Controls.AlbumTileView"
             x:DataType="vm:AlbumCardViewModel"
             x:Name="Root"
             ClipToBounds="False">
  <UserControl.Resources>
    <controls:CompactBadgeConverter x:Key="CompactBadgeConverter" />
  </UserControl.Resources>
  <Button Classes="unstyled-card"
          Command="{Binding OpenCommand, ElementName=Root}"
          CommandParameter="{Binding}"
          Margin="0,6,18,12">
    <Border Classes="metric-card purple" Width="210" Height="270" services:ViewportLoad.Target="{Binding}">
      <Grid RowDefinitions="150, *, Auto">
        <!-- Cover placeholder / art -->
        <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
          <Panel>
            <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
          </Panel>
        </Border>

        <!-- Album Title & Artist -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{loc:TFormat TrackCount, Path=TrackCount}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Year, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Year}" FontSize="11" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Year, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </StackPanel>

        <!-- Badge & Play Button -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
          <Border Grid.Column="0" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{Binding FormatBadge, Converter={StaticResource CompactBadgeConverter}}" FontSize="10" FontWeight="Black"
                       Foreground="{Binding FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Border>
          <Button Grid.Column="1" Classes="purple"
                  Width="32" Height="32"
                  CornerRadius="4"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Command="{Binding PlayCommand, ElementName=Root}"
                  CommandParameter="{Binding Album}"
                  ToolTip.Tip="{loc:T Play}">
            <material:MaterialIcon Kind="Play" Foreground="{DynamicResource PrimaryActionForeground}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Button>
</UserControl>
