<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.QueueView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <!-- One line of synced lyrics: dim until it is sung, bright and slightly larger while it is, dimmer again after.
         The change is eased over a third of a second so the highlight glides from line to line. -->
    <Style Selector="Border.lyric-line">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="RenderTransformOrigin" Value="0%,50%" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.lyric-line.past">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.lyric-line:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.lyric-line.active">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <!-- An instrumental gap is only a small space, and not clickable -->
    <Style Selector="Border.lyric-line.blank">
      <Setter Property="MinHeight" Value="14" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- The play queue, with drag and drop to reorder it. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding Player.IsQueueOpen}" RowDefinitions="Auto, *">
    <!-- View Header / Actions -->
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{loc:T Queue}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{loc:TFormat TrackCount, Path=Player.QueueTracks.Count}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                  IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{loc:T NowPlaying}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PrimaryAction}" />
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Classes="secondary" Height="38" CornerRadius="6" Padding="18,8"
                Command="{Binding Player.ClearQueueCommand}"
                IsEnabled="{Binding Player.QueueTracks.Count}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
            <TextBlock Text="{loc:T ClearQueue}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}" />
          </StackPanel>
        </Button>
        <Button Classes="primary" Height="38" CornerRadius="6" Padding="18,8"
                Command="{Binding Player.CloseQueueCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="Close" Width="18" Height="18" />
            <TextBlock Text="{loc:T Close}" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Queue Content (Glass Panel matching other views) -->
    <Border Grid.Row="1" Classes="glass view-accent" Padding="0" ClipToBounds="True">
      <!-- Queue and lyrics share the panel equally -->
      <Grid ColumnDefinitions="*, *">
        <!-- Empty Queue Placeholder -->
        <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32"
                    IsVisible="{Binding !Player.QueueTracks.Count}">
          <material:MaterialIcon Kind="PlaylistPlay" Width="64" Height="64" Foreground="{DynamicResource PrimaryAction}" HorizontalAlignment="Center" />
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="{loc:T QueueEmptyTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T QueueEmptyHint}"
                       FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" />
          </StackPanel>
        </StackPanel>

        <!-- Queue Tracks List -->
        <ScrollViewer Grid.Column="0" IsVisible="{Binding Player.QueueTracks.Count}" Padding="16">
          <ItemsControl ItemsSource="{Binding Player.QueueItems}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:QueueItemViewModel">
                <Border Classes="queue-item"
                        Classes.current-track="{Binding IsCurrent}"
                        Classes.drop-target="{Binding IsDropTarget}"
                        Tag="{Binding}"
                        PointerPressed="QueueItem_PointerPressed"
                        PointerMoved="QueueItem_PointerMoved"
                        PointerReleased="QueueItem_PointerReleased"
                        PointerCaptureLost="QueueItem_PointerCaptureLost"
                        Padding="12,8"
                        Margin="0,0,0,6">
                  <!-- The right-hand columns share their widths across the rows, so badges, times and buttons line up -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="QueueBadge" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="QueueTime" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="QueueMove" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="QueueRemove" />
                    </Grid.ColumnDefinitions>
                    <!-- Drag Handle Icon -->
                    <material:MaterialIcon Grid.Column="0" Kind="DragVertical" Width="16" Height="16"
                                           Foreground="{DynamicResource TextDisabled}"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{loc:T TipDragToReorder}" />

                    <!-- Cover Artwork Thumbnail -->
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Panel>
                        <material:MaterialIcon Kind="MusicNote" Foreground="{DynamicResource TextMuted}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <controls:CoverImage SourcePath="{Binding Track.CoverArtPath}" DecodeWidth="76" Stretch="UniformToFill" />

                        <!-- Currently Playing Volume Overlay -->
                        <Border Background="#A0000000" IsVisible="{Binding IsCurrent}">
                          <controls:EqualizerBars IsVisible="{Binding IsCurrent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Track Number Badge (when not playing) -->
                        <Border Background="#80000000" CornerRadius="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,1" IsVisible="{Binding !IsCurrent}">
                          <TextBlock Text="{Binding DisplayIndex}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextMuted}" />
                        </Border>
                      </Panel>
                    </Border>

                    <!-- Track Title & Artist -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Track.Title}" FontSize="13" FontWeight="Bold"
                                 Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Track.Artist}" FontSize="11"
                                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Audio Format Badge -->
                    <controls:QualityTag Grid.Column="3" Tier="{Binding Track.Format.Tier}" Spec="{Binding Track.Format.TagSpec}" IsCompact="True" Margin="0,0,12,0" />

                    <!-- Duration -->
                    <TextBlock Grid.Column="4" Text="{Binding Track.FormattedDuration}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <!-- Up / Down Quick Reorder Buttons -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                      <Button Classes="icon action-btn" Width="26" Height="26"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.MoveQueueTrackUpCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{loc:T TipMoveUp}">
                        <material:MaterialIcon Kind="ChevronUp" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" />
                      </Button>
                      <Button Classes="icon action-btn" Width="26" Height="26"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.MoveQueueTrackDownCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{loc:T TipMoveDown}">
                        <material:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" />
                      </Button>
                    </StackPanel>

                    <!-- Remove Track from Queue Button -->
                    <Button Grid.Column="6" Classes="icon remove-btn"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.RemoveQueueTrackCommand}"
                            CommandParameter="{Binding Track}"
                            Width="28" Height="28"
                            ToolTip.Tip="{loc:T TipRemoveFromQueue}"
                            VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DangerColor}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- Lyrics (right half) -->
        <Border Grid.Column="1" IsVisible="{Binding Player.QueueTracks.Count}"
                BorderBrush="{DynamicResource TagBackground}" BorderThickness="1,0,0,0" Padding="24,20">
          <Grid RowDefinitions="Auto, *">
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
              <TextBlock Text="{loc:T Lyrics}" Classes="group-title" />
              <TextBlock Text="{Binding Player.CurrentTrack.Title}" FontSize="16" FontWeight="Black"
                         Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Player.CurrentTrack.Artist}" FontSize="12"
                         Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
              <!-- Where the lyrics came from: the track's own tags or the internet lookup -->
              <TextBlock Text="{Binding Player.LyricsSourceText}" FontSize="11" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Player.HasLyrics}" />
            </StackPanel>

            <!-- Plain lyrics (no time tags): one block of text that does not follow the song -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding Player.HasPlainLyrics}">
              <SelectableTextBlock Text="{Binding Player.CurrentLyrics}" TextWrapping="Wrap"
                                   FontSize="15" LineHeight="26" Foreground="{DynamicResource TextMain}" />
            </ScrollViewer>

            <!-- Time-synced lyrics: the line being sung is highlighted and the list scrolls along (QueueView.axaml.cs). -->
            <ScrollViewer x:Name="SyncedLyricsScroll" Grid.Row="1" IsVisible="{Binding Player.HasSyncedLyrics}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
              <ScrollViewer.OpacityMask>
                <!-- Lines fade out towards the top and bottom edge instead of being cut off -->
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="Transparent" Offset="0" />
                  <GradientStop Color="Black" Offset="0.1" />
                  <GradientStop Color="Black" Offset="0.9" />
                  <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
              </ScrollViewer.OpacityMask>
              <ItemsControl x:Name="SyncedLyricsItems" ItemsSource="{Binding Player.LyricLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LyricLineViewModel">
                    <Border Classes="lyric-line" Classes.active="{Binding IsActive}" Classes.past="{Binding IsPast}"
                            Classes.blank="{Binding IsBlank, Mode=OneTime}"
                            Background="Transparent" Padding="0,6,16,6" Tapped="LyricLine_Tapped">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="19" FontWeight="Bold"
                                 LineHeight="26" Foreground="{DynamicResource TextMain}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Looking for the lyrics -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        IsVisible="{Binding Player.IsLoadingLyrics}">
              <ProgressBar IsIndeterminate="True" Width="120" Height="3" CornerRadius="2" Foreground="{DynamicResource CyanAccent}" />
              <TextBlock Text="{loc:T LyricsSearching}" FontSize="13"
                         Foreground="{DynamicResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
            </StackPanel>

            <!-- No lyrics (or the lookup could not be made) -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding Player.ShowLyricsEmptyState}">
              <material:MaterialIcon Kind="TextBoxOutline" Width="40" Height="40" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Player.LyricsEmptyText}" FontSize="13"
                         Foreground="{DynamicResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>

</UserControl>
