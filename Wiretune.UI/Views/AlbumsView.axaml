<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.AlbumsView"
             x:DataType="vm:MainViewModel">

  <!-- The Albums tab: the album grid and the album detail page. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Albums}, Converter={StaticResource IntEqualConverter}}">

    <!-- Subview 1: Albums Grid (when no album detail open) -->
    <Grid Classes="page" RowDefinitions="Auto, *" IsVisible="{Binding !Albums.IsAlbumDetailOpen}">
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
        <TextBlock Grid.Column="0" Text="{loc:T NavAlbums}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{loc:T SortBy}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="secondary" Classes.selected="{Binding Albums.IsSortByTitle}" Height="32" Padding="14,0" MinWidth="72"
                  Command="{Binding Albums.SetSortFieldCommand}" CommandParameter="Title">
            <TextBlock Text="{Binding Albums.SortTitleLabel}" FontWeight="SemiBold" FontSize="12" />
          </Button>
          <Button Classes="secondary" Classes.selected="{Binding Albums.IsSortByYear}" Height="32" Padding="14,0" MinWidth="72"
                  Command="{Binding Albums.SetSortFieldCommand}" CommandParameter="Year">
            <TextBlock Text="{Binding Albums.SortYearLabel}" FontWeight="SemiBold" FontSize="12" />
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Classes="page" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                  IsVisible="{Binding IsLibraryEmpty}">
        <material:MaterialIcon Kind="Album" Width="64" Height="64" Foreground="{DynamicResource PurpleAccent}" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T EmptyAlbumsTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T EmptyConnectHint}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="-10,0,0,0" Padding="10,8,0,0" ClipToBounds="False">
        <ItemsControl ItemsSource="{Binding Albums.DisplayedAlbums}" ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:AlbumCardViewModel">
              <controls:AlbumTileView
                OpenCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.OpenAlbumCommand}"
                PlayCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Subview 2: Album Detail View (Tracklist & Controls) -->
    <Grid Classes="page" RowDefinitions="Auto, Auto, *" IsVisible="{Binding Albums.IsAlbumDetailOpen}">
      <!-- Back Button -->
      <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
              HorizontalAlignment="Left"
              Command="{Binding Albums.CloseAlbumDetailCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource PurpleAccent}" />
          <TextBlock Text="{Binding Albums.BackButtonText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Album Hero Banner -->
      <Border Grid.Row="1" Classes="glass purple" Margin="0,0,0,20">
        <Grid ColumnDefinitions="140, *">
          <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding Albums.SelectedAlbumCover}" Stretch="UniformToFill" IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <material:MaterialIcon Kind="Album" Foreground="{DynamicResource PurpleAccent}" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNull}}" />
            </Panel>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2">
                <TextBlock Text="{loc:T ColAlbum}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PurpleAccent}" />
              </Border>
              <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2">
                <TextBlock Text="{Binding Albums.SelectedAlbum.FormatBadge}" FontSize="10" FontWeight="Black" Foreground="{Binding Albums.SelectedAlbum.FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding Albums.SelectedAlbum.Title}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="table-link"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                      CommandParameter="{Binding Albums.SelectedAlbum.Artist}">
                <TextBlock Text="{Binding Albums.SelectedAlbum.Artist}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
              </Button>
              <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Albums.SelectedAlbum.Year}" FontSize="13" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Albums.SelectedAlbum.Year, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
              <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{loc:TFormat TrackCount, Path=Albums.SelectedAlbum.TrackCount}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Albums.SelectedAlbum.FormattedTotalDuration}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <Button Classes="purple" Height="38" CornerRadius="6" Command="{Binding Albums.PlayAlbumCommand}" CommandParameter="{Binding Albums.SelectedAlbum}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Play" Width="18" Height="18" />
                  <TextBlock Text="{loc:T Play}" FontWeight="Bold" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Height="38" CornerRadius="6" Command="{Binding Albums.ShuffleAlbumCommand}" CommandParameter="{Binding Albums.SelectedAlbum}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{DynamicResource PurpleAccent}" />
                  <TextBlock Text="{loc:T Shuffle}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tracklist DataGrid -->
      <Border Grid.Row="2" Classes="glass purple" Padding="0" ClipToBounds="True">
        <DataGrid ItemsSource="{Binding Albums.SelectedAlbum.Tracks}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <!-- Track # (Clickable to play track) -->
            <DataGridTemplateColumn Header="#" Width="52" SortMemberPath="TrackNumber">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="models:Track">
                  <Button Classes="table-link track-num"
                          Classes.playing="{Binding IsPlaying}"
                          controls:RowPressSync.SyncWithTitle="True"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumTrackCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:T Play}">
                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayTrackNumber}"
                                 IsVisible="{Binding !IsPlaying}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <controls:EqualizerBars IsVisible="{Binding IsPlaying}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Title (Clickable to play track) -->
            <DataGridTemplateColumn Header="{loc:T ColTitle}" Width="3*" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="models:Track">
                  <Button Classes="table-link title"
                          Classes.playing="{Binding IsPlaying}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumTrackCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Format / Quality -->
            <DataGridTemplateColumn Header="{loc:T ColQuality}" Width="185" SortMemberPath="Format.DisplayBadge" CellTemplate="{StaticResource TrackQualityCell}" />

            <!-- Duration -->
            <DataGridTextColumn Header="{loc:T ColLength}" Binding="{Binding FormattedDuration}" Width="105" SortMemberPath="Duration" />

            <!-- Favorite -->
            <DataGridTemplateColumn Width="50" Header="" SortMemberPath="IsFavorite">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="models:Track">
                  <Button Classes="icon"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                          CommandParameter="{Binding}">
                    <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                           Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                           Width="18" Height="18" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="44" Header="" CellTemplate="{StaticResource TrackAddToPlaylistCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

    </Grid>
  </Grid>

</UserControl>
