<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:services="using:Wiretune.UI.Services"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.AndroidMainView"
             x:DataType="vm:MainViewModel"
             x:Name="RootControl">

  <!-- x:Name="StatusBarSpacer" height is set from code-behind to match the real status bar height. -->
  <Panel Background="{DynamicResource WindowGradient}">

    <!-- ================================================ -->
    <!-- MAIN LAYOUT: Header + Content + MiniPlayer + Nav  -->
    <!-- ================================================ -->
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto"
          IsVisible="{Binding !IsLoginViewActive}">

      <!-- ROW 0: STATUS BAR SPACER (height set from code-behind via StatusBarSpacer) -->
      <Border Grid.Row="0" x:Name="StatusBarSpacer" Height="28"
              Background="{DynamicResource Surface1}" />

      <!-- ROW 1: TOP BAR -->
      <Border Grid.Row="1"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
        <Grid ColumnDefinitions="*, Auto">
          <TextBox Grid.Column="0"
                   Classes="search-pill"
                   VerticalContentAlignment="Center"
                   Height="40"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   Watermark="Keresés...">
            <TextBox.InnerLeftContent>
              <material:MaterialIcon Kind="Magnify" Width="18" Height="18"
                                     Foreground="{DynamicResource TextMuted}"
                                     Margin="12,0,6,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="icon"
                      Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding IsSearchActive}"
                      Width="28" Height="28" Margin="0,0,6,0">
                <material:MaterialIcon Kind="CloseCircle" Width="16" Height="16"
                                       Foreground="{DynamicResource TextMuted}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <Button Grid.Column="1" Classes="icon" Margin="10,0,0,0"
                  Command="{Binding ShowLoginScreenCommand}">
            <material:MaterialIcon Kind="AccountCircleOutline" Width="24" Height="24"
                                   Foreground="{DynamicResource CyanAccent}" />
          </Button>
        </Grid>
      </Border>

      <!-- ROW 2: SERVER OFFLINE BANNER -->
      <Border Grid.Row="2"
              Background="#28FF003C"
              BorderBrush="{DynamicResource DangerColor}"
              BorderThickness="0,0,0,1"
              Padding="16,8"
              IsVisible="{Binding IsServerOfflineBannerVisible}">
        <Grid ColumnDefinitions="Auto, *, Auto">
          <material:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline"
                                 Width="18" Height="18"
                                 Foreground="{DynamicResource DangerColor}"
                                 VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding ServerBannerMessage}"
                     FontSize="12" Foreground="{DynamicResource TextMain}"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="icon"
                  Command="{Binding DismissServerBannerCommand}">
            <material:MaterialIcon Kind="Close" Width="16" Height="16" />
          </Button>
        </Grid>
      </Border>

      <!-- ROW 3: CONTENT -->
      <Panel Grid.Row="3">

        <!-- SEARCH -->
        <Panel IsVisible="{Binding IsSearchActive}">
          <ScrollViewer Padding="16,12,16,0">
            <StackPanel Spacing="20">
              <Border Classes="glass" Padding="32" HorizontalAlignment="Center"
                      Margin="0,32,0,0"
                      IsVisible="{Binding !Search.HasResults}">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                  <material:MaterialIcon Kind="MagnifyClose" Width="48" Height="48"
                                         Foreground="{DynamicResource TextMuted}"
                                         HorizontalAlignment="Center" />
                  <TextBlock Text="Nincs találat" FontSize="16" FontWeight="Bold"
                             Foreground="{DynamicResource TextMain}"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Best match -->
              <StackPanel IsVisible="{Binding Search.BestMatch, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Spacing="8">
                <TextBlock Text="LEGJOBB TALÁLAT" Classes="group-title" />
                <Border Classes="glass" Padding="16" CornerRadius="12">
                  <Panel>
                    <Grid ColumnDefinitions="88, *">
                      <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8"
                              Background="{DynamicResource Surface2}" ClipToBounds="True">
                        <Panel>
                          <Image Source="{Binding Search.BestMatch.CoverBitmap}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding Search.BestMatch.HasCover}" />
                          <material:MaterialIcon Kind="{Binding Search.BestMatch.IconKind}"
                                                 Foreground="{Binding Search.BestMatch.TypeBrush}"
                                                 Width="36" Height="36"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding !Search.BestMatch.HasCover}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4"
                                  VerticalAlignment="Center">
                        <Border Background="{DynamicResource TagBackground}" CornerRadius="4"
                                Padding="6,2" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Search.BestMatch.TypeLabel}"
                                     FontSize="10" FontWeight="Black"
                                     Foreground="{Binding Search.BestMatch.TypeBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Search.BestMatch.Title}"
                                   FontSize="18" FontWeight="Black"
                                   Foreground="{DynamicResource TextMain}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Search.BestMatch.Subtitle}"
                                   FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                    <Button Classes="unstyled-card" Padding="0" Background="Transparent"
                            BorderThickness="0" Focusable="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Command="{Binding Search.BestMatch.OpenCommand}"
                            IsVisible="{Binding Search.BestMatch.CanOpen}" />
                  </Panel>
                </Border>
              </StackPanel>

              <!-- Track results -->
              <StackPanel IsVisible="{Binding Search.HasTracks}" Spacing="8">
                <TextBlock Text="SZÁMOK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Search.MatchingTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.PlayTrackCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="48, *, Auto" Margin="0,5">
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="MusicNote" Width="18" Height="18"
                                                   Foreground="{DynamicResource CyanAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}"
                                     FontSize="12" Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Album results -->
              <StackPanel IsVisible="{Binding Search.HasAlbums}" Spacing="8">
                <TextBlock Text="ALBUMOK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Search.MatchingAlbums}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumCardViewModel">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenAlbumCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="48, *" Margin="0,5">
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="Album" Width="18" Height="18"
                                                   Foreground="{DynamicResource PurpleAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Artist results -->
              <StackPanel IsVisible="{Binding Search.HasArtists}" Spacing="8">
                <TextBlock Text="ELŐADÓK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Search.MatchingArtists}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Artist">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenArtistCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="48, *" Margin="0,5">
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="AccountMusicOutline" Width="20" Height="20"
                                                   Foreground="{DynamicResource CoralAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AlbumCount, StringFormat='{}{0} album'}"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Panel>

        <!-- LIBRARY TABS -->
        <Panel IsVisible="{Binding !IsSearchActive}">

          <!-- TAB 2: ARTISTS -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=2, Converter={StaticResource IntEqualConverter}}">
            <Panel IsVisible="{Binding !Artists.IsArtistDetailOpen}">
              <ScrollViewer Padding="16,12,16,0">
                <StackPanel Spacing="4">
                  <TextBlock Text="ELŐADÓK" Classes="group-title" />
                  <ItemsControl ItemsSource="{Binding Artists.DisplayedArtists}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Artist">
                        <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="56, *, Auto" Margin="0,6">
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="{DynamicResource Surface2}" ClipToBounds="True">
                              <material:MaterialIcon Kind="AccountMusicOutline" Width="24" Height="24"
                                                     Foreground="{DynamicResource CoralAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,8,0" Spacing="2"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextMain}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding AlbumCount, StringFormat='{}{0} album'}"
                                         FontSize="12" Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                            <material:MaterialIcon Grid.Column="2" Kind="ChevronRight"
                                                   Width="20" Height="20"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Panel>
            <!-- Artist Detail -->
            <Panel IsVisible="{Binding Artists.IsArtistDetailOpen}">
              <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{DynamicResource Surface1}"
                        BorderBrush="{DynamicResource GlassBorder}"
                        BorderThickness="0,0,0,1" Padding="8,10">
                  <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0" Classes="icon"
                            Command="{Binding Artists.CloseArtistDetailCommand}">
                      <material:MaterialIcon Kind="ArrowLeft" Width="22" Height="22" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Artists.SelectedArtist.Name}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="16,12,16,0">
                  <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="90, *">
                      <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                              Background="{DynamicResource Surface2}" ClipToBounds="True">
                        <material:MaterialIcon Kind="AccountMusicOutline" Width="36" Height="36"
                                               Foreground="{DynamicResource CoralAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Artists.SelectedArtist.Name}"
                                   FontSize="22" FontWeight="Black"
                                   Foreground="{DynamicResource TextMain}" />
                        <TextBlock Text="{Binding Artists.SelectedArtist.TrackCount, StringFormat='{}{0} szám'}"
                                   FontSize="13" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding Artists.HasSelectedArtistAlbums}">
                      <TextBlock Text="ALBUMOK" Classes="group-title" />
                      <ItemsControl ItemsSource="{Binding Artists.SelectedArtistAlbumCards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AlbumCardViewModel">
                            <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="56, *" Margin="0,5">
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6"
                                        Background="{DynamicResource Surface2}" ClipToBounds="True">
                                  <material:MaterialIcon Kind="Album" Width="22" Height="22"
                                                         Foreground="{DynamicResource PurpleAccent}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"
                                            VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextMain}"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} szám'}"
                                             FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="SZÁMOK" Classes="group-title" />
                      <ItemsControl ItemsSource="{Binding Artists.SelectedArtistTracks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:Track">
                            <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.PlayQueueTrackCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="48, *, Auto" Margin="0,5">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                        Background="{DynamicResource Surface2}" ClipToBounds="True">
                                  <material:MaterialIcon Kind="MusicNote" Width="18" Height="18"
                                                         Foreground="{DynamicResource CyanAccent}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2"
                                            VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextMain}"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Album}" FontSize="12"
                                             Foreground="{DynamicResource TextMuted}"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}"
                                           FontSize="12" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Panel>
          </Panel>

          <!-- TAB 1: ALBUMS -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=1, Converter={StaticResource IntEqualConverter}}">
            <Panel IsVisible="{Binding !Albums.IsAlbumDetailOpen}">
              <ScrollViewer Padding="16,12,16,0">
                <StackPanel Spacing="4">
                  <TextBlock Text="ALBUMOK" Classes="group-title" />
                  <ItemsControl ItemsSource="{Binding Albums.DisplayedAlbums}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AlbumCardViewModel">
                        <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="56, *" Margin="0,6">
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                    Background="{DynamicResource Surface2}" ClipToBounds="True">
                              <material:MaterialIcon Kind="Album" Width="22" Height="22"
                                                     Foreground="{DynamicResource PurpleAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextMain}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Artist}" FontSize="12"
                                         Foreground="{DynamicResource TextMuted}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Panel>
            <!-- Album detail -->
            <Panel IsVisible="{Binding Albums.IsAlbumDetailOpen}">
              <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{DynamicResource Surface1}"
                        BorderBrush="{DynamicResource GlassBorder}"
                        BorderThickness="0,0,0,1" Padding="8,10">
                  <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0" Classes="icon"
                            Command="{Binding Albums.CloseAlbumDetailCommand}">
                      <material:MaterialIcon Kind="ArrowLeft" Width="22" Height="22" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Albums.SelectedAlbum.Title}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="16,12,16,0">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="110, *">
                      <Border Grid.Column="0" Width="100" Height="100" CornerRadius="10"
                              Background="{DynamicResource Surface2}" ClipToBounds="True">
                        <Panel>
                          <Image Source="{Binding Albums.SelectedAlbumCover}" Stretch="UniformToFill"
                                 IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <material:MaterialIcon Kind="Album" Width="44" Height="44"
                                                 Foreground="{DynamicResource PurpleAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding Albums.SelectedAlbumCover, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Albums.SelectedAlbum.Title}"
                                   FontSize="20" FontWeight="Black"
                                   Foreground="{DynamicResource TextMain}" />
                        <TextBlock Text="{Binding Albums.SelectedAlbum.Artist}"
                                   FontSize="14" Foreground="{DynamicResource TextMuted}" />
                        <Button Classes="primary" Height="34" Padding="16,0" Margin="0,4,0,0"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.PlayQueueTrackCommand}"
                                CommandParameter="{Binding Albums.SelectedAlbum.Tracks}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Play" Width="16" Height="16" />
                            <TextBlock Text="Lejátszás" FontWeight="Bold" FontSize="13" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Albums.SelectedAlbum.Tracks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                          <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.PlayQueueTrackCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="32, *, Auto" Margin="0,6">
                              <TextBlock Grid.Column="0" Text="{Binding TrackNumber}"
                                         FontSize="13" Foreground="{DynamicResource TextMuted}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}"
                                         FontSize="12" Foreground="{DynamicResource TextMuted}"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Panel>
          </Panel>

          <!-- TAB 0: TRACKS -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=0, Converter={StaticResource IntEqualConverter}}">
            <ScrollViewer Padding="16,12,16,0">
              <StackPanel Spacing="4">
                <TextBlock Text="SZÁMOK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Tracks.DisplayedTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.PlayQueueTrackCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="48, *, Auto" Margin="0,6">
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="MusicNote" Width="18" Height="18"
                                                   Foreground="{DynamicResource CyanAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}"
                                     FontSize="12" Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Panel>

          <!-- TAB 4: FAVORITES -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=4, Converter={StaticResource IntEqualConverter}}">
            <ScrollViewer Padding="16,12,16,0">
              <StackPanel Spacing="4">
                <TextBlock Text="KEDVENCEK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Favorites.FavoriteTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Player.PlayQueueTrackCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="48, *, Auto" Margin="0,6">
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="Heart" Width="18" Height="18"
                                                   Foreground="{DynamicResource CoralAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}"
                                     FontSize="12" Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Panel>

          <!-- TAB 3: PLAYLISTS -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=3, Converter={StaticResource IntEqualConverter}}">
            <ScrollViewer Padding="16,12,16,0">
              <StackPanel Spacing="4">
                <TextBlock Text="LEJÁTSZÁSI LISTÁK" Classes="group-title" />
                <ItemsControl ItemsSource="{Binding Playlists.DisplayedPlaylists}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                      <Button Classes="unstyled-card" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.OpenPlaylistCommand}"
                              CommandParameter="{Binding Playlist}">
                        <Grid ColumnDefinitions="56, *" Margin="0,6">
                          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                  Background="{DynamicResource Surface2}" ClipToBounds="True">
                            <material:MaterialIcon Kind="PlaylistMusicOutline" Width="22" Height="22"
                                                   Foreground="{DynamicResource LimeAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} szám'}"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Panel>

          <!-- TAB 5: SETTINGS -->
          <Panel IsVisible="{Binding SelectedNavigationIndex, ConverterParameter=5, Converter={StaticResource IntEqualConverter}}">
            <ScrollViewer Padding="16,12,16,0">
              <StackPanel Spacing="16">
                <TextBlock Text="BEÁLLÍTÁSOK" Classes="group-title" />
                <Border Classes="glass" Padding="18" CornerRadius="12">
                  <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="ServerNetwork" Width="20" Height="20"
                                             Foreground="{DynamicResource CyanAccent}" />
                      <TextBlock Text="Wiretune Szerver" FontSize="15" FontWeight="Bold"
                                 Foreground="{DynamicResource TextMain}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Text="Szerver URL" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMuted}" />
                      <TextBox Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}"
                               Watermark="http://192.168.1.x:5000" Height="40" />
                    </StackPanel>
                    <Button Classes="primary" Height="40" HorizontalAlignment="Stretch"
                            Command="{Binding ServerSettings.ConnectServerCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="LanConnect" Width="18" Height="18" />
                        <TextBlock Text="Csatlakozás" FontWeight="Bold" FontSize="14" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Classes="glass" Padding="18" CornerRadius="12">
                  <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryAction}" />
                      <TextBlock Text="Sötét / Világos téma" FontSize="15"
                                 Foreground="{DynamicResource TextMain}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon"
                            Command="{Binding ToggleThemeCommand}">
                      <material:MaterialIcon Kind="SwapHorizontal" Width="22" Height="22" />
                    </Button>
                  </Grid>
                </Border>
                <Border Classes="glass" Padding="18" CornerRadius="12">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <material:MaterialIcon Kind="AccountCircleOutline" Width="20" Height="20"
                                             Foreground="{DynamicResource CyanAccent}" />
                      <TextBlock Text="Fiók" FontSize="15" FontWeight="Bold"
                                 Foreground="{DynamicResource TextMain}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentUserBadge}" FontSize="14"
                               Foreground="{DynamicResource TextMuted}" />
                    <Button Classes="primary" Height="40" HorizontalAlignment="Stretch"
                            IsVisible="{Binding !IsUserLoggedIn}"
                            Command="{Binding ShowLoginScreenCommand}">
                      <TextBlock Text="Bejelentkezés" FontWeight="Bold" FontSize="14" />
                    </Button>
                    <Button Classes="secondary" Height="40" HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsUserLoggedIn}"
                            Command="{Binding LogoutCommand}">
                      <TextBlock Text="Kijelentkezés" FontSize="14" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Panel>

        </Panel>
      </Panel>

      <!-- ROW 4: MINI PLAYER BAR -->
      <Border Grid.Row="4"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0"
              Padding="16,10"
              IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
              x:Name="MiniPlayerBar">
        <Panel>
          <Button Classes="unstyled-card" Padding="0" Background="Transparent"
                  BorderThickness="0" Focusable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  x:Name="OpenFullPlayerBtn" />
          <Grid ColumnDefinitions="52, *, Auto, Auto, Auto">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6"
                    Background="{DynamicResource Surface2}" ClipToBounds="True">
              <Panel>
                <Image Source="{Binding Player.CoverBitmap}" Stretch="UniformToFill"
                       IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <material:MaterialIcon Kind="MusicNote" Width="20" Height="20"
                                       Foreground="{DynamicResource PrimaryAction}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Player.CurrentTrack.Title}"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMain}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Player.CurrentTrack.Artist}"
                         FontSize="12" Foreground="{DynamicResource TextMuted}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon"
                    Command="{Binding Player.PreviousTrackCommand}"
                    Width="40" Height="40">
              <material:MaterialIcon Kind="SkipPrevious" Width="22" Height="22" />
            </Button>
            <Button Grid.Column="3" Classes="primary" Width="40" Height="40"
                    CornerRadius="20" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding Player.TogglePlayPauseCommand}">
              <material:MaterialIcon Kind="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToIconConverter}}"
                                     Width="20" Height="20" />
            </Button>
            <Button Grid.Column="4" Classes="icon"
                    Command="{Binding Player.NextTrackCommand}"
                    Width="40" Height="40">
              <material:MaterialIcon Kind="SkipNext" Width="22" Height="22" />
            </Button>
          </Grid>
        </Panel>
      </Border>

      <!-- ROW 5: BOTTOM NAV BAR -->
      <Border Grid.Row="5"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*, *, *, *, *" Height="62">
          <Button Grid.Column="0" Classes="unstyled-card"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
              <material:MaterialIcon Kind="AccountMusicOutline" Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding SelectedNavigationIndex, ConverterParameter=2, Converter={StaticResource NavActiveTextConverter}}" />
              <TextBlock Text="Előadók" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding SelectedNavigationIndex, ConverterParameter=2, Converter={StaticResource NavActiveTextConverter}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="unstyled-card"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
              <material:MaterialIcon Kind="Album" Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding SelectedNavigationIndex, ConverterParameter=1, Converter={StaticResource NavActiveTextConverter}}" />
              <TextBlock Text="Albumok" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding SelectedNavigationIndex, ConverterParameter=1, Converter={StaticResource NavActiveTextConverter}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="unstyled-card"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
              <material:MaterialIcon Kind="MusicNoteOutline" Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding SelectedNavigationIndex, ConverterParameter=0, Converter={StaticResource NavActiveTextConverter}}" />
              <TextBlock Text="Számok" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding SelectedNavigationIndex, ConverterParameter=0, Converter={StaticResource NavActiveTextConverter}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="unstyled-card"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="4">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
              <material:MaterialIcon Kind="Heart" Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding SelectedNavigationIndex, ConverterParameter=4, Converter={StaticResource NavActiveTextConverter}}" />
              <TextBlock Text="Kedvencek" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding SelectedNavigationIndex, ConverterParameter=4, Converter={StaticResource NavActiveTextConverter}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="unstyled-card"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
              <material:MaterialIcon Kind="CogOutline" Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding SelectedNavigationIndex, ConverterParameter=5, Converter={StaticResource NavActiveTextConverter}}" />
              <TextBlock Text="Beállítások" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding SelectedNavigationIndex, ConverterParameter=5, Converter={StaticResource NavActiveTextConverter}}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

    </Grid>

    <!-- FULL-SCREEN NOW PLAYING SHEET -->
    <Border x:Name="NowPlayingSheet"
            Background="{DynamicResource AppBackground}"
            IsVisible="False"
            VerticalAlignment="Stretch">
      <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto, Auto">
        <!-- Back button -->
        <Button Grid.Row="0" Classes="icon" HorizontalAlignment="Left"
                Margin="12,12,0,0"
                x:Name="CloseFullPlayerBtn">
          <material:MaterialIcon Kind="ChevronDown" Width="28" Height="28" />
        </Button>
        <!-- Cover art -->
        <Border Grid.Row="1" HorizontalAlignment="Center"
                Width="280" Height="280" CornerRadius="16" Margin="0,8,0,0"
                Background="{DynamicResource Surface2}" ClipToBounds="True">
          <Panel>
            <Image Source="{Binding Player.CoverBitmap}" Stretch="UniformToFill"
                   IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <material:MaterialIcon Kind="MusicNote" Width="100" Height="100"
                                   Foreground="{DynamicResource PrimaryAction}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Player.CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
          </Panel>
        </Border>
        <!-- Track info + fav -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="24,16,24,4"
              VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding Player.CurrentTrack.Title}"
                       FontSize="22" FontWeight="Black"
                       Foreground="{DynamicResource TextMain}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Player.CurrentTrack.Artist}"
                       FontSize="16" Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon"
                  Command="{Binding Player.ToggleFavoriteCurrentCommand}"
                  VerticalAlignment="Center">
            <material:MaterialIcon Kind="{Binding Player.CurrentTrack.IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                   Width="26" Height="26"
                                   Foreground="{Binding Player.CurrentTrack.IsFavorite, Converter={StaticResource FavoriteColorConverter}}" />
          </Button>
        </Grid>
        <!-- Spacer -->
        <Panel Grid.Row="3" />
        <!-- Seek slider -->
        <Grid Grid.Row="4" RowDefinitions="Auto, Auto" Margin="24,0">
          <Slider Grid.Row="0"
                  Minimum="0" Maximum="{Binding Player.DurationSeconds}"
                  Value="{Binding Player.PositionSeconds, Mode=TwoWay}" />
          <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <TextBlock Grid.Column="0" Text="{Binding Player.FormattedPosition}"
                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Grid.Column="1" Text="{Binding Player.FormattedDuration}"
                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Right" />
          </Grid>
        </Grid>
        <!-- Playback controls -->
        <Grid Grid.Row="5" ColumnDefinitions="*, *, *, *, *" Margin="8,12">
          <Button Grid.Column="0" Classes="icon" HorizontalAlignment="Center"
                  Command="{Binding Player.ToggleShuffleCommand}">
            <material:MaterialIcon Kind="Shuffle" Width="24" Height="24"
                                   Foreground="{Binding Player.IsShuffle, Converter={StaticResource ActiveControlBrushConverter}}" />
          </Button>
          <Button Grid.Column="1" Classes="icon" HorizontalAlignment="Center"
                  Command="{Binding Player.PreviousTrackCommand}">
            <material:MaterialIcon Kind="SkipPrevious" Width="30" Height="30" />
          </Button>
          <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Center"
                  Width="60" Height="60" CornerRadius="30" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding Player.TogglePlayPauseCommand}">
            <material:MaterialIcon Kind="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToIconConverter}}"
                                   Width="28" Height="28" />
          </Button>
          <Button Grid.Column="3" Classes="icon" HorizontalAlignment="Center"
                  Command="{Binding Player.NextTrackCommand}">
            <material:MaterialIcon Kind="SkipNext" Width="30" Height="30" />
          </Button>
          <Button Grid.Column="4" Classes="icon" HorizontalAlignment="Center"
                  Command="{Binding Player.ToggleRepeatCommand}">
            <material:MaterialIcon Kind="{Binding Player.RepeatMode, Converter={StaticResource RepeatModeToIconConverter}}"
                                   Width="24" Height="24"
                                   Foreground="{Binding Player.RepeatMode, Converter={StaticResource ActiveControlBrushConverter}}" />
          </Button>
        </Grid>
        <!-- Quality badge -->
        <Border Grid.Row="6" HorizontalAlignment="Center" Margin="0,4,0,16">
          <Border Background="{DynamicResource TagBackground}" CornerRadius="6" Padding="10,4">
            <TextBlock Text="{Binding Player.QualityBadge}"
                       FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource PrimaryAction}" />
          </Border>
        </Border>
      </Grid>
    </Border>

    <!-- LOGIN VIEW OVERLAY -->
    <Border IsVisible="{Binding IsLoginViewActive}"
            Background="{DynamicResource AppBackground}">
      <ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="360" Spacing="20" Margin="24,60,24,24">
          <material:MaterialIcon Kind="MusicCircle" Width="80" Height="80"
                                 Foreground="{DynamicResource PrimaryAction}"
                                 HorizontalAlignment="Center" />
          <TextBlock Text="WIRETUNE" FontSize="28" FontWeight="Black"
                     LetterSpacing="2.5" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="Streamer &amp; Player" FontSize="14"
                     Foreground="{DynamicResource TextMuted}"
                     HorizontalAlignment="Center" />

          <!-- STEP 1: Server URL + Connect -->
          <Border Classes="glass" Padding="20" CornerRadius="14" Margin="0,16,0,0"
                  IsVisible="{Binding !ServerSettings.IsServerReachable}">
            <StackPanel Spacing="14">
              <TextBlock Text="Szerver URL" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMuted}" />
              <TextBox Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}"
                       Watermark="http://192.168.1.x:5200" Height="44" />
              <TextBlock Text="{Binding ServerSettings.StatusMessage}"
                         FontSize="12" Foreground="{DynamicResource DangerColor}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ServerSettings.IsServerOffline}" />
              <Button Classes="primary" Height="48" HorizontalAlignment="Stretch"
                      Command="{Binding ServerSettings.ConnectServerCommand}"
                      IsEnabled="{Binding !ServerSettings.IsConnecting}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <material:MaterialIcon Kind="LanConnect" Width="20" Height="20" />
                  <TextBlock Text="{Binding ServerSettings.IsConnecting, Converter={x:Static ObjectConverters.IsNotNull}}"
                             FontWeight="Bold" FontSize="15"
                             IsVisible="False" />
                  <TextBlock Text="Csatlakozás" FontWeight="Bold" FontSize="15"
                             IsVisible="{Binding !ServerSettings.IsConnecting}" />
                  <TextBlock Text="Kapcsolódás..." FontWeight="Bold" FontSize="15"
                             IsVisible="{Binding ServerSettings.IsConnecting}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Height="44" HorizontalAlignment="Stretch"
                      Command="{Binding ContinueOfflineCommand}">
                <TextBlock Text="Folytatás offline" FontSize="14" />
              </Button>
            </StackPanel>
          </Border>

          <!-- STEP 2: Login form (shown after server is reachable) -->
          <Border Classes="glass" Padding="20" CornerRadius="14" Margin="0,16,0,0"
                  IsVisible="{Binding ServerSettings.IsServerReachable}">
            <StackPanel Spacing="14">
              <!-- Server reachable indicator -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="CheckCircle" Width="18" Height="18"
                                       Foreground="#4CAF50" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ServerSettings.ServerUrl}"
                           FontSize="13" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <!-- Setup admin (first-time) -->
              <StackPanel Spacing="12" IsVisible="{Binding ServerSettings.IsSetupRequired}">
                <TextBlock Text="Első indítás — hozd létre az admin fiókot"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" />
                <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}"
                         Watermark="Felhasználónév" Height="44" />
                <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}"
                         Watermark="{Binding ServerSettings.PasswordHint}"
                         PasswordChar="•" Height="44" />
                <Button Classes="primary" Height="48" HorizontalAlignment="Stretch"
                        Command="{Binding ServerSettings.SetupAdminCommand}"
                        IsEnabled="{Binding !ServerSettings.IsAuthenticating}">
                  <TextBlock Text="Admin fiók létrehozása" FontWeight="Bold" FontSize="15" />
                </Button>
              </StackPanel>

              <!-- Normal login -->
              <StackPanel Spacing="12" IsVisible="{Binding !ServerSettings.IsSetupRequired}">
                <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}"
                         Watermark="Felhasználónév" Height="44" />
                <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}"
                         Watermark="Jelszó" PasswordChar="•" Height="44" />
                <TextBlock Text="{Binding ServerSettings.AuthErrorMessage}"
                           FontSize="12" Foreground="{DynamicResource DangerColor}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ServerSettings.HasAuthError}" />
                <Button Classes="primary" Height="48" HorizontalAlignment="Stretch"
                        Command="{Binding ServerSettings.LoginCommand}"
                        IsEnabled="{Binding !ServerSettings.IsAuthenticating}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Bejelentkezés" FontWeight="Bold" FontSize="15"
                               IsVisible="{Binding !ServerSettings.IsAuthenticating}" />
                    <TextBlock Text="Bejelentkezés..." FontWeight="Bold" FontSize="15"
                               IsVisible="{Binding ServerSettings.IsAuthenticating}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Button Classes="secondary" Height="44" HorizontalAlignment="Stretch"
                      Command="{Binding ContinueOfflineCommand}">
                <TextBlock Text="Folytatás offline" FontSize="14" />
              </Button>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Border>

  </Panel>
</UserControl>
