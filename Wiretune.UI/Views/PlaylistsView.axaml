<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.PlaylistsView"
             x:DataType="vm:MainViewModel">

  <!-- The Playlists tab: the playlist grid and the playlist detail page. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding SelectedSection, ConverterParameter={x:Static vm:AppSection.Playlists}, Converter={StaticResource IntEqualConverter}}">

    <!-- Subview 1: Playlists Cards Grid (when no playlist detail open) -->
    <Grid Classes="page" RowDefinitions="Auto, *" IsVisible="{Binding !Playlists.IsPlaylistDetailOpen}">
      <!-- Tab Header / Actions -->
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{loc:T NavPlaylists}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="lime" Height="38" CornerRadius="6" Command="{Binding Playlists.OpenCreateDialogCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource PrimaryActionForeground}" />
            <TextBlock Text="{loc:T PlaylistNew}" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionForeground}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Empty state: no playlists yet -->
      <StackPanel Classes="page" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32"
                  IsVisible="{Binding !Playlists.HasPlaylists}">
        <material:MaterialIcon Kind="PlaylistMusicOutline" Width="64" Height="64" Foreground="{DynamicResource LimeAccent}" HorizontalAlignment="Center" />
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <TextBlock Text="{loc:T EmptyPlaylistsTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:T EmptyPlaylistsHint}"
                      FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        </StackPanel>
      </StackPanel>

      <!-- Playlists Cards Grid (210x270 tiles matching Albums and Artists) -->
      <ScrollViewer Grid.Row="1" Margin="-10,0,0,0" Padding="10,8,0,0" ClipToBounds="False" IsVisible="{Binding Playlists.HasPlaylists}">
        <ItemsControl ItemsSource="{Binding Playlists.DisplayedPlaylists}" ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PlaylistCardViewModel">
              <Button Classes="unstyled-card"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.OpenPlaylistCommand}"
                      CommandParameter="{Binding}"
                      Margin="0,6,18,12">
                <Border Classes="metric-card lime" Width="210" Height="270">
                  <Grid RowDefinitions="150, *, Auto">
                    <!-- Playlist 2x2 Covers Collage (4 smaller covers taking up 1 whole cover size) -->
                    <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Surface2}" ClipToBounds="True">
                      <Panel>
                        <!-- Fallback placeholder icon if no covers are available -->
                        <material:MaterialIcon Kind="PlaylistMusic" Foreground="{DynamicResource LimeAccent}" Width="64" Height="64"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasCovers}" />

                        <!-- Single cover taking up the whole 150px cover if only 1 album available -->
                        <controls:CoverImage SourcePath="{Binding SingleCoverPath}"
                                             DecodeWidth="210"
                                             Stretch="UniformToFill"
                                             IsVisible="{Binding HasSingleCover}" />

                        <!-- 2x2 Collage: 4 smaller covers taking up 1 whole cover size -->
                        <UniformGrid Rows="2" Columns="2" IsVisible="{Binding HasMultipleCovers}">
                          <controls:CoverImage SourcePath="{Binding Cover0}" DecodeWidth="105" Stretch="UniformToFill" />
                          <controls:CoverImage SourcePath="{Binding Cover1}" DecodeWidth="105" Stretch="UniformToFill" />
                          <controls:CoverImage SourcePath="{Binding Cover2}" DecodeWidth="105" Stretch="UniformToFill" />
                          <controls:CoverImage SourcePath="{Binding Cover3}" DecodeWidth="105" Stretch="UniformToFill" />
                        </UniformGrid>
                      </Panel>
                    </Border>

                    <!-- Title & Track Count -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMain}" />
                      <TextBlock Text="{loc:TFormat TrackCount, Path=TrackCount}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Badges & Action Buttons -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,8,0,0">
                      <Border Grid.Column="0" Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                              IsVisible="{Binding FormatBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Black" Foreground="{Binding FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
                      </Border>
                      <Button Grid.Column="2" Classes="lime"
                              Width="32" Height="32"
                              CornerRadius="6"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              IsEnabled="{Binding TrackCount}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayPlaylistCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{loc:T Play}">
                        <material:MaterialIcon Kind="Play" Foreground="{DynamicResource PrimaryActionForeground}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Grid>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Subview 2: Playlist Detail View (Tracklist & Controls) -->
    <Grid Classes="page" RowDefinitions="Auto, Auto, *" IsVisible="{Binding Playlists.IsPlaylistDetailOpen}">
      <!-- Back Button -->
      <Button Grid.Row="0" Classes="secondary" Height="36" Padding="14,0" Margin="0,0,0,16"
              HorizontalAlignment="Left"
              Command="{Binding Playlists.ClosePlaylistDetailCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" />
          <TextBlock Text="{loc:T BackToPlaylists}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Playlist Hero Banner -->
      <Border Grid.Row="1" Classes="glass lime" Margin="0,0,0,20">
        <Grid ColumnDefinitions="140, *">
          <!-- Artwork (Displays collage / single cover / fallback) -->
          <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
            <Panel>
              <!-- Fallback placeholder icon if no covers are available -->
              <material:MaterialIcon Kind="PlaylistMusic" Foreground="{DynamicResource LimeAccent}" Width="64" Height="64"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !Playlists.SelectedPlaylistCard.HasCovers}" />

              <!-- Single cover taking up the whole 120px cover if only 1 album available -->
              <controls:CoverImage SourcePath="{Binding Playlists.SelectedPlaylistCard.SingleCoverPath}"
                                   DecodeWidth="180"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding Playlists.SelectedPlaylistCard.HasSingleCover}" />

              <!-- 2x2 Collage: 4 smaller covers taking up 1 whole cover size -->
              <UniformGrid Rows="2" Columns="2" IsVisible="{Binding Playlists.SelectedPlaylistCard.HasMultipleCovers}">
                <controls:CoverImage SourcePath="{Binding Playlists.SelectedPlaylistCard.Cover0}" DecodeWidth="90" Stretch="UniformToFill" />
                <controls:CoverImage SourcePath="{Binding Playlists.SelectedPlaylistCard.Cover1}" DecodeWidth="90" Stretch="UniformToFill" />
                <controls:CoverImage SourcePath="{Binding Playlists.SelectedPlaylistCard.Cover2}" DecodeWidth="90" Stretch="UniformToFill" />
                <controls:CoverImage SourcePath="{Binding Playlists.SelectedPlaylistCard.Cover3}" DecodeWidth="90" Stretch="UniformToFill" />
              </UniformGrid>
            </Panel>
          </Border>

          <!-- Meta & Actions -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2">
                <TextBlock Text="{loc:T LabelPlaylist}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource LimeAccent}" />
              </Border>
              <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2"
                      IsVisible="{Binding Playlists.SelectedPlaylist.FormatBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Playlists.SelectedPlaylist.FormatBadge}" FontSize="10" FontWeight="Black" Foreground="{Binding Playlists.SelectedPlaylist.FormatBadge, Converter={StaticResource QualityBadgeColorConverter}}" />
              </Border>
            </StackPanel>

            <!-- Playlist Title (Click to rename) -->
            <Button Classes="table-link title"
                    Command="{Binding Playlists.StartRenameCommand}"
                    IsVisible="{Binding !Playlists.IsEditingName}"
                    HorizontalAlignment="Left"
                    Padding="0"
                    ToolTip.Tip="{loc:T TipRename}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Playlists.SelectedPlaylist.Name}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
                <material:MaterialIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Inline Editing Mode -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Playlists.IsEditingName}">
              <TextBox Text="{Binding Playlists.EditingPlaylistName, Mode=TwoWay}"
                       FontSize="18" FontWeight="Black"
                       MinWidth="240" MaxWidth="400"
                       VerticalAlignment="Center">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding Playlists.ConfirmRenamePlaylistCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding Playlists.CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Classes="lime" Height="36" Width="36" Padding="0" CornerRadius="6"
                      Command="{Binding Playlists.ConfirmRenamePlaylistCommand}"
                      ToolTip.Tip="{loc:T Save}">
                <material:MaterialIcon Kind="Check" Width="18" Height="18" Foreground="{DynamicResource PrimaryActionForeground}" />
              </Button>
              <Button Classes="secondary" Height="36" Width="36" Padding="0" CornerRadius="6"
                      Command="{Binding Playlists.CancelRenameCommand}"
                      ToolTip.Tip="{loc:T Cancel}">
                <material:MaterialIcon Kind="Close" Width="18" Height="18" />
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{loc:TFormat TrackCount, Path=Playlists.SelectedPlaylist.TrackCount}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsVisible="{Binding !Playlists.IsSelectedPlaylistEmpty}" />
              <TextBlock Text="{Binding Playlists.SelectedPlaylistTotalDuration}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsVisible="{Binding !Playlists.IsSelectedPlaylistEmpty}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
              <Button Classes="lime" Height="38" CornerRadius="6" Padding="18,8"
                      IsEnabled="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                      Command="{Binding Playlists.PlayPlaylistCommand}"
                      CommandParameter="{Binding Playlists.SelectedPlaylist}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{DynamicResource PrimaryActionForeground}" />
                  <TextBlock Text="{loc:T Play}" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionForeground}" />
                </StackPanel>
              </Button>

              <Button Classes="secondary" Height="38" CornerRadius="6" Padding="18,8"
                      IsEnabled="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                      Command="{Binding Playlists.ShufflePlaylistCommand}"
                      CommandParameter="{Binding Playlists.SelectedPlaylist}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Shuffle" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" />
                  <TextBlock Text="{loc:T Shuffle}" FontWeight="Bold" />
                </StackPanel>
              </Button>

              <Button Classes="secondary" Height="38" CornerRadius="6" Padding="14,0"
                      Command="{Binding Playlists.RequestDeletePlaylistCommand}"
                      CommandParameter="{Binding Playlists.SelectedPlaylist}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource DangerColor}" />
                  <TextBlock Text="{loc:T PlaylistDeleteAction}" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tracklist or Empty State -->
      <Border Grid.Row="2" Classes="glass lime" Padding="0" ClipToBounds="True">
        <Panel>
          <!-- Empty Playlist Placeholder -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="32"
                      IsVisible="{Binding Playlists.IsSelectedPlaylistEmpty}">
            <material:MaterialIcon Kind="MusicNotePlus" Width="54" Height="54" Foreground="{DynamicResource LimeAccent}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T PlaylistEmptyTitle}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T PlaylistEmptyHint}"
                       FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Playlist Tracks DataGrid -->
          <DataGrid ItemsSource="{Binding Playlists.SelectedPlaylistTracks}"
                    IsVisible="{Binding !Playlists.IsSelectedPlaylistEmpty}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <!-- Cover (Clickable to play track) -->
              <DataGridTemplateColumn Width="50" Header="">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="models:Track">
                    <Button Classes="unstyled-cover"
                            Classes.playing="{Binding IsPlaying}"
                            controls:RowPressSync.SyncWithTitle="True"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayTrackCommand}"
                            CommandParameter="{Binding}">
                      <Border Width="32" Height="32"
                              CornerRadius="4"
                              Background="{DynamicResource Surface2}"
                              ClipToBounds="True"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <Panel>
                          <material:MaterialIcon Kind="MusicNote"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 Width="16" Height="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                          <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                               DecodeWidth="64"
                                               Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Title (Clickable to play track) -->
              <DataGridTemplateColumn Header="{loc:T ColTitle}" Width="2*" SortMemberPath="Title">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="models:Track">
                    <Button Classes="table-link title"
                            Classes.playing="{Binding IsPlaying}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.PlayTrackCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Artist (Clickable to open Artist page) -->
              <DataGridTemplateColumn Header="{loc:T ColArtist}" Width="1.5*" SortMemberPath="Artist" CellTemplate="{StaticResource TrackArtistLinkCell}" />

              <!-- Album (Clickable to open Album page) -->
              <DataGridTemplateColumn Header="{loc:T ColAlbum}" Width="1.5*" SortMemberPath="Album" CellTemplate="{StaticResource TrackAlbumLinkCell}" />

              <!-- Audio Format / Quality Badge -->
              <DataGridTemplateColumn Header="{loc:T ColQuality}" Width="185" SortMemberPath="Format.DisplayBadge" CellTemplate="{StaticResource TrackQualityCell}" />

              <!-- Duration -->
              <DataGridTextColumn Header="{loc:T ColLength}" Binding="{Binding FormattedDuration}" Width="105" SortMemberPath="Duration" />

              <!-- Favorite Heart Button -->
              <DataGridTemplateColumn Width="44" Header="" SortMemberPath="IsFavorite">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="models:Track">
                    <Button Classes="icon"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:T TipFavorite}">
                      <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                             Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                             Width="18" Height="18" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Remove from playlist -->
              <DataGridTemplateColumn Width="44" Header="">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="models:Track">
                    <Button Classes="icon" ToolTip.Tip="{loc:T TipRemoveFromPlaylist}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Playlists.RemoveTrackFromSelectedCommand}"
                            CommandParameter="{Binding}">
                      <material:MaterialIcon Kind="PlaylistRemove" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Panel>
      </Border>
    </Grid>
  </Grid>

</UserControl>
