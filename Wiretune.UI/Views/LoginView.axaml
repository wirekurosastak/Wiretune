<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.LoginView"
             x:DataType="vm:MainViewModel">

  <!-- The full-screen sign-in and first-run setup page. Binds to MainViewModel (inherited). -->
  <Grid Classes="login-view" IsVisible="{Binding IsLoginViewActive}"
        Background="{DynamicResource WindowGradient}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="glass view-accent login-card"
              Width="500"
              MaxWidth="{Binding $parent[ScrollViewer].Bounds.Width}"
              CornerRadius="16"
              Padding="32,28"
              Margin="16,24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <TranslateTransform />
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="20">

          <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8" Margin="24,0,0,0">
              <controls:NavVisualizerControl Width="52" Height="38"
                                             HorizontalAlignment="Center"
                                             WaveTrigger="{Binding WaveTrigger}"
                                             WaveDirection="{Binding LastWaveDirection}"
                                             AccentBrush="{DynamicResource PrimaryAction}"
                                             IsPlaying="{Binding Player.PlaybackState, Converter={StaticResource PlayStateToBoolConverter}}"
                                             ToolTip.Tip="Wiretune Streamer Visualizer" />
              <TextBlock Text="WIRETUNE" FontSize="26" FontWeight="Black" LetterSpacing="3.0" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
              <TextBlock Text="STREAMER &amp; PLAYER" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource PrimaryAction}" HorizontalAlignment="Center">
                <TextBlock.Transitions>
                  <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.35" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" Command="{Binding ContinueOfflineCommand}" VerticalAlignment="Top" ToolTip.Tip="{loc:T TipCloseToPlayer}">
              <material:MaterialIcon Kind="Close" Width="20" Height="20" />
            </Button>
          </Grid>

          <!-- Logged in -->
          <StackPanel Classes="page" Spacing="16" IsVisible="{Binding ServerSettings.IsLoggedIn}">
            <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <material:MaterialIcon Kind="AccountCheck" Width="40" Height="40" Foreground="{DynamicResource LimeAccent}" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ServerSettings.CurrentUserName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                    <TextBlock Text="{Binding ServerSettings.CurrentUserRole}" FontSize="12" Foreground="{DynamicResource LimeAccent}" FontWeight="SemiBold" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, *">
              <Button Grid.Column="0" Classes="secondary" Command="{Binding LogoutCommand}" Height="42" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Logout" Width="18" Height="18" Foreground="{DynamicResource DangerColor}" />
                  <TextBlock Text="{loc:T SignOut}" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="primary" Command="{Binding ContinueOfflineCommand}" Height="42" Margin="6,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="MusicBox" Width="18" Height="18" />
                  <TextBlock Text="{loc:T BackToMusic}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <!-- Not logged in -->
          <StackPanel Classes="page" Spacing="16" IsVisible="{Binding !ServerSettings.IsLoggedIn}">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:T ServerAddressLabel}" Classes="group-title" Margin="2,0,0,0" />
              <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Text="{Binding ServerSettings.ServerUrl, Mode=TwoWay}" Watermark="http://192.168.1.10:5200" Height="40" Margin="0,0,8,0">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.ConnectServerCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="secondary" Command="{Binding ServerSettings.ConnectServerCommand}" IsEnabled="{Binding !ServerSettings.IsConnecting}"
                        Height="40" Padding="14,0" ToolTip.Tip="{loc:T TipCheckConnection}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <material:MaterialIcon Kind="ServerNetwork" Width="16" Height="16" Foreground="{DynamicResource CyanAccent}" />
                    <TextBlock Text="{loc:T Connect}" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
              </Grid>
              <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource CyanAccent}" IsVisible="{Binding ServerSettings.IsBusy}" />
              <TextBlock Text="{Binding ServerSettings.StatusMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="#20FFB703" BorderBrush="#FFB703" BorderThickness="1" CornerRadius="8" Padding="12,10"
                    IsVisible="{Binding ServerSettings.IsServerOffline}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="ServerOff" Width="18" Height="18" Foreground="#FFB703" VerticalAlignment="Top" />
                <TextBlock Text="{loc:T ServerUnreachableHint}"
                           FontSize="12" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" MaxWidth="380" />
              </StackPanel>
            </Border>

            <!-- First-run administrator setup -->
            <StackPanel Spacing="12" IsVisible="{Binding ServerSettings.IsSetupRequired}">
              <Border Background="#28FFB703" BorderBrush="#FFB703" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="ShieldAlertOutline" Width="18" Height="18" Foreground="#FFB703" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:T FirstRun}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{loc:T FirstRunHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBox Text="{Binding ServerSettings.SetupCode, Mode=TwoWay}" Watermark="{loc:T SetupCodePlaceholder}" Height="40" />
              <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}" Watermark="{loc:T AdminUsernamePlaceholder}" Height="40" />
              <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}" Watermark="{Binding ServerSettings.PasswordHint}" PasswordChar="•" Height="40">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.SetupAdminCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <Button Classes="primary" Command="{Binding ServerSettings.SetupAdminCommand}" IsEnabled="{Binding !ServerSettings.IsAuthenticating}"
                      Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="ShieldAccount" Width="18" Height="18" />
                  <TextBlock Text="{loc:T CreateAdminAndSignIn}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Sign in -->
            <StackPanel Spacing="12" IsVisible="{Binding !ServerSettings.IsSetupRequired}">
              <TextBox Text="{Binding ServerSettings.Username, Mode=TwoWay}" Watermark="{loc:T UsernamePlaceholder}" Height="40" />
              <TextBox Text="{Binding ServerSettings.Password, Mode=TwoWay}" Watermark="{loc:T PasswordPlaceholder}" PasswordChar="•" Height="40">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding ServerSettings.LoginCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <CheckBox IsChecked="{Binding ServerSettings.StayLoggedIn, Mode=TwoWay}"
                        Content="{loc:T StaySignedIn}"
                        FontSize="12"
                        Foreground="{DynamicResource TextMain}" />

              <Button Classes="primary" Command="{Binding ServerSettings.LoginCommand}" IsEnabled="{Binding !ServerSettings.IsAuthenticating}"
                      Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="Login" Width="18" Height="18" />
                  <TextBlock Text="{loc:T SignIn}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Border Background="#28FF003C" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding ServerSettings.HasAuthError}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerColor}" Width="16" Height="16" VerticalAlignment="Top" />
                <TextBlock Text="{Binding ServerSettings.AuthErrorMessage}" Foreground="{DynamicResource DangerColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="380" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, Auto, *" Margin="0,4">
              <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource GlassBorder}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{loc:T Or}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="12,0" VerticalAlignment="Center" />
              <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource GlassBorder}" VerticalAlignment="Center" />
            </Grid>

            <Button Classes="secondary" Command="{Binding ContinueOfflineCommand}" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="FolderMusicOutline" Width="18" Height="18" Foreground="{DynamicResource LimeAccent}" />
                <TextBlock Text="{loc:T ContinueWithoutServer}" FontWeight="SemiBold" FontSize="13" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>

</UserControl>
