<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:controls="using:Wiretune.UI.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.Views.SearchResultsView"
             x:DataType="vm:MainViewModel">

  <!-- The search results that replace the tabs while a search is active. Binds to MainViewModel (inherited). -->
  <Grid Classes="page" IsVisible="{Binding IsSearchActive}" RowDefinitions="Auto, *">

    <!-- Search Results Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{loc:T SearchResultsFor}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextMain}" />
          <TextBlock Text="{loc:TFormat QuotedText, Path=Search.Query}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryAction}" />
        </StackPanel>
        <TextBlock Text="{loc:T SearchSubtitle}" FontSize="13" Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
    </Grid>

    <!-- Search Results Content (Scrollable) -->
    <ScrollViewer Grid.Row="1" Margin="-10,0,0,0" Padding="10,8,0,0" ClipToBounds="False">
      <StackPanel Spacing="28">

        <!-- Empty State when no results found -->
        <Border Classes="glass" Padding="40" HorizontalAlignment="Center" Margin="0,40,0,0" IsVisible="{Binding !Search.HasResults}">
          <StackPanel HorizontalAlignment="Center" Spacing="14">
            <material:MaterialIcon Kind="MagnifyClose" Width="56" Height="56" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T NoResultsTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T NoResultsHint}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- SECTION: BEST MATCH (LEGJOBB TALÁLAT) + TOP TRACKS (TIDAL LAYOUT) -->
        <Grid ColumnDefinitions="340, *" Margin="0,0,0,8" IsVisible="{Binding Search.BestMatch, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- Left: Hero Best Match Card -->
          <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,24,0">
            <TextBlock Text="{loc:T BestMatch}" Classes="group-title" Margin="0,0,0,4" />
            <Border Classes="glass view-accent" Padding="20" CornerRadius="8">
              <StackPanel Spacing="14">
                <Panel>
                  <StackPanel Spacing="14">
                    <Border Width="110" Height="110" CornerRadius="8" Background="{DynamicResource Surface2}" HorizontalAlignment="Left" ClipToBounds="True">
                      <Panel>
                        <Image Source="{Binding Search.BestMatch.CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding Search.BestMatch.HasCover}" />
                        <material:MaterialIcon Kind="{Binding Search.BestMatch.IconKind}" Foreground="{Binding Search.BestMatch.TypeBrush}" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Search.BestMatch.HasCover}" />
                      </Panel>
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Left">
                      <Border Background="{DynamicResource TagBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Search.BestMatch.TypeLabel}" FontSize="10" FontWeight="Black" Foreground="{Binding Search.BestMatch.TypeBrush}" />
                      </Border>
                      <TextBlock Text="{Binding Search.BestMatch.Title}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Search.BestMatch.Subtitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Search.BestMatch.Meta}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>

                  <!-- Transparent click overlay: only exists for album/artist matches, so a song card has no button visuals at all -->
                  <Button Classes="unstyled-card" Padding="0" Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Command="{Binding Search.BestMatch.OpenCommand}"
                          IsVisible="{Binding Search.BestMatch.CanOpen}" />
                </Panel>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <!-- Square Play Button: 36x36 -->
                  <Button Classes="primary" Width="36" Height="36" CornerRadius="4" Padding="0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          Command="{Binding Search.BestMatch.PlayCommand}" ToolTip.Tip="{loc:T Play}">
                    <material:MaterialIcon Kind="Play" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Right: Matching Tracks (Top Tracks) -->
          <StackPanel Grid.Column="1" Spacing="10" IsVisible="{Binding Search.HasTracks}">
            <TextBlock Text="{loc:T LabelTracks}" Classes="group-title" Margin="0,0,0,4" />
            <Border Classes="glass view-accent" Padding="0" ClipToBounds="True">
              <DataGrid ItemsSource="{Binding Search.MatchingTracks}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True"
                        MaxHeight="360"
                        GridLinesVisibility="Horizontal"
                        HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <!-- Cover (Clickable to play track) -->
                  <DataGridTemplateColumn Width="50" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="models:Track">
                        <Button Classes="unstyled-cover"
                                Classes.playing="{Binding IsPlaying}"
                                controls:RowPressSync.SyncWithTitle="True"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.PlayTrackCommand}"
                                CommandParameter="{Binding}">
                          <Border Width="32" Height="32"
                                  CornerRadius="4"
                                  Background="{DynamicResource Surface2}"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <Panel>
                              <material:MaterialIcon Kind="MusicNote"
                                                     Foreground="{DynamicResource TextMuted}"
                                                     Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                              <controls:CoverImage SourcePath="{Binding CoverArtPath}"
                                                   DecodeWidth="64"
                                                   Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <!-- Title (Clickable to play track) -->
                  <DataGridTemplateColumn Header="{loc:T ColTitle}" Width="2.5*" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="models:Track">
                        <Button Classes="table-link title"
                                Classes.playing="{Binding IsPlaying}"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.PlayTrackCommand}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="{loc:T ColArtist}" Width="2*" SortMemberPath="Artist" CellTemplate="{StaticResource TrackArtistLinkCell}" />

                  <DataGridTemplateColumn Header="{loc:T ColAlbum}" Width="2*" SortMemberPath="Album" CellTemplate="{StaticResource TrackAlbumLinkCell}" />

                  <DataGridTextColumn Header="{loc:T ColLength}" Binding="{Binding FormattedDuration}" Width="105" SortMemberPath="Duration" />

                  <!-- Favorite -->
                  <DataGridTemplateColumn Width="44" Header="" SortMemberPath="IsFavorite" CellTemplate="{StaticResource TrackFavoriteCell}" />
            <DataGridTemplateColumn Width="44" Header="" CellTemplate="{StaticResource TrackAddToPlaylistCell}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>
        </Grid>

        <!-- SECTION: MATCHING ARTISTS -->
        <StackPanel Spacing="12" IsVisible="{Binding Search.HasArtists}">
          <TextBlock Text="{loc:T LabelArtists}" Classes="group-title" Margin="4,0,0,0" />
          <ItemsControl ItemsSource="{Binding Search.MatchingArtists}" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:Artist">
                <controls:ArtistTileView
                  OpenCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenArtistCommand}"
                  PlayCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Artists.PlayArtistCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- SECTION: MATCHING ALBUMS -->
        <StackPanel Spacing="12" IsVisible="{Binding Search.HasAlbums}">
          <TextBlock Text="{loc:T LabelAlbums}" Classes="group-title" Margin="4,0,0,0" />
          <ItemsControl ItemsSource="{Binding Search.MatchingAlbums}" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:AlbumCardViewModel">
                <controls:AlbumTileView
                  OpenCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.OpenAlbumCommand}"
                  PlayCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Albums.PlayAlbumCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
