<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wiretune.UI.Converters"
             xmlns:loc="using:Wiretune.UI.Localization"
             xmlns:vm="using:Wiretune.UI.ViewModels"
             xmlns:models="using:Wiretune.Core.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Wiretune.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <conv:PlayStateToIconConverter x:Key="PlayStateToIconConverter" />
      <conv:PlayStateToBoolConverter x:Key="PlayStateToBoolConverter" />
      <conv:FavoriteIconConverter x:Key="FavoriteIconConverter" />
      <conv:FavoriteColorConverter x:Key="FavoriteColorConverter" />
      <conv:QualityBadgeColorConverter x:Key="QualityBadgeColorConverter" />
      <conv:ActiveControlBrushConverter x:Key="ActiveControlBrushConverter" />
      <conv:RepeatModeToIconConverter x:Key="RepeatModeToIconConverter" />
      <conv:IntEqualConverter x:Key="IntEqualConverter" />
      <conv:NavActiveBackgroundConverter x:Key="NavActiveBackgroundConverter" />
      <conv:BoolToAdminIconConverter x:Key="BoolToAdminIconConverter" />
      <conv:BoolToRoleTextConverter x:Key="BoolToRoleTextConverter" />

      <!--
        The cells of the track tables (DataGrid) that every table shows the same way; a table uses one as
        CellTemplate="{StaticResource TrackAlbumLinkCell}". Each cell finds the MainViewModel through the view it sits in
        ($parent[UserControl]), so it works in any view whose DataContext is the MainViewModel. Cells that differ from table
        to table (the cover and the title play the track of their own list) stay in the views. They sit here, next to the
        converters they use, so that the converters resolve from the same document.
      -->

      <DataTemplate x:Key="TrackArtistLinkCell" DataType="models:Track">
        <Button Classes="table-link artist"
                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenArtistByNameCommand}"
                CommandParameter="{Binding Artist}">
          <TextBlock Text="{Binding Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="TrackAlbumLinkCell" DataType="models:Track">
        <Button Classes="table-link album"
                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenAlbumCommand}"
                CommandParameter="{Binding}">
          <TextBlock Text="{Binding Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="TrackQualityCell" DataType="models:Track">
        <Border Background="{DynamicResource TagBackground}"
                CornerRadius="4"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Format.DisplayBadge}"
                     FontSize="10"
                     FontWeight="Black"
                     Foreground="{Binding Format, Converter={StaticResource QualityBadgeColorConverter}}" />
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TrackFavoriteCell" DataType="models:Track">
        <Button Classes="icon"
                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Tracks.ToggleFavoriteCommand}"
                CommandParameter="{Binding}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                      Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                      Width="18" Height="18" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="TrackAddToPlaylistCell" DataType="models:Track">
        <Button Classes="icon" ToolTip.Tip="{loc:T TipAddToPlaylist}"
                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToPlaylistCommand}"
                CommandParameter="{Binding}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" />
        </Button>
      </DataTemplate>

      <!-- Slider Dimensions & Spacing to Prevent Horizontal/Vertical Clipping -->
      <GridLength x:Key="SliderPreContentMargin">0</GridLength>
      <GridLength x:Key="SliderPostContentMargin">0</GridLength>
      <x:Double x:Key="SliderHorizontalHeight">32</x:Double>
      <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
      <CornerRadius x:Key="SliderThumbCornerRadius">9</CornerRadius>
      <x:Double x:Key="SliderHorizontalThumbWidth">18</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">18</x:Double>

      <!-- Fluent Slider Theme Accent Overrides to Prevent Blue Hover -->
      <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PrimaryActionColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#8BE0F5" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#4FB0C8" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PrimaryActionColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PrimaryActionColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#4FB0C8" />

      <!-- Dynamic Primary Action Brushes (Updated per active section tab by ThemeService) -->
      <SolidColorBrush x:Key="PrimaryAction" Color="#67C8E0" />
      <SolidColorBrush x:Key="PrimaryActionHover" Color="#8BE0F5" />
      <SolidColorBrush x:Key="PrimaryActionPressed" Color="#4FB0C8" />
      <SolidColorBrush x:Key="PrimaryActionForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TagBackground" Color="#1AFFFFFF" />
      <Color x:Key="PrimaryActionColor">#67C8E0</Color>

      <!-- Accent glow shadow (default; ThemeService swaps it with the section accent) -->
      <BoxShadows x:Key="PrimaryActionGlow">0 0 18 0 #6067C8E0</BoxShadows>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PrimaryActionForeground" Color="#FFFFFF" />
          <Color x:Key="AppBackgroundColor">#000000</Color>
          <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}" />
          <SolidColorBrush x:Key="Surface1" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="Surface2" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="TagBackground" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="GlassBackground" Color="#0CFFFFFF" />
          <SolidColorBrush x:Key="GlassBorder" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="GlassHighlight" Color="#2AFFFFFF" />

          <!-- Neon Audiophile Accents -->
          <Color x:Key="CoralAccentColor">#FF6B6B</Color>
          <Color x:Key="PurpleAccentColor">#D05CE3</Color>
          <Color x:Key="CyanAccentColor">#67C8E0</Color>
          <Color x:Key="LimeAccentColor">#AEEA00</Color>

          <SolidColorBrush x:Key="CoralAccent" Color="{DynamicResource CoralAccentColor}" />
          <SolidColorBrush x:Key="PurpleAccent" Color="{DynamicResource PurpleAccentColor}" />
          <SolidColorBrush x:Key="CyanAccent" Color="{DynamicResource CyanAccentColor}" />
          <SolidColorBrush x:Key="LimeAccent" Color="{DynamicResource LimeAccentColor}" />

          <!-- Section palette. ThemeService picks from it when the section changes: Tracks and Settings use the cyan
               family, Albums purple, Artists and Favorites coral, Playlists lime. Besides the accents above each family
               has a hover and a pressed shade, and each section tints the window gradient (the middle stop is shared). -->
          <Color x:Key="CyanAccentHoverColor">#8BE0F5</Color>
          <Color x:Key="CyanAccentPressedColor">#4FB0C8</Color>
          <Color x:Key="PurpleAccentHoverColor">#DF7DF0</Color>
          <Color x:Key="PurpleAccentPressedColor">#B835CD</Color>
          <Color x:Key="CoralAccentHoverColor">#FF8585</Color>
          <Color x:Key="CoralAccentPressedColor">#E05555</Color>
          <Color x:Key="LimeAccentHoverColor">#C2FF1A</Color>
          <Color x:Key="LimeAccentPressedColor">#95CA00</Color>
          <Color x:Key="WindowGradientMidColor">#000000</Color>
          <Color x:Key="WindowGradientTracksColor">#051522</Color>
          <Color x:Key="WindowGradientAlbumsColor">#1F0833</Color>
          <Color x:Key="WindowGradientArtistsColor">#2B0C0C</Color>
          <Color x:Key="WindowGradientPlaylistsColor">#142400</Color>
          <Color x:Key="WindowGradientFavoritesColor">#2B0C0C</Color>
          <Color x:Key="WindowGradientSettingsColor">#091824</Color>

          <SolidColorBrush x:Key="TextMain" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextMuted" Color="#8A8A8A" />
          <SolidColorBrush x:Key="TextDisabled" Color="#444444" />

          <SolidColorBrush x:Key="SuccessColor" Color="#00FF66" />
          <SolidColorBrush x:Key="WarningColor" Color="#FFC800" />
          <SolidColorBrush x:Key="DangerColor" Color="#FF003C" />
          <SolidColorBrush x:Key="ModalBackground" Color="#0A0A0A" />

          <Color x:Key="SystemAccentColor">#67C8E0</Color>
          <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#67C8E0" />
          <SolidColorBrush x:Key="HighlightBrush" Color="#67C8E0" />

          <BoxShadows x:Key="GlassHoverShadow">0 20 40 -10 #CC000000, 0 0 1 1 #15FFFFFF</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadow">0 25 50 -10 #FF000000, 0 0 1 1 #25FFFFFF</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowCoral">0 24 48 -10 #E6000000, 0 0 34 -8 #60FF6B6B</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowPurple">0 24 48 -10 #E6000000, 0 0 34 -8 #60D05CE3</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowCyan">0 24 48 -10 #E6000000, 0 0 34 -8 #6067C8E0</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowLime">0 24 48 -10 #E6000000, 0 0 34 -8 #60AEEA00</BoxShadows>

          <LinearGradientBrush x:Key="WindowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#051522" />
            <GradientStop Offset="0.5" Color="#000000" />
            <GradientStop Offset="1" Color="#142400" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PrimaryActionForeground" Color="#000000" />
          <Color x:Key="AppBackgroundColor">#F4F6F8</Color>
          <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}" />
          <SolidColorBrush x:Key="Surface1" Color="#1A000000" />
          <SolidColorBrush x:Key="Surface2" Color="#26000000" />
          <SolidColorBrush x:Key="TagBackground" Color="#1E232A" />
          <SolidColorBrush x:Key="GlassBackground" Color="#0D000000" />
          <SolidColorBrush x:Key="GlassBorder" Color="#20000000" />
          <SolidColorBrush x:Key="GlassHighlight" Color="#40000000" />

          <Color x:Key="CoralAccentColor">#D94A4A</Color>
          <Color x:Key="PurpleAccentColor">#A03BB5</Color>
          <Color x:Key="CyanAccentColor">#3A9FB8</Color>
          <Color x:Key="LimeAccentColor">#7FB800</Color>

          <SolidColorBrush x:Key="CoralAccent" Color="{DynamicResource CoralAccentColor}" />
          <SolidColorBrush x:Key="PurpleAccent" Color="{DynamicResource PurpleAccentColor}" />
          <SolidColorBrush x:Key="CyanAccent" Color="{DynamicResource CyanAccentColor}" />
          <SolidColorBrush x:Key="LimeAccent" Color="{DynamicResource LimeAccentColor}" />

          <!-- Section palette (see the dark theme). -->
          <Color x:Key="CyanAccentHoverColor">#52B3CC</Color>
          <Color x:Key="CyanAccentPressedColor">#2A8F98</Color>
          <Color x:Key="PurpleAccentHoverColor">#B848CF</Color>
          <Color x:Key="PurpleAccentPressedColor">#88289E</Color>
          <Color x:Key="CoralAccentHoverColor">#E85D5D</Color>
          <Color x:Key="CoralAccentPressedColor">#B83535</Color>
          <Color x:Key="LimeAccentHoverColor">#91CF05</Color>
          <Color x:Key="LimeAccentPressedColor">#6B9900</Color>
          <Color x:Key="WindowGradientMidColor">#EEF1F5</Color>
          <Color x:Key="WindowGradientTracksColor">#E8F7FC</Color>
          <Color x:Key="WindowGradientAlbumsColor">#F3E9FF</Color>
          <Color x:Key="WindowGradientArtistsColor">#FFECEC</Color>
          <Color x:Key="WindowGradientPlaylistsColor">#EEF9E6</Color>
          <Color x:Key="WindowGradientFavoritesColor">#FFECEC</Color>
          <Color x:Key="WindowGradientSettingsColor">#E8F7FC</Color>

          <SolidColorBrush x:Key="TextMain" Color="#111111" />
          <SolidColorBrush x:Key="TextMuted" Color="#888888" />
          <SolidColorBrush x:Key="TextDisabled" Color="#CCCCCC" />

          <SolidColorBrush x:Key="SuccessColor" Color="#10893E" />
          <SolidColorBrush x:Key="WarningColor" Color="#D83B01" />
          <SolidColorBrush x:Key="DangerColor" Color="#FF003C" />
          <SolidColorBrush x:Key="ModalBackground" Color="#FFFFFF" />

          <Color x:Key="SystemAccentColor">#3A9FB8</Color>
          <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#3A9FB8" />
          <SolidColorBrush x:Key="HighlightBrush" Color="#3A9FB8" />

          <BoxShadows x:Key="GlassHoverShadow">0 12 32 -8 #30000000</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadow">0 15 40 -10 #40000000</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowCoral">0 18 38 -10 #38000000, 0 0 30 -8 #40D94A4A</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowPurple">0 18 38 -10 #38000000, 0 0 30 -8 #40A03BB5</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowCyan">0 18 38 -10 #38000000, 0 0 30 -8 #403A9FB8</BoxShadows>
          <BoxShadows x:Key="MetricHoverShadowLime">0 18 38 -10 #38000000, 0 0 30 -8 #407FB800</BoxShadows>

          <LinearGradientBrush x:Key="WindowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#E8F7FC" />
            <GradientStop Offset="0.5" Color="#EEF1F5" />
            <GradientStop Offset="1" Color="#EEF9E6" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <materialIcons:MaterialIconStyles />
    <!-- The DataGrid theme (desktop head) and Styles/PhoneStyles.axaml (phone head) are added by App.xaml.cs
         for the head that needs them, at the place they used to have in this list. -->

    <!-- Smooth Transitions on All Borders -->
    <Style Selector="Border">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.4" Easing="QuarticEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.4" Easing="QuarticEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.4" Easing="QuarticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Base Button Styling -->
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuarticEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Button Variants -->
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource GlassBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource GlassBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <!-- Selected option of a button group, e.g. the active language -->
    <Style Selector="Button.secondary.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.secondary.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionHover}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Background" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.icon.close-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#E03030" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.icon.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Background" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <Style Selector="Button.unstyled-card">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Button.unstyled-card /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Button.unstyled-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Button.unstyled-cover">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.unstyled-cover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.unstyled-cover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.unstyled-cover:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.coral">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource CoralAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.coral /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource CoralAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.coral:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF8585" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.coral:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E05555" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <Style Selector="Button.purple">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PurpleAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.purple /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource PurpleAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.purple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DF7DF0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.purple:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B835CD" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <Style Selector="Button.cyan">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource CyanAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.cyan /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource CyanAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.cyan:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8BE0F5" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.cyan:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4FB0C8" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <Style Selector="Button.lime">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{DynamicResource LimeAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.lime /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource LimeAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    </Style>
    <Style Selector="Button.lime:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C2FF1A" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.lime:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#95CA00" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>

    <!-- Glass Cards -->
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.glass:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="BoxShadow" Value="0 8 32 -6 #40000000" />
    </Style>
    <Style Selector="Border.glass.coral:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CoralAccent}" />
    </Style>
    <Style Selector="Border.glass.purple:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource PurpleAccent}" />
    </Style>
    <Style Selector="Border.glass.cyan:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CyanAccent}" />
    </Style>
    <Style Selector="Border.glass.lime:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource LimeAccent}" />
    </Style>
    <Style Selector="Border.glass.view-accent:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <!-- Metric cards (album / artist / playlist tiles): they pop up when hovered -->
    <Style Selector="Border.metric-card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1) translateY(0px)" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="QuarticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.metric-card:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.035) translateY(-5px)" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MetricHoverShadow}" />
    </Style>
    <Style Selector="Border.metric-card.coral:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CoralAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MetricHoverShadowCoral}" />
    </Style>
    <Style Selector="Border.metric-card.purple:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource PurpleAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MetricHoverShadowPurple}" />
    </Style>
    <Style Selector="Border.metric-card.cyan:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CyanAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MetricHoverShadowCyan}" />
    </Style>
    <Style Selector="Border.metric-card.lime:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource LimeAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MetricHoverShadowLime}" />
    </Style>
    <!-- The hovered tile is drawn above its neighbours, so its scaled-up edge and shadow are never covered -->
    <Style Selector="WrapPanel > ContentPresenter:pointerover">
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <!-- Text Styles -->
    <Style Selector="TextBlock.group-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Black" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <!-- Sidebar: collapses to an icon rail in compact layout -->
    <Style Selector="Border.sidebar">
      <Setter Property="Width" Value="240" />
      <Setter Property="Padding" Value="16,20" />
    </Style>
    <Style Selector="Border.sidebar.compact">
      <Setter Property="Width" Value="68" />
      <Setter Property="Padding" Value="10,20" />
    </Style>

    <!-- Modal dialog card shown over a dimmed overlay -->
    <Style Selector="Border.dialog-card">
      <Setter Property="Background" Value="{DynamicResource ModalBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cover queue hover overlay and rotating chevron -->
    <Style Selector="Border.cover-queue-overlay">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.cover-queue-btn:pointerover Border.cover-queue-overlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.cover-queue-overlay.open">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.cover-queue-btn:pointerover Border.cover-queue-overlay.open">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="materialIcons|MaterialIcon.queue-chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.queue-chevron.open">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <!-- Playback Queue Drawer Item Styles -->
    <Style Selector="Border.queue-item">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.queue-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Border.queue-item.current-track">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.queue-item.current-track:pointerover">
      <Setter Property="Background" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionHover}" />
    </Style>
    <Style Selector="Border.queue-item.drop-target">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource GlassHighlight}" />
    </Style>

    <!-- TextBox & ComboBox -->
    <Style Selector="TextBox, ComboBox">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus, TextBox:focus-within, ComboBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <!-- DataGrid Modern Styles with Rounded Row Hover -->
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
      <Setter Property="RadiusX" Value="4" />
      <Setter Property="RadiusY" Value="4" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource GlassHighlight}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="RadiusX" Value="4" />
      <Setter Property="RadiusY" Value="4" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Opacity" Value="0.25" />
      <Setter Property="RadiusX" Value="4" />
      <Setter Property="RadiusY" Value="4" />
    </Style>

    <!-- Eliminate weird cell selection / focus highlight rectangle -->
    <Style Selector="DataGridCell">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="DataGridCell:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:current">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Animated Status Pulse -->
    <Style Selector="Ellipse.status-pulse">
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.3" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="1.0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.3" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Smooth Audiophile Slider Styling (Bar & Pointer match dynamic theme accent) -->
    <Style Selector="Slider">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider /template/ Grid#SliderContainer">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider:horizontal">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider:horizontal /template/ Grid#HorizontalTemplate">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider /template/ Track#PART_Track">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Slider /template/ Thumb /template/ Border">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 2 10 2 #90000000" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- PointerOver & Pressed States: keep dynamic theme accent, never turn blue -->
    <Style Selector="Slider:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider /template/ Thumb:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider:pointerover /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider /template/ Thumb:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHover}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Slider:pressed /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider:pressed /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider /template/ Thumb:pressed /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider:pressed /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider:pressed /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Slider.seek-slider /template/ Thumb:pressed /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Slider:pressed /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
    </Style>

    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Slider:pointerover /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Slider:pressed /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>

    <Style Selector="Slider.seek-slider">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Slider:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Slider:disabled /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider:disabled /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider:disabled /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="Slider.volume-muted /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pointerover /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pressed /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pointerover /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pressed /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Slider.volume-muted:pressed /template/ Thumb /template/ Border">
      <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Search Box Styling -->
    <Style Selector="TextBox.search-pill">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,0,16,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
    </Style>
    <Style Selector="TextBox.search-pill /template/ Border#PART_BorderElement">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox.search-pill:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="TextBox.search-pill:focus /template/ Border#PART_BorderElement, TextBox.search-pill:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>

    <!-- Audiophile Top Bar Pills -->
    <Style Selector="Button.audiophile-pill">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.audiophile-pill.active-bp">
      <Setter Property="BorderBrush" Value="{DynamicResource PurpleAccent}" />
      <Setter Property="Background" Value="#25D05CE3" />
    </Style>
    <Style Selector="Button.audiophile-pill.active-exc">
      <Setter Property="BorderBrush" Value="{DynamicResource LimeAccent}" />
      <Setter Property="Background" Value="#25AEEA00" />
    </Style>

    <!-- Tag & Quality Badge Styling -->
    <Style Selector="Border.tag-badge">
      <Setter Property="Background" Value="{DynamicResource TagBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Table Link Buttons -->
    <Style Selector="Button.table-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.table-link /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.table-link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.table-link:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Button.table-link:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Table Link: Row-Pressed state (triggered when clicking cover or track# to play) -->
    <Style Selector="Button.table-link.row-pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.table-link.title.row-pressed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Specific Hover and Pressed Color Classes for Table Links -->
    <Style Selector="Button.table-link.title:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Button.table-link.title:pressed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.table-link.cyan:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CyanAccent}" />
    </Style>
    <Style Selector="Button.table-link.artist:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
    </Style>
    <Style Selector="Button.table-link.artist:pressed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.table-link.coral:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
    </Style>
    <Style Selector="Button.table-link.album:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PurpleAccent}" />
    </Style>
    <Style Selector="Button.table-link.album:pressed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PurpleAccent}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.table-link.purple:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PurpleAccent}" />
    </Style>

    <!-- Table Link: Track # (Album view) -->
    <Style Selector="Button.table-link.track-num">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.table-link.track-num:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
    </Style>
    <Style Selector="Button.table-link.track-num.playing TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Table Link: Currently Playing Highlight -->
    <Style Selector="Button.table-link.playing TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.table-link.playing:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionHover}" />
    </Style>
    <Style Selector="Button.table-link.title.playing TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.table-link.title.playing:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionHover}" />
    </Style>
    <Style Selector="Button.table-link.album.playing TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.table-link.album.playing:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionHover}" />
    </Style>

    <!-- Unstyled Cover Button for DataGrid -->
    <Style Selector="Button.unstyled-cover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.unstyled-cover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.unstyled-cover:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.unstyled-cover:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.unstyled-cover > Border">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.unstyled-cover:pointerover > Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
      <Setter Property="BoxShadow" Value="0 4 12 -2 #80000000" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.unstyled-cover:pressed > Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionPressed}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="RenderTransform" Value="scale(0.92)" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.unstyled-cover.playing Border">
    </Style>

    <!-- Motion layer: animations and effects (hover glow, entrances, playback effects). Keep this include last. -->
    <StyleInclude Source="avares://Wiretune.UI/Styles/Motion.axaml" />
  </Application.Styles>
</Application>
