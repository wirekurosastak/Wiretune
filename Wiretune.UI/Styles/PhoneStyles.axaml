<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="using:Wiretune.UI.Controls"
        xmlns:views="using:Wiretune.UI.Views">

  <!-- Styles of the phone layout (AndroidMainView and the controls it is built from). Every class starts with "phone-". -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- Opaque surfaces for what floats above scrolling content: the navigation bar, the mini player and the sheets.
               AMOLED friendly: the navigation bar, the mini player and the sheets are pure black (those pixels are simply off). -->
          <SolidColorBrush x:Key="PhoneNavBackground" Color="#000000" />
          <SolidColorBrush x:Key="PhoneBarBackground" Color="#000000" />
          <SolidColorBrush x:Key="PhoneSheetBackground" Color="#000000" />
          <SolidColorBrush x:Key="PhoneScrim" Color="#B0000000" />
          <BoxShadows x:Key="PhoneFloatShadow">0 10 28 -6 #B0000000</BoxShadows>
          <BoxShadows x:Key="PhoneCoverShadow">0 18 40 -12 #D0000000</BoxShadows>
          <!-- The soft shadow under a cover, as a gradient ring that peaks at the cover's edge and fades outwards. A blurred
               BoxShadow costs an offscreen blur on every frame; this is one cheap fill. It is drawn on a Border that is a
               little bigger than the cover (see the covers in AndroidMainView). -->
          <RadialGradientBrush x:Key="PhoneCoverGlow">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#A0000000" Offset="0.78" />
            <GradientStop Color="#00000000" Offset="1" />
          </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PhoneNavBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PhoneBarBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PhoneSheetBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PhoneScrim" Color="#80000000" />
          <BoxShadows x:Key="PhoneFloatShadow">0 8 24 -6 #40000000</BoxShadows>
          <BoxShadows x:Key="PhoneCoverShadow">0 16 36 -12 #55000000</BoxShadows>
          <RadialGradientBrush x:Key="PhoneCoverGlow">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#40000000" Offset="0.78" />
            <GradientStop Color="#00000000" Offset="1" />
          </RadialGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- A long vertical list: only the rows that are on screen exist (it scrolls with the page around it) -->
  <Style Selector="ItemsControl.phone-list">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!-- Every scrolling area of the phone layout glides on after a flick on the frame clock instead of on Avalonia's
       16 ms timer, which on Android runs at 30-50 steps per second (see SmoothFling). -->
  <Style Selector="views|AndroidMainView ScrollViewer">
    <Setter Property="controls:SmoothFling.IsActive" Value="True" />
    <!-- No scroll bar: on a touch screen it is only a thin indicator that fades in and out while scrolling, and every frame
         of a scroll moved its thumb and ran its fade animation. (Scrolling areas that set their own bar keep it.) -->
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
  </Style>

  <!-- A full-width tap target that draws nothing itself: rows and tiles. Pressing tints it. -->
  <Style Selector="Button.phone-tap">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.phone-tap /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
  </Style>
  <Style Selector="Button.phone-tap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.phone-tap:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-tap:pressed">
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>

  <!-- 44dp icon button (the minimum comfortable touch target), rounded like the desktop buttons -->
  <Style Selector="Button.phone-icon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.phone-icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-icon.accent">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
  </Style>
  <Style Selector="Button.phone-icon.main">
    <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
  </Style>

  <!-- Filled play/pause button -->
  <Style Selector="Button.phone-fab">
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.phone-fab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
    <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
  </Style>
  <Style Selector="Button.phone-fab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
  </Style>
  <Style Selector="Button.phone-fab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryActionPressed}" />
  </Style>

  <!-- Bottom navigation item: an icon and a label below it -->
  <Style Selector="Button.phone-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.phone-nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.phone-nav:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <!-- Icon and label are muted; the active item takes the accent colour of its section (fixed brushes, so the item that fades out never flashes the colour of the section that fades in) -->
  <!-- (Every rule names one control type: a selector list would resolve to their common base, which has no Foreground.) -->
  <Style Selector="Button.phone-nav material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.phone-nav TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.phone-nav.nav-artists.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-artists.active TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-albums.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource PurpleAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-albums.active TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource PurpleAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-songs.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource CyanAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-songs.active TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource CyanAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-favorites.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-favorites.active TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource CoralAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-playlists.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource LimeAccent}" />
  </Style>
  <Style Selector="Button.phone-nav.nav-playlists.active TextBlock.phone-nav-label">
    <Setter Property="Foreground" Value="{DynamicResource LimeAccent}" />
  </Style>

  <!-- Player rows, cards and pills -->
  <Style Selector="Border.phone-row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.phone-row.playing">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
  </Style>
  <Style Selector="TextBlock.phone-row-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.phone-row-title.playing">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
  </Style>
  <Style Selector="TextBlock.phone-row-sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.phone-card">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="TextBlock.phone-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.phone-section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="LetterSpacing" Value="0.8" />
  </Style>

  <!-- The full-screen player and the bottom sheets slide up and fade in -->
  <Style Selector="Border.phone-sheet">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translateY(48px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.phone-sheet.open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <!-- Language / option pills -->
  <Style Selector="Button.phone-pill">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.phone-pill /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.phone-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
  </Style>
  <Style Selector="Button.phone-pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.phone-pill.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}" />
  </Style>
  <Style Selector="Button.phone-pill.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
  </Style>

  <!-- Full-width text fields of the sign-in form and the search bar -->
  <Style Selector="TextBox.phone-field">
    <Setter Property="Height" Value="52" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <!-- The placeholder of the stock template is too faint on the dark surfaces -->
  <Style Selector="TextBox.phone-field /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="TextBox.phone-field /template/ Border#PART_BorderElement">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Thin progress line of the mini player -->
  <Style Selector="ProgressBar.phone-progress">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ProgressBar.phone-progress /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="2" />
  </Style>
</Styles>
