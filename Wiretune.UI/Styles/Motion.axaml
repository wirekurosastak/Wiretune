<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="using:Wiretune.UI.Controls">

  <!--
    Motion layer: every animation and effect that was added on top of the existing look lives in this one file.
    It only adds movement; colours, sizes and layout come from App.axaml and PhoneStyles.axaml, which are
    untouched. It is included LAST in App.axaml (Avalonia has no selector specificity: the style declared last
    wins), so to switch all of it off, remove that one StyleInclude line.

    Conventions used by the views:
      page            a view root (tab, detail view, queue, search results, empty state...): fades and rises in every
                      time it becomes visible
      nav-item/nav-on a sidebar entry and its "selected" state (accent bar + icon pop)
      np-cover        the now-playing cover that "breathes" while a track is playing
      heart-pop       a favourite heart that pops when it becomes a favourite
      app-bg          the phone window background (the section colour washes into the next one)
      dialog-scrim/dialog-card/sheet-dialog/sheet-card  dialogs and bottom sheets
    Avalonia 11.2 cannot animate the RenderTransform property itself with keyframes (only the numeric properties of
    a transform, e.g. TranslateTransform.Y or ScaleTransform.ScaleX, and only on a control whose RenderTransform is
    empty or a matching ScaleTransform/TransformGroup). So: keyframe animations below never set RenderTransform;
    hover and press effects (which are not keyframes) use the transform transitions the app already relies on, and
    the entrance of elements that carry their own transform (Borders, Buttons) is a fade plus a margin slide.
    Infinite animations are gated on the "playing" state (and, on the phone, on the full-screen player being
    open) so that an idle app does not repaint the window needlessly.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <BoxShadows x:Key="GlowCoral">0 0 20 0 #70FF6B6B</BoxShadows>
          <BoxShadows x:Key="GlowPurple">0 0 20 0 #70D05CE3</BoxShadows>
          <BoxShadows x:Key="GlowCyan">0 0 20 0 #7067C8E0</BoxShadows>
          <BoxShadows x:Key="GlowLime">0 0 20 0 #70AEEA00</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <BoxShadows x:Key="GlowCoral">0 0 18 0 #55D94A4A</BoxShadows>
          <BoxShadows x:Key="GlowPurple">0 0 18 0 #55A03BB5</BoxShadows>
          <BoxShadows x:Key="GlowCyan">0 0 18 0 #553A9FB8</BoxShadows>
          <BoxShadows x:Key="GlowLime">0 0 18 0 #557FB800</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===================================================================== -->
  <!-- 1. WINDOW BACKGROUND: the section colour washes smoothly into the next -->
  <!-- ===================================================================== -->
  <Style Selector="Panel.app-bg">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.9" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!-- 2. PAGES: fade and rise every time a page becomes visible              -->
  <!-- ===================================================================== -->
  <Style Selector="Grid.page[IsVisible=True], Panel.page[IsVisible=True], ScrollViewer.page[IsVisible=True], StackPanel.page[IsVisible=True], controls|PhoneEmptyState.page[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.4" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="16" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Album / artist / playlist tiles of the desktop grids pop in one after the other (the first 18; the rest just appear) -->
    <Style Selector="Grid.page[IsVisible=True] WrapPanel > ContentPresenter:nth-child(1)">
      <Style.Animations>
        <Animation Duration="0:0:0.5" Delay="0:0:0.000" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="26" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.92" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
