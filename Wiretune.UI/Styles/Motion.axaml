  <!-- The phone's tile grid has no entrance animation on purpose: it creates its rows while the user scrolls, and a tile
       that fades in as it arrives makes the scrolling stutter. -->

  <!-- ===================================================================== -->
  <!-- 3. HOVER AND PRESS                                                     -->
  <!-- ===================================================================== -->

  <!-- Accent buttons lift with a little overshoot, squash when pressed, and glow in their own colour -->
  <Style Selector="Button.primary, Button.coral, Button.purple, Button.cyan, Button.lime">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover, Button.coral:pointerover, Button.purple:pointerover, Button.cyan:pointerover, Button.lime:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.primary:pressed, Button.coral:pressed, Button.purple:pressed, Button.cyan:pressed, Button.lime:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter, Button.coral /template/ ContentPresenter#PART_ContentPresenter, Button.purple /template/ ContentPresenter#PART_ContentPresenter, Button.cyan /template/ ContentPresenter#PART_ContentPresenter, Button.lime /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" Easing="QuarticEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="QuarticEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource PrimaryActionGlow}" />
  </Style>
  <Style Selector="Button.coral:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowCoral}" />
  </Style>
  <Style Selector="Button.purple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowPurple}" />
  </Style>
  <Style Selector="Button.cyan:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowCyan}" />
  </Style>
  <Style Selector="Button.lime:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowLime}" />
  </Style>

  <!-- Icon buttons grow a little when hovered and spring back -->
  <Style Selector="Button.icon">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.14)" />
  </Style>
  <Style Selector="Button.icon:pressed">
    <Setter Property="RenderTransform" Value="scale(0.88)" />
  </Style>

  <!-- The search field glows in the section accent while it has focus -->
  <Style Selector="TextBox.search-pill /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuarticEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.search-pill:focus /template/ Border#PART_BorderElement, TextBox.search-pill:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource PrimaryActionGlow}" />
  </Style>

  <!-- Album / artist tiles: the cover zooms slowly inside its frame while the tile is hovered -->
  <Style Selector="Border.metric-card Image">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.metric-card:pointerover Image">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>
  <!-- ...and the same for the artist portraits, which use the app's CoverImage control -->
  <Style Selector="Border.metric-card controls|CoverImage">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.metric-card:pointerover controls|CoverImage">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <!-- ===================================================================== -->
  <!-- 4. SIDEBAR: accent bar and icon pop for the selected entry             -->
  <!-- ===================================================================== -->
  <Style Selector="Border.nav-bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="-9,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource PrimaryAction}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1, 0.2)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.4" Easing="QuarticEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="BackEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav-on Border.nav-bar">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1, 1)" />
    <Setter Property="BoxShadow" Value="{DynamicResource PrimaryActionGlow}" />
  </Style>
  <Style Selector="Button.nav-item material|MaterialIcon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav-item:pointerover material|MaterialIcon">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>
  <Style Selector="Button.nav-on material|MaterialIcon">
    <Setter Property="RenderTransform" Value="scale(1.16)" />
  </Style>

  <!-- Phone bottom navigation: the active icon grows with a bounce while it takes the colour of its section -->
  <Style Selector="Button.phone-nav material|MaterialIcon.phone-nav-icon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.phone-nav.active material|MaterialIcon.phone-nav-icon">
    <Setter Property="RenderTransform" Value="scale(1.16)" />
  </Style>

  <!-- Phone: stronger press feedback on the round buttons -->
  <Style Selector="Button.phone-fab:pressed">
    <Setter Property="RenderTransform" Value="scale(0.9)" />
  </Style>
  <Style Selector="Button.phone-icon:pressed">
    <Setter Property="RenderTransform" Value="scale(0.84)" />
  </Style>

  <!-- ===================================================================== -->
  <!-- 5. PLAYBACK: breathing cover, heart pop                              -->
  <!-- ===================================================================== -->

  <!-- The now-playing cover breathes while a track is playing -->
  <!-- (The Border carries its own ScaleTransform in the view: Borders cannot be given one by an animation.) -->
  <Style Selector="Border.np-cover">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="Border.np-cover.playing">
    <Style.Animations>
      <Animation Duration="0:0:3.6" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="ScaleTransform.ScaleX" Value="1.06" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.06" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A heart that has just become a favourite pops -->
  <Style Selector="material|MaterialIcon.heart-pop">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="material|MaterialIcon.heart-pop.fav">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.5" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
        </KeyFrame>
        <KeyFrame Cue="45%">
          <Setter Property="ScaleTransform.ScaleX" Value="1.45" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.45" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===================================================================== -->
  <!-- 6. DIALOGS, SHEETS, MINI PLAYER                                        -->
  <!-- ===================================================================== -->

  <!-- Desktop dialogs: the dimmed overlay fades in, the card (which carries its own transform in the view) scales up and rises -->
  <Style Selector="Panel.dialog-scrim[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.dialog-card[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.92" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
          <Setter Property="TranslateTransform.Y" Value="16" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Sign-in card (desktop): pops in and rises every time the sign-in view opens (the card carries its own transform in the view) -->
  <Style Selector="Grid.login-view[IsVisible=True] Border.login-card">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
          <Setter Property="TranslateTransform.Y" Value="24" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Phone bottom sheets (playlist dialogs): the scrim fades in, the sheet (which carries its own transform in the view) slides up -->
  <Style Selector="Grid.sheet-dialog[IsVisible=True] > Border.sheet-scrim">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Grid.sheet-dialog[IsVisible=True] Border.sheet-card">
    <Style.Animations>
      <Animation Duration="0:0:0.36" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="70" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Phone mini player: slides up when the first track starts -->
  <Style Selector="Panel.mini-player[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.42" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="44" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
