<?xml version="1.0" encoding="utf-8"?>
<!--
  Wiretune connects to a self-hosted server on the local network by IP address
  (e.g. http://192.168.1.27:5200). Android's <domain-config> does NOT match
  numeric IP addresses — only hostnames — so cleartext must be permitted at the
  base-config level. This is intentional: the app is a private LAN player, not
  a public internet service.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
