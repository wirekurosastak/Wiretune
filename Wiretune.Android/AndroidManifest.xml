<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:installLocation="auto">

  <!-- Network access for streaming from a Wiretune server -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Cleartext HTTP is permitted for every destination by network_security_config.xml, because a
       self-hosted server is normally addressed by LAN IP and Android cannot match IP ranges there.
       Passwords and tokens are therefore unprotected on untrusted networks: reach a server outside
       the home network through an HTTPS reverse proxy. -->

  <!-- Foreground service for background playback -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <!-- Keep CPU awake during playback -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Media notification controls (Android 13+) -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application android:label="Wiretune"
               android:icon="@drawable/icon"
               android:networkSecurityConfig="@xml/network_security_config"
               android:allowBackup="false">

    <!-- PlaybackService is declared by its [Service] attribute; a second entry here would name a class that does not exist. -->

  </application>
</manifest>

