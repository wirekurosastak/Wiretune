<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wiretone.UI.ViewModels"
        xmlns:views="using:Wiretone.UI.Views"
        x:Class="Wiretone.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Wiretone - Audiophile Streamer &amp; Player"
        Icon="/Assets/wiretone.ico"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, Transparent"
        FontFamily="Segoe UI Variable, Inter, -apple-system, Arial">

  <views:MainView />

</Window>
