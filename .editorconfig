root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Dart: `dart format` at 120 columns (set in every package's analysis_options.yaml).
[*.dart]
max_line_length = 120

# Kotlin, Gradle, Android XML and the Tizen runner's C# use four spaces.
[*.{kt,kts,gradle,xml,cs,csproj}]
indent_size = 4

# Xcode property lists use tabs.
[*.{plist,entitlements}]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
